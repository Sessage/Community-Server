    private string ListNavClass(Guid listId)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var suffixIndex = relativePath.IndexOfAny(['?', '#']);
        if (suffixIndex >= 0)
            relativePath = relativePath[..suffixIndex];

        var isActive = relativePath.Trim('/').Equals($"list/{listId}", StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "flex p-1 text-gray-700 rounded-lg bg-slate-100 nav-list-item w-full text-left"
            : "flex p-1 text-gray-700 rounded-lg hover:bg-slate-50 nav-list-item w-full text-left";
