    /* -------------------- SORTABLE CALLBACKS -------------------- */

    [JSInvokable]
    public void OnNavDragStarted()
    {
        if (_disposed) return;

        // SortableJS startet den .NET-Aufruf fire-and-forget. Bei sehr kurzen
        // Drags kann dieser deshalb erst nach dem bereits verarbeiteten Ende ankommen.
        if (_lastDragEndUtc != DateTime.MinValue
            && (DateTime.UtcNow - _lastDragEndUtc) < IgnoreLateDragStartWindow)
        {
            return;
        }

        _isDragging = true;
        StartDragWatchdog();
    }

    [JSInvokable]
    public void OnNavDragAborted()
    {
        if (_disposed) return;
        CompleteNavDrag();
    }

    private void CompleteNavDrag()
    {
        _isDragging = false;
        _lastDragEndUtc = DateTime.UtcNow;
        StopDragWatchdog();
    }

    private void StartDragWatchdog()
    {
        _dragWatchdogTimer?.Dispose();
        _dragWatchdogTimer = new System.Threading.Timer(
            _ => OnDragWatchdogFired(),
            null,
            DragWatchdogTimeout,
            System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void StopDragWatchdog()
    {
        _dragWatchdogTimer?.Dispose();
        _dragWatchdogTimer = null;
    }

    private void OnDragWatchdogFired()
    {
        if (!_isDragging || _disposed) return;

        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            CompleteNavDrag();
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnCircuitReconnected()
    {
        if (_disposed) return;
        CompleteNavDrag();
        _navSortableInitialized = false;
        await LoadNavigationAsync();
    }

    /// <summary>
    /// Wird vom JS aufgerufen, wenn Gruppen oder Root-Listen im unified Host
    /// umsortiert werden. orderedDescriptors enthält "group:&lt;guid&gt;" / "list:&lt;guid&gt;".
    /// </summary>
    [JSInvokable]
    public async Task OnNavMixedReordered(string[] orderedDescriptors)
    {
        if (_disposed) return;
        _error = "";
        CompleteNavDrag();
        _pendingSortOps++;
        try
        {
            var descs = orderedDescriptors ?? Array.Empty<string>();

            // Optimistisches UI-Update: globale Position direkt in die Entitäten schreiben
            for (int i = 0; i < descs.Length; i++)
            {
                var colon = descs[i].IndexOf(':');
                if (colon < 0) continue;
                var type = descs[i][..colon];
                if (!Guid.TryParse(descs[i][(colon + 1)..], out var id)) continue;

                if (type == "group")
                {
                    var grp = _groups.FirstOrDefault(x => x.Id == id);
                    if (grp != null) grp.SortOrder = i;
                }
                else if (type == "list")
                {
                    var lst = _lists.FirstOrDefault(x => x.Id == id && x.NavigationGroupId == null);
                    if (lst != null) lst.NavigationSortOrder = i;
                }
            }

            // Persistieren
            await NavService.ReorderMixedNavigationAsync(_userId, descs);
            await LoadNavigationAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_GroupsReorder"], ex.Message);
        }
        finally
        {
            _pendingSortOps--;
        }
    }

    // Kompatibilitäts-Stub – wird vom alten JS nicht mehr aufgerufen,
    // bleibt aber für eventuelle externe Aufrufer erhalten.
    [JSInvokable]
    public async Task OnNavGroupsReordered(string[] orderedGroupIds)
    {
        var descs = (orderedGroupIds ?? Array.Empty<string>())
            .Select(id => $"group:{id}")
            .ToArray();
        await OnNavMixedReordered(descs);
    }


    [JSInvokable]
    public async Task OnNavListsReordered(string groupIdOrEmpty, string[] orderedListIds)
    {
        if (_disposed) return;
        _error = "";
        CompleteNavDrag();
        _pendingSortOps++;
        try
        {
            Guid? groupId = null;
            if (!string.IsNullOrWhiteSpace(groupIdOrEmpty) && Guid.TryParse(groupIdOrEmpty, out var g))
                groupId = g;

            if (!CanManageListPlacement(groupId))
                return;

            var ids = new List<Guid>();
            foreach (var s in orderedListIds ?? Array.Empty<string>())
                if (Guid.TryParse(s, out var l)) ids.Add(l);

            // ✅ 1) Optimistisch im UI setzen
            for (int i = 0; i < ids.Count; i++)
            {
                var l = _lists.FirstOrDefault(x => x.Id == ids[i]);
                if (l != null)
                {
                    l.NavigationGroupId = groupId;
                    l.NavigationSortOrder = i;
                }
            }

            // ✅ 2) Persistieren
            await NavService.ReorderNavigationListsAsync(_userId, groupId, ids);
            await LoadNavigationAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListsReorder"], ex.Message);
        }
        finally
        {
            _pendingSortOps--;
        }
    }


    [JSInvokable]
    public async Task OnNavListMoved(string listId, string fromGroupIdOrEmpty, string toGroupIdOrEmpty, string[] fromIds, string[] toIds)
    {
        if (_disposed) return;
        _error = "";
        CompleteNavDrag();
        _pendingSortOps++;
        try
        {
            if (!Guid.TryParse(listId, out var lid))
                return;

            Guid? fromGroup = null;
            if (!string.IsNullOrWhiteSpace(fromGroupIdOrEmpty) && Guid.TryParse(fromGroupIdOrEmpty, out var fg))
                fromGroup = fg;

            Guid? toGroup = null;
            if (!string.IsNullOrWhiteSpace(toGroupIdOrEmpty) && Guid.TryParse(toGroupIdOrEmpty, out var tg))
                toGroup = tg;

            var movedList = _lists.FirstOrDefault(x => x.Id == lid);
            if (movedList is null || !CanChangeListPlacement(movedList, toGroup))
                return;

            var fromList = new List<Guid>();
            foreach (var s in fromIds ?? Array.Empty<string>())
                if (Guid.TryParse(s, out var id)) fromList.Add(id);

            var toList = new List<Guid>();
            foreach (var s in toIds ?? Array.Empty<string>())
                if (Guid.TryParse(s, out var id)) toList.Add(id);

            // ✅ 1) Optimistisch im UI setzen
            for (int i = 0; i < fromList.Count; i++)
            {
                var l = _lists.FirstOrDefault(x => x.Id == fromList[i]);
                if (l != null)
                {
                    l.NavigationGroupId = fromGroup;
                    l.NavigationSortOrder = i;
                }
            }

            for (int i = 0; i < toList.Count; i++)
            {
                var l = _lists.FirstOrDefault(x => x.Id == toList[i]);
                if (l != null)
                {
                    l.NavigationGroupId = toGroup;
                    l.NavigationSortOrder = i;
                }
            }

            // ✅ 2) Persistieren
            await NavService.MoveListAsync(_userId, lid, fromGroup, toGroup, fromList, toList);
            await LoadNavigationAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListMoveReorder"], ex.Message);
        }
        finally
        {
            _pendingSortOps--;
        }
    }

    /// <summary>
    /// Erweiterte Variante von OnNavListMoved für Moves, die den unified host (Root) betreffen.
    /// Zusätzlich zu MoveListAsync wird die komplette globale Reihenfolge des unified host
    /// persistiert, damit ApplyListOrderAsync (das lokale 0,1,2… setzt) die globalen
    /// Gruppen-Positionen nicht korrumpiert.
    /// </summary>
    [JSInvokable]
    public async Task OnNavListMovedMixed(
        string listId,
        string fromGroupIdOrEmpty,
        string toGroupIdOrEmpty,
        string[] fromIds,
        string[] toIds,
        string[] unifiedDescriptors)
    {
        if (_disposed) return;
        _error = "";
        CompleteNavDrag();
        _pendingSortOps++;
        try
        {
            if (!Guid.TryParse(listId, out var lid))
                return;

            Guid? fromGroup = null;
            if (!string.IsNullOrWhiteSpace(fromGroupIdOrEmpty) && Guid.TryParse(fromGroupIdOrEmpty, out var fg))
                fromGroup = fg;

            Guid? toGroup = null;
            if (!string.IsNullOrWhiteSpace(toGroupIdOrEmpty) && Guid.TryParse(toGroupIdOrEmpty, out var tg))
                toGroup = tg;

            var movedList = _lists.FirstOrDefault(x => x.Id == lid);
            if (movedList is null || !CanChangeListPlacement(movedList, toGroup))
                return;

            var fromList = new List<Guid>();
            foreach (var s in fromIds ?? Array.Empty<string>())
                if (Guid.TryParse(s, out var id)) fromList.Add(id);

            var toList = new List<Guid>();
            foreach (var s in toIds ?? Array.Empty<string>())
                if (Guid.TryParse(s, out var id)) toList.Add(id);

            var descs = unifiedDescriptors ?? Array.Empty<string>();

            // ── 1) Optimistisches UI-Update ──────────────────────────────────────
            // Erst den verschobenen Eintrag in den neuen Container setzen
            movedList.NavigationGroupId = toGroup;

            // Aus-Container normalisieren
            for (int i = 0; i < fromList.Count; i++)
            {
                var l = _lists.FirstOrDefault(x => x.Id == fromList[i]);
                if (l is not null) { l.NavigationGroupId = fromGroup; l.NavigationSortOrder = i; }
            }

            // In-Container normalisieren
            for (int i = 0; i < toList.Count; i++)
            {
                var l = _lists.FirstOrDefault(x => x.Id == toList[i]);
                if (l is not null) { l.NavigationGroupId = toGroup; l.NavigationSortOrder = i; }
            }

            // Globale Positionen aus den Unified-Descriptors direkt in die Entitäten schreiben,
            // damit NavItemsOrdered sofort die richtige Reihenfolge liefert.
            for (int i = 0; i < descs.Length; i++)
            {
                var colon = descs[i].IndexOf(':');
                if (colon < 0) continue;
                var type = descs[i][..colon];
                if (!Guid.TryParse(descs[i][(colon + 1)..], out var id)) continue;

                if (type == "group")
                {
                    var grp = _groups.FirstOrDefault(x => x.Id == id);
                    if (grp is not null) grp.SortOrder = i;
                }
                else if (type == "list")
                {
                    var lst = _lists.FirstOrDefault(x => x.Id == id && x.NavigationGroupId == null);
                    if (lst is not null) lst.NavigationSortOrder = i;
                }
            }

            // ── 2) Persistieren ──────────────────────────────────────────────────
            // MoveListAsync: NavigationGroupId und within-container Sort setzen
            await NavService.MoveListAsync(_userId, lid, fromGroup, toGroup, fromList, toList);

            // ReorderMixedNavigationAsync: globale Positionen reparieren, die
            // ApplyListOrderAsync (in MoveListAsync) mit lokalen 0,1,2… überschrieben hat.
            if (descs.Length > 0)
                await NavService.ReorderMixedNavigationAsync(_userId, descs);

            await LoadNavigationAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListMoveReorder"], ex.Message);
        }
        finally
        {
            _pendingSortOps--;
        }
    }


    /* -------------------- HUB -------------------- */

    private async Task StartHubAsync()
    {
        if (_hubStarted || _disposed) return;

        _hubCts?.Cancel();
        _hubCts?.Dispose();
        _hubCts = new CancellationTokenSource();

        _hubConnection = await HubConnectionFactory.CreateAsync(_hubCts.Token);
        if (_hubConnection is null)
            return;

        _hubConnection.On(TodoHub.ListsUpdated, async () =>
        {
            if (_disposed) return;
            await InvokeAsync(DebouncedReloadAsync);
        });

        _hubConnection.On<Guid>(TodoHub.ListsUpdated, async (_) =>
        {
            if (_disposed) return;
            await InvokeAsync(DebouncedReloadAsync);
        });

        _hubConnection.On(TodoHub.BrowserNotification, async () =>
        {
            if (_disposed) return;
            await InvokeAsync(async () =>
            {
                await RefreshNotificationsAsync();
                StateHasChanged();
            });
        });

        _hubConnection.Reconnected += async _ =>
        {
            if (_disposed) return;

            try
            {
                await _hubConnection.SendAsync(TodoHub.SubscribeToUser, _userId);
                await InvokeAsync(async () =>
                {
                    await RefreshNotificationsAsync();
                    StateHasChanged();
                });
            }
            catch { }
        };

        try
        {
            await _hubConnection.StartAsync(_hubCts.Token);
            await _hubConnection.SendAsync(TodoHub.SubscribeToUser, _userId, _hubCts.Token);
            _hubStarted = true;
        }
        catch (OperationCanceledException)
        {
            // ok
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_HubStart"], ex.Message);
        }
    }

    private CancellationTokenSource? _reloadCts;
    private bool _notificationMutationBusy;
    private long _notificationRefreshVersion;

    private async Task RefreshNotificationsAsync()
    {
        var requestVersion = Interlocked.Increment(ref _notificationRefreshVersion);
        if (_userId == "gast")
        {
            if (!_disposed && requestVersion == _notificationRefreshVersion)
            {
                _unreadNotifications = 0;
                _latestNotifications.Clear();
            }
            return;
        }

        try
        {
            var unread = await NotificationService.GetUnreadCountAsync(_userId);
            var latest = (await NotificationService.GetLatestAsync(_userId)).ToList();
            if (_disposed || requestVersion != _notificationRefreshVersion)
                return;

            _unreadNotifications = unread;
            _latestNotifications = latest;
        }
        catch (Exception ex)
        {
            if (!_disposed && requestVersion == _notificationRefreshVersion)
                _error = $"Benachrichtigungen konnten nicht geladen werden: {ex.Message}";
        }
    }

    private async Task ToggleNotificationsPanelAsync()
    {
        if (_userId == "gast") return;

        await RefreshNotificationsAsync();
    }

    private async Task CloseNotificationsPanel()
    {
        if (_notificationsDropdown is not null)
            await _notificationsDropdown.CloseAsync();
    }

    private async Task MarkNotificationsReadAsync()
    {
        if (_notificationMutationBusy) return;
        _notificationMutationBusy = true;
        try
        {
            await NotificationService.MarkAllReadAsync(_userId);
            _unreadNotifications = 0;
            _latestNotifications = (await NotificationService.GetLatestAsync(_userId)).ToList();
        }
        catch (Exception ex) { _error = $"Benachrichtigungen konnten nicht aktualisiert werden: {ex.Message}"; }
        finally { _notificationMutationBusy = false; }
        if (!_disposed)
            StateHasChanged();
    }

    private async Task DeleteNotificationAsync(Guid notificationId)
    {
        if (_notificationMutationBusy) return;
        _notificationMutationBusy = true;
        try
        {
            await NotificationService.DeleteNotificationAsync(_userId, notificationId);
            _latestNotifications.RemoveAll(n => n.Id == notificationId);
            _unreadNotifications = await NotificationService.GetUnreadCountAsync(_userId);
            await RefreshNotificationsDropdownAsync();
        }
        catch (Exception ex) { _error = $"Benachrichtigung konnte nicht gelöscht werden: {ex.Message}"; }
        finally { _notificationMutationBusy = false; }
    }

    private async Task DeleteAllNotificationsAsync()
    {
        if (_notificationMutationBusy) return;
        _notificationMutationBusy = true;
        try
        {
            await NotificationService.DeleteAllNotificationsAsync(_userId);
            _latestNotifications.Clear();
            _unreadNotifications = 0;
            await RefreshNotificationsDropdownAsync();
        }
        catch (Exception ex) { _error = $"Benachrichtigungen konnten nicht gelöscht werden: {ex.Message}"; }
        finally { _notificationMutationBusy = false; }
    }

    private async Task RefreshNotificationsDropdownAsync()
    {
        StateHasChanged();

        if (_notificationsDropdown is null)
            return;

        await _notificationsDropdown.CloseAsync();
        await InvokeAsync(StateHasChanged);
        await _notificationsDropdown.OpenAsync();
    }

    private async Task OpenNotificationAsync(UserNotificationEntity notification)
    {
        await CloseNotificationsPanel();
        if (notification.ReadAtUtc is null)
        {
            try { await NotificationService.MarkReadAsync(_userId, notification.Id); }
            catch (Exception ex) { _error = $"Benachrichtigung konnte nicht als gelesen markiert werden: {ex.Message}"; }
        }
        if (notification.TaskId.HasValue)
            Navigation.NavigateTo($"/list/{notification.ListId}?taskId={notification.TaskId.Value}");
        else
            Navigation.NavigateTo($"/list/{notification.ListId}");
        await Task.CompletedTask;
    }

    private async Task DebouncedReloadAsync()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = new CancellationTokenSource();

        var token = _reloadCts.Token;

        try
        {
            await Task.Delay(150, token);
            if (token.IsCancellationRequested) return;
            if (_disposed) return;
            // Skip reload while sort operations are in-flight or a drag is active to avoid
            // overwriting optimistic state or re-rendering the DOM under an active drag.
            if (_pendingSortOps > 0 || _isDragging) return;

            await LoadNavigationAsync();
        }
        catch (TaskCanceledException)
        {
            // ok
        }
    }


    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopDragWatchdog();
        _searchRequestVersion++;
        try { _searchDebounce?.Cancel(); } catch { }
        _searchDebounce?.Dispose();
        _searchDebounce = null;
        Navigation.LocationChanged -= OnLocationChanged;
        NavigationRefresh.RefreshRequested -= OnNavigationRefreshRequestedAsync;

        try { await JS.InvokeVoidAsync("todoUi.disposeNavSortable"); } catch { }
        if (_manageGroupListsHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "nav-manage-group-lists-dlg"); } catch { }
        if (_renameGroupHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "nav-rename-group-dlg"); } catch { }
        if (_ungroupGroupHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "nav-ungroup-group-dlg"); } catch { }
        _dotNetRef?.Dispose();

        try { _hubCts?.Cancel(); } catch { }
        _hubCts?.Dispose();
        _hubCts = null;

        try { _reloadCts?.Cancel(); } catch { }
        _reloadCts?.Dispose();
        _reloadCts = null;

        if (_hubConnection is not null)
        {
            try { await _hubConnection.StopAsync(); } catch { }
            await _hubConnection.DisposeAsync();
            _hubConnection = null;
        }
    }
}
