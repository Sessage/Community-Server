        if (ProductFeatures.IsEnabled(ProductFeatureIds.Dashboards))
            _quickLinks.Add((L["QuickLink_Dashboards"], "/dashboards", new Icons.Regular.Size20.DocumentBulletList()));

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
