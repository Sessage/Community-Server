                ?? _userId;

            _ = LoadNavigationAsync();

            // Profilbild-URL laden
            await using var db = await DbFactory.CreateDbContextAsync();
            var hasPicture = await db.Users
                .Where(u => u.Id == _userId)
                .Select(u => u.ProfilePicturePath != null)
                .FirstOrDefaultAsync();
            _profilePictureUrl = hasPicture ? $"/api/profile-picture/{_userId}" : null;
            await RefreshNotificationsAsync();
        }
        else
        {
            _userId = "gast";
            _userName = "Gast";
