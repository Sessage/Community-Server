    }

    private Task OnNavigationRefreshRequestedAsync()
        => InvokeAsync(LoadNavigationAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_userId != "gast")
                await StartHubAsync();
        }

        if (_focusGroupInput)
        {
            _focusGroupInput = false;
            try { await _groupInputRef.FocusAsync(); } catch { }
        }

        if (_focusListInput)
        {
            _focusListInput = false;
            try { await _listInputRef.FocusAsync(); } catch { }
        }

        if (!_navSortableInitialized)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("todoUi.disposeNavSortable");
            }
            catch { }

            try
            {
                await JS.InvokeVoidAsync("todoUi.initNavSortable", _dotNetRef);
                await JS.InvokeVoidAsync("todoUi.markAssetReady", "navigation");
                _navSortableInitialized = true;
            }
            catch (Exception ex)
            {
                if (ex.Message.Contains("not a function", StringComparison.OrdinalIgnoreCase))
                {
                    try
                    {
                        if (await JS.InvokeAsync<bool>("todoUi.reloadOnceForAssetMismatch", "navigation"))
                            return;
                    }
                    catch
                    {
                        // Der normale, sichtbare Fehlerpfad unten bleibt als Fallback erhalten.
                    }
                }
                _error = string.Format(L["Err_NavSortableInit"], ex.Message);
            }
        }

        _manageGroupListsHookActive = await UpdateDialogHookAsync(_manageGroupListsOpen, "nav-manage-group-lists-dlg", _manageGroupListsHookActive);
        _renameGroupHookActive = await UpdateDialogHookAsync(_renameGroupOpen, "nav-rename-group-dlg", _renameGroupHookActive);
        _ungroupGroupHookActive = await UpdateDialogHookAsync(_ungroupGroupOpen, "nav-ungroup-group-dlg", _ungroupGroupHookActive);
    }

    private async Task<bool> UpdateDialogHookAsync(bool isOpen, string dialogId, bool hookActive)
    {
        if (isOpen && !hookActive)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("todoUi.enableDialogOutsideCloseById", dialogId, _dotNetRef, Array.Empty<string>());
                return true;
            }
            catch { }
        }
        else if (!isOpen && hookActive)
        {
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", dialogId); } catch { }
            return false;
        }

        return hookActive;
    }

    [JSInvokable]
    public async Task CloseFromOutsideClick()
    {
        _manageGroupListsOpen = false;
        _renameGroupOpen = false;
        _ungroupGroupOpen = false;
        await SafeStateHasChangedAsync();
    }

    private void RequestNavResync()
    {
        _navSortableInitialized = false;
        _navRenderVersion++;
    }

    private async Task LoadNavigationAsync()
    {
        if (_disposed) return;

        var showInitialLoading = _lists.Count == 0 && _groups.Count == 0;
        if (showInitialLoading)
        {
            _navigationLoading = true;
            await SafeStateHasChangedAsync();
        }

        try
        {
            var listsTask = ListService.GetNavigationListsAsync(_userId);
            var groupsTask = NavService.GetListGroupsAsync(_userId);

            await Task.WhenAll(listsTask, groupsTask);

            _lists = listsTask.Result.ToList();
            _groups = groupsTask.Result.ToList();
            _collapsedGroups.Clear();
            foreach (var group in _groups.Where(g => g.IsCollapsed))
                _collapsedGroups.Add(group.Id);
        }
        catch
        {
            try
            {
                _lists = (await ListService.GetNavigationListsAsync(_userId)).ToList();
            }
            catch
            {
                _lists = new();
            }

            try
            {
                _groups = (await NavService.GetListGroupsAsync(_userId)).ToList();
            }
            catch
            {
                _groups = new();
            }
        }
        finally
        {
            _navigationLoading = false;
        }

        // UI: wenn Gruppe nicht mehr existiert, Listen zurücksetzen
        var groupIds = _groups.Select(g => g.Id).ToHashSet();
        foreach (var l in _lists)
        {
            if (l.NavigationGroupId is not null && !groupIds.Contains(l.NavigationGroupId.Value))
                l.NavigationGroupId = null;
        }

        // Sicherstellen, dass Gruppen und Root-Listen im selben globalen Zahlenraum liegen.
        // Ohne das würden frische Installationen (SortOrder 0,1,2 in beiden Namensräumen)
        // falsch gemischt dargestellt.
        NormalizeNavSortOrders();

        RequestNavResync();
        await SafeStateHasChangedAsync();
    }

    /// <summary>
    /// Stellt sicher, dass Gruppen-SortOrder und Root-Listen-NavigationSortOrder
    /// im selben globalen Zahlenraum liegen. Rein in-memory – kein DB-Zugriff.
    /// Wird bei jedem Laden aufgerufen, sodass kollidierende Positionen (z.B. nach
    /// frischer Installation) zuverlässig aufgelöst werden.
    /// Bereits korrekt global positionierte Werte bleiben stabil, weil nur die
    /// Reihenfolge erhalten wird, nicht die Zahlenwerte an sich.
    /// </summary>
    private void NormalizeNavSortOrders()
    {
        var rootLists = _lists.Where(l => l.NavigationGroupId is null).ToList();
        if (rootLists.Count == 0 && _groups.Count == 0) return;

        // Kombinierte Sortierung: erst nach Position, bei Gleichstand Listen vor Gruppen,
        // dann alphabetisch. Das entspricht dem alten Verhalten (Listen-Sektion zuerst).
        var combined = rootLists
            .Select(l => (IsGroup: false, Pos: l.NavigationSortOrder, Name: l.Name, ListRef: (TodoListEntity?)l, GroupRef: (TodoListGroupEntity?)null))
            .Concat(_groups.Select(g => (IsGroup: true, Pos: g.SortOrder, Name: g.Name, ListRef: (TodoListEntity?)null, GroupRef: (TodoListGroupEntity?)g)))
            .OrderBy(x => x.Pos)
            .ThenBy(x => x.IsGroup ? 1 : 0)   // Gleichstand: Listen vor Gruppen
            .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        for (int i = 0; i < combined.Count; i++)
        {
            var item = combined[i];
            if (!item.IsGroup && item.ListRef is not null)
                item.ListRef.NavigationSortOrder = i;
            else if (item.IsGroup && item.GroupRef is not null)
                item.GroupRef.SortOrder = i;
        }
    }

    private async Task SafeStateHasChangedAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Komponente wurde während eines async-Callbacks bereits freigegeben.
        }
        catch (InvalidOperationException)
        {
            // Renderer/Circuit ist nicht mehr verfügbar.
        }
    }


    // Repräsentiert einen einzelnen Eintrag in der gemischten Navigationsliste
    private record NavEntry(bool IsGroup, Guid Id, int SortOrder, string Name);

    /// <summary>
    /// Gibt Gruppen und Root-Listen in einer gemeinsamen Reihenfolge zurück,
    /// sortiert nach dem globalen SortOrder-Wert (derselbe numerische Raum für beide Typen).
    /// </summary>
    private IEnumerable<NavEntry> NavItemsOrdered =>
        _lists
            .Where(l => l.NavigationGroupId is null)
            .Select(l => new NavEntry(false, l.Id, l.NavigationSortOrder, l.Name))
            .Concat(_groups.Select(g => new NavEntry(true, g.Id, g.SortOrder, g.Name)))
            .OrderBy(e => e.SortOrder)
            .ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase);

