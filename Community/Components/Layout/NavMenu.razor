        if (_disposed) return;
        _searchOpen = false;
        await SafeStateHasChangedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(async () =>
        {
            await RefreshNavigationForCurrentRouteAsync(e.Location);
            await SafeStateHasChangedAsync();
        });

    private async Task RefreshNavigationForCurrentRouteAsync(string location)
    {
        if (_disposed) return;

        var segments = Navigation.ToAbsoluteUri(location).AbsolutePath
            .Trim('/')
            .Split('/', StringSplitOptions.RemoveEmptyEntries);
        var unknownList = segments.Length == 2
            && segments[0].Equals("list", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[1], out var listId)
            && _lists.All(l => l.Id != listId);
        var unknownPortfolio = segments.Length == 2
            && segments[0].Equals("portfolio", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[1], out var portfolioId)
            && _groups.All(g => g.Id != portfolioId);

        if (unknownList || unknownPortfolio)
            await LoadNavigationAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        NavigationRefresh.RefreshRequested += OnNavigationRefreshRequestedAsync;
        _quickLinks =
        [
            (L["QuickLink_Tasks"], "/", new Icons.Filled.Size20.TaskListSquareSparkle())
