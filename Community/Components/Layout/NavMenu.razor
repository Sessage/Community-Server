    private async Task ToggleListInManageGroup(Guid listId, bool putIntoGroup)
    {
        _error = "";

        try
        {
            var list = _lists.FirstOrDefault(x => x.Id == listId);
            if (list is null) return;

            var fromGroup = list.NavigationGroupId;
            var toGroup = putIntoGroup ? _manageGroupId : (Guid?)null;

            if (!CanChangeListPlacement(list, toGroup))
                return;

            // Nichts zu tun
            if (fromGroup == toGroup)
                return;

            // Quell-Reihenfolge (nach dem Entfernen)
            var fromIds = _lists
                .Where(x => x.NavigationGroupId == fromGroup && x.Id != listId)
                .OrderBy(x => x.NavigationSortOrder)
                .Select(x => x.Id)
                .ToList();

            // Ziel-Reihenfolge (nach dem Hinzufügen -> ans Ende)
            var toIds = _lists
                .Where(x => x.NavigationGroupId == toGroup)
                .OrderBy(x => x.NavigationSortOrder)
                .Select(x => x.Id)
                .ToList();

            toIds.Add(listId);

            await NavService.MoveListAsync(_userId, listId, fromGroup, toGroup, fromIds, toIds);

            await LoadNavigationAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListMove"], ex.Message);
        }
    }


