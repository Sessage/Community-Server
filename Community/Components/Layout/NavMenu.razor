    private async Task LoadTemplatesAsync()
    {
        var requestVersion = ++_templateLoadVersion;
        _templatesLoading = true;
        _templatesError = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var templates = (await ListService.GetTemplatesAsync(_userId)).ToList();
            if (requestVersion == _templateLoadVersion && _showCreateList && !_disposed)
                _availableTemplates = templates;
        }
        catch (Exception ex)
        {
            if (requestVersion == _templateLoadVersion && _showCreateList && !_disposed)
            {
                _availableTemplates = new List<TodoListEntity>();
                _templatesError = string.Format(L["Err_TemplatesLoad"], ex.Message);
            }
        }
        finally
        {
            if (requestVersion == _templateLoadVersion) _templatesLoading = false;
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

