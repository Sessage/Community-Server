    private void OnSearchFocus()
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
            _searchOpen = true;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        var requestVersion = ++_searchRequestVersion;
        _searchFailed = false;

        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchOpen = false;
            _searchLoading = false;
            _searchResults.Clear();
            _searchListResults.Clear();
            _searchTaskResults.Clear();
            return;
        }

        _searchOpen = true;

        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;
        var query = _searchQuery;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RunNavSearchAsync(query, requestVersion, token);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchQuery = SearchUtilities.NormalizeQuery(_searchQuery);
            _searchOpen = false;
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(_searchQuery)}");
        }
        else if (e.Key == "Escape")
        {
            _searchOpen = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        _searchRequestVersion++;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;
        _searchQuery = "";
        _searchOpen = false;
        _searchLoading = false;
        _searchFailed = false;
        _searchResults.Clear();
        _searchListResults.Clear();
        _searchTaskResults.Clear();
        await Task.CompletedTask;
    }

    private async Task RunNavSearchAsync(string query, long requestVersion, CancellationToken cancellationToken)
    {
        _searchLoading = true;
        await SafeStateHasChangedAsync();

        try
        {
            var all = await SearchService.SearchAsync(_userId, query, cancellationToken);
            if (_disposed || requestVersion != _searchRequestVersion)
                return;

            _searchResults = all.ToList();
            _searchListResults = _searchResults.Where(r => r.Kind == SearchResultKind.List).ToList();
            _searchTaskResults = _searchResults.Where(r => r.Kind == SearchResultKind.Task).ToList();
            _searchFailed = false;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch
        {
            if (_disposed || requestVersion != _searchRequestVersion)
                return;

            _searchResults.Clear();
            _searchListResults.Clear();
            _searchTaskResults.Clear();
            _searchFailed = true;
        }
        finally
        {
            if (!_disposed && requestVersion == _searchRequestVersion)
            {
                _searchLoading = false;
                await SafeStateHasChangedAsync();
            }
        }
    }

    private void NavigateToSearchResult(SearchResultItem item)
    {
        _searchOpen = false;
        if (item.TaskId.HasValue)
            Navigation.NavigateTo($"/list/{item.ListId}?taskId={item.TaskId}");
        else
            Navigation.NavigateTo($"/list/{item.ListId}");
