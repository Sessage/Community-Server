    private async Task CreateListAsync()
    {
        if (_createListBusy) return;
        _error = "";

        var listName = (_newList.Name ?? "").Trim();
        if (string.IsNullOrWhiteSpace(listName))
        {
            _error = L["Err_ListCreateEmpty"];
            return;
        }

        _createListBusy = true;
        try
        {
            TodoListEntity created;

            if (_selectedTemplateId.HasValue)
            {
                created = await ListService.CreateListFromTemplateAsync(_userId, _selectedTemplateId.Value, listName);
            }
            else
            {
                var listToCreate = new TodoListEntity
                {
                    Id = Guid.NewGuid(),
                    Name = listName
                };
                created = await ListService.AddListAsync(_userId, listToCreate);
            }

            _newList = new TodoListEntity { Name = "" };
            _selectedTemplateId = null;
            _showCreateList = false;

            await LoadNavigationAsync();

            Navigation.NavigateTo($"/list/{created.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListCreate"], ex.Message);
        }
        finally { _createListBusy = false; }
    }

    private bool CanManageListPlacement(Guid? groupId)
        => groupId is null || _groups.Any(g => g.Id == groupId.Value && g.CanManage);

    private bool CanAdminList(TodoListEntity list)
        => string.Equals(list.OwnerId, _userId, StringComparison.OrdinalIgnoreCase)
           || list.Participants.Any(p => !p.InvitationPending
               && p.Role == ListRole.Admin
               && (string.Equals(p.UserId, _userId, StringComparison.OrdinalIgnoreCase)
                   || string.Equals(p.Email, _userId, StringComparison.OrdinalIgnoreCase)));

    private bool CanChangeListPlacement(TodoListEntity list, Guid? targetGroupId)
    {
        if (!CanManageListPlacement(list.NavigationGroupId) || !CanManageListPlacement(targetGroupId))
            return false;

        var targetGroup = targetGroupId.HasValue
            ? _groups.FirstOrDefault(g => g.Id == targetGroupId.Value)
            : null;
        return targetGroup?.IsPortfolio != true || CanAdminList(list);
    }

