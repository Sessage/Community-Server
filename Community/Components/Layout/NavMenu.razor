@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@implements IAsyncDisposable
@* Application navigation projection. It combines persisted groups/portfolios with current list access
   and refreshes on SignalR or NavigationRefreshNotifier events. *@
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ITodoListService ListService
@inject INotificationService NotificationService
@inject IJSRuntime JS
@inject ITodoHubConnectionFactory HubConnectionFactory
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Klassenbibliothek.Data
@using Klassenbibliothek.Components.Views
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ITodoNavigationService NavService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISearchService SearchService
@inject NavigationRefreshNotifier NavigationRefresh
@inject IProductFeatureCatalog ProductFeatures
@using Klassenbibliothek.Features

<div class="flex flex-col gap-3 h-full min-h-0 text-slate-900">
    <div class="flex items-center px-3 pt-4">
        <div class="flex items-center gap-2">
            <a href="/"
               class="font-semibold cursor-pointer"
               title="Zur Hauptseite">
                <img src="_content/TodoSuite.Community.Shared/img/logo.png" alt="Sessage" />
            </a>
        </div>
    </div>

    <!-- Search box -->
    <div class="px-3 relative" @onclick:stopPropagation="true" @onfocusout="OnSearchFocusOut">
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-3 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-blue-400 focus-within:border-blue-400 transition-all">
            <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Neutral" />
            <input class="p-2 flex-1 outline-none text-sm bg-transparent min-w-0"
                   type="text"
                   maxlength="@SearchUtilities.MaxQueryLength"
                   aria-label="@L["Search_Placeholder"]"
                   placeholder="@L["Search_Placeholder"]"
                   value="@_searchQuery"
                   @oninput="OnSearchInput"
                   @onfocus="OnSearchFocus"
                   @onkeydown="OnSearchKeyDown" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" class="text-slate-400 hover:text-slate-600 shrink-0" title="@L["Search_Clear"]" aria-label="@L["Search_Clear"]" @onclick="ClearSearchAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
                </button>
            }
        </div>

        @if (_searchOpen && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            <div class="absolute left-3 right-3 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-50 overflow-hidden max-h-[60vh] overflow-y-auto">
                @if (_searchLoading)
                {
                    <div class="px-3 py-2 text-sm text-slate-500">@L["Lbl_Loading"]</div>
                }
                else if (_searchFailed)
                {
                    <div class="px-3 py-2 text-sm text-red-700" role="alert">@L["Search_Error"]</div>
                }
                else if (_searchResults.Count == 0)
                {
                    <div class="px-3 py-2 text-sm text-slate-500">@string.Format(L["Search_NoResults"], _searchQuery)</div>
                }
                else
                {
                    @if (_searchListResults.Count > 0)
                    {
                        <div class="px-3 pt-2 pb-1 text-[10px] uppercase tracking-wide text-slate-400 font-semibold">@L["Search_GroupLists"]</div>
                        @foreach (var item in _searchListResults.Take(5))
                        {
                            <button type="button"
                                    class="w-full text-left px-3 py-2 hover:bg-slate-50 flex items-center gap-2 min-w-0"
                                    @onmousedown:preventDefault
                                    @onclick="() => NavigateToSearchResult(item)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.DocumentBulletList())" Color="Color.Accent" />
                                <span class="truncate text-sm">@item.Title</span>
                            </button>
                        }
                    }

                    @if (_searchTaskResults.Count > 0)
                    {
                        <div class="px-3 pt-2 pb-1 text-[10px] uppercase tracking-wide text-slate-400 font-semibold @(_searchListResults.Count > 0 ? "border-t border-slate-100" : "")">@L["Search_GroupTasks"]</div>
                        @foreach (var item in _searchTaskResults.Take(5))
                        {
                            <button type="button"
                                    class="w-full text-left px-3 py-2 hover:bg-slate-50 flex flex-col min-w-0"
                                    @onmousedown:preventDefault
                                    @onclick="() => NavigateToSearchResult(item)">
                                <div class="flex items-center gap-2 min-w-0">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())" Color="Color.Neutral" />
                                    <span class="truncate text-sm">@item.Title</span>
                                    @if (item.MatchField == "description")
                                    {
                                        <span class="shrink-0 px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded-full text-[10px]">@L["Search_MatchDescription"]</span>
                                    }
                                    else if (item.MatchField == "step")
                                    {
                                        <span class="shrink-0 px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded-full text-[10px]">@L["Search_MatchStep"]</span>
                                    }
                                </div>
                                <div class="text-[11px] text-slate-400 pl-6 truncate">@item.ListName</div>
                            </button>
                        }
                    }

                    @if (_searchResults.Count > 0)
                    {
                        <div class="border-t border-slate-100">
                            <button type="button"
                                    class="w-full text-left px-3 py-2 text-sm text-blue-600 hover:bg-blue-50 flex items-center gap-2"
                                    @onmousedown:preventDefault
                                    @onclick="ShowAllSearchResults">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowRight())" Color="Color.Accent" />
                                @L["Search_ShowAll"]
                            </button>
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="px-3  min-h-0 ">
        <div class="text-xs uppercase tracking-wide text-slate-500 mb-2">@L["Nav_Navigation"]</div>
        <div class="flex flex-col gap-1">
            @foreach (var quickLink in _quickLinks)
            {
                <NavLink class="flex p-1 nav-pill nav-link" href="@quickLink.Href" Match="@GetQuickLinkMatch(quickLink.Href)">
                    <FluentIcon Value="@quickLink.Icon" Color="Color.Accent" />
                    <span class="ml-1">@quickLink.Label</span>
                </NavLink>
            }
        </div>
    </div>

    <div class="px-3 flex-1 overflow-y-auto">
        <div class="flex items-center justify-between mb-2">
            <div class="text-xs uppercase tracking-wide text-slate-500">@L["Nav_Lists"]</div>

            <div class="flex items-center gap-1">
                <FluentButton Appearance="Appearance.Stealth" OnClick="ToggleCreateGroup" Title="@L["Nav_NewGroup"]" aria-label="@L["Nav_NewGroup"]"><FluentIcon Value="@(new Icons.Regular.Size16.FolderAdd())" Color="Color.Accent" /></FluentButton>
                <FluentButton Appearance="Appearance.Stealth" OnClick="ToggleCreateList" Title="@L["Nav_NewList"]">
                    <div class="flex">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Class="mr-1" Color="Color.Accent" />
                        @L["Nav_NewList"]
                    </div>
                </FluentButton>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-3 text-sm text-red-800 mb-2">
                <div class="font-semibold">@L["Lbl_Error"]</div>
                <div>@_error</div>
            </div>
        }

        @if (_showCreateGroup)
        {
            <div class="bg-white rounded-lg border border-slate-200 p-2 shadow-sm mb-2">
                <div class="text-xs uppercase tracking-wide text-slate-500 mb-2">@L["Nav_NewGroup"]</div>
                <div>
                    <input class="p-1 flex-1 outline-none w-full align-middle" @ref="_groupInputRef" @bind-Value="_newGroupName" @bind-Value:event="oninput" @onkeydown="HandleCreateGroupKeyDown" maxlength="200" disabled="@_createGroupBusy" aria-label="@L["Lbl_GroupName"]" Placeholder="@L["Lbl_GroupName"]" />
                    @if (ProductFeatures.IsEnabled(ProductFeatureIds.Portfolios))
                    {
                        <label class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                            <input type="checkbox" @bind="_newGroupIsPortfolio" disabled="@_createGroupBusy" />
                            <span>@L["Nav_CreateAsPortfolio"]</span>
                        </label>
                    }
                    <div class="mt-2 flex items-center justify-end gap-2">
                        <FluentButton Appearance="Appearance.Stealth" OnClick="CancelCreateGroup" Disabled="@_createGroupBusy">@L["Btn_Cancel"]</FluentButton>
                        <FluentButton Appearance="Appearance.Accent" OnClick="CreateGroupAsync" Disabled="@(_createGroupBusy || string.IsNullOrWhiteSpace(_newGroupName))">@L["Btn_Create"]</FluentButton>
                    </div>
                </div>
            </div>
        }

        @if (_showCreateList)
        {
            <div class="bg-white rounded-lg border border-slate-200 p-2 shadow-sm mb-2">
                <div>
                    <input class="p-1 flex-1 outline-none w-full align-middle" @ref="_listInputRef" @bind-Value="_newList.Name" @bind-Value:event="oninput" @onkeydown="HandleCreateListKeyDown" maxlength="200" disabled="@_createListBusy" aria-label="@L["Lbl_ListName"]" Placeholder="@L["Lbl_ListName"]" />

                    @if (_templatesLoading)
                    {
                        <div class="mt-2 text-xs text-slate-400">@L["Lbl_Loading"]</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_templatesError))
                    {
                        <div class="mt-2 rounded border border-amber-200 bg-amber-50 p-2 text-xs text-amber-800">
                            <span>@_templatesError</span>
                            <button type="button" class="ml-1 underline" @onclick="LoadTemplatesAsync">@L["Btn_Retry"]</button>
                        </div>
                    }
                    else if (_availableTemplates.Count > 0)
                    {
                        <div class="mt-2">
                            <div class="text-xs text-slate-500 mb-1">@L["Nav_Template_Label"]</div>
                            <div class="flex flex-col gap-1">
                                <button type="button"
                                        class="text-left px-2 py-1 rounded text-sm @(_selectedTemplateId == null ? "bg-blue-100 text-blue-800 font-medium" : "hover:bg-slate-50 text-slate-700")"
                                        @onclick="() => _selectedTemplateId = null">
                                    @L["Nav_Template_Blank"]
                                </button>
                                @foreach (var tpl in _availableTemplates)
                                {
                                    <button type="button"
                                            class="text-left px-2 py-1 rounded text-sm @(_selectedTemplateId == tpl.Id ? "bg-blue-100 text-blue-800 font-medium" : "hover:bg-slate-50 text-slate-700")"
                                            @onclick="() => _selectedTemplateId = tpl.Id">
                                        @tpl.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-2 flex items-center justify-end gap-2">
                        <FluentButton Appearance="Appearance.Stealth" OnClick="CancelCreateList" Disabled="@_createListBusy">@L["Btn_Cancel"]</FluentButton>
                        <FluentButton Appearance="Appearance.Accent" OnClick="CreateListAsync" Disabled="@(_createListBusy || string.IsNullOrWhiteSpace(_newList.Name))">@L["Btn_Create"]</FluentButton>
                    </div>
                </div>
            </div>
        }

        @if (_navigationLoading && _lists.Count == 0 && _groups.Count == 0)
        {
            <div class="flex items-center gap-2 rounded-lg px-2 py-2 text-sm text-slate-500">
                <FluentProgressRing Style="width:16px;height:16px;" />
                <span>@L["Lbl_Loading"]</span>
            </div>
        }

        <!-- UNIFIED NAVIGATION: Gruppen und Root-Listen gemischt -->
        <div @key="_navRenderVersion" id="nav-unified-host" class="@NavHostClass">
            @foreach (var entry in NavItemsOrdered)
            {
                @if (entry.IsGroup)
                {
                    var g = _groups.FirstOrDefault(x => x.Id == entry.Id);
                    @if (g is not null)
                    {
                        var collapsed = _collapsedGroups.Contains(g.Id);

                        <!-- Gruppe: kein Rahmen, Chevron ganz rechts -->
                        <div @key="g.Id" class="nav-mixed-item nav-group-card" data-groupid="@g.Id">
                            <div class="flex items-center gap-1 px-1 py-0.5 rounded-lg hover:bg-slate-50 group/grp">
                                <span class="nav-drag-handle inline-flex items-center justify-center w-5 cursor-grab select-none text-slate-300 hover:text-slate-500"
                                      title="@L["Nav_DragGroup"]">⋮⋮</span>

                                <span aria-hidden="true" class="pt-0.5 shrink-0 text-blue-500">
                                    @if (g.IsPortfolio && ProductFeatures.IsEnabled(ProductFeatureIds.Portfolios))
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.ArrowTrendingLines())" />
                                    }
                                    else
                                    {

                                        <FluentIcon Value="@(collapsed ? (Icon)new Icons.Regular.Size24.Folder() : new Icons.Regular.Size24.FolderOpen())" />
                                    }
                                </span>

                                @if (g.IsPortfolio && ProductFeatures.IsEnabled(ProductFeatureIds.Portfolios))
                                {
                                    <button type="button" class="font-semibold truncate flex-1 text-left text-sm text-slate-700"
                                            title="Portfolio-Dashboard öffnen"
                                            @onclick="() => NavigateToPortfolio(g.Id)">
                                        @g.Name
                                    </button>
                                }
                                else
                                {
                                    <div class="font-semibold truncate flex-1 text-sm text-slate-700">@g.Name</div>
                                }

                                @if (g.CanManage)
                                {
                                    <div class="shrink-0" @onclick:stopPropagation="true">
                                        @{
                                            FloatingDropdown? groupDropdown = default;
                                        }
                                        <FloatingDropdown @ref="groupDropdown" MinWidth="220" CloseOnContentClick="true">
                                            <ChildContent>
                                                <FluentButton Appearance="Appearance.Stealth" Title="@L["Nav_Options"]">⋯</FluentButton>
                                            </ChildContent>
                                            <DropdownContent>
                                                <div class="rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden py-1">
                                                    <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50">
                                                        Gruppe: @g.Name
                                                    </div>
                                                    <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                                            @onclick="async () => { if (groupDropdown != null) await groupDropdown.CloseAsync(); OpenManageGroupLists(g.Id); }">
                                                        @L["Nav_AddRemoveLists"]
                                                    </button>
                                                    <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                                            @onclick="async () => { if (groupDropdown != null) await groupDropdown.CloseAsync(); OpenRenameGroup(g.Id, g.Name); }">
                                                        @L["Nav_RenameGroup"]
                                                    </button>
                                                    @if (g.OwnerId == _userId)
                                                    {
                                                        @if (ProductFeatures.IsEnabled(ProductFeatureIds.Portfolios))
                                                        {
                                                            <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                                                    @onclick="async () => { if (groupDropdown != null) await groupDropdown.CloseAsync(); await TogglePortfolioAsync(g); }">
                                                                @(g.IsPortfolio ? "Portfolio deaktivieren" : "In Portfolio umwandeln")
                                                            </button>
                                                        }
                                                        <div class="h-px bg-slate-100 my-1"></div>
                                                        <button class="w-full text-left px-3 py-2 hover:bg-red-50 text-red-700"
                                                                @onclick="async () => { if (groupDropdown != null) await groupDropdown.CloseAsync(); OpenUngroupGroup(g.Id, g.Name); }">
                                                            @L["Nav_RemoveGrouping"]
                                                        </button>
                                                    }
                                                </div>
                                            </DropdownContent>
                                        </FloatingDropdown>
                                    </div>
                                }

                                <FluentButton Appearance="Appearance.Stealth"
                                              Title="@L["Nav_CollapseExpand"]"
                                              @onclick="() => ToggleGroupCollapseAsync(g.Id)">
                                    @if (collapsed)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ChevronUp())" />
                                    }
                                </FluentButton>
                            </div>

                            @if (!collapsed)
                            {
                                <div class="pl-7 pb-1">
                                    <div class="flex flex-col gap-1 nav-group-lists-host" data-groupid="@g.Id" data-canmanage="@(g.CanManage ? "true" : "false")">
                                        @foreach (var list in ListsInGroupOrdered(g.Id))
                                        {
                                            <button @key="list.Id" type="button"
                                                    class="@ListNavClass(list.Id)"
                                                    data-listid="@list.Id"
                                                    @onclick=@(() => Navigation.NavigateTo($"/list/{list.Id}"))>
                                                @if (!g.IsPortfolio || g.CanManage)
                                                {
                                                    <span class="nav-drag-handle inline-flex items-center justify-center w-5 cursor-grab select-none text-slate-300"
                                                          title="@L["Nav_DragToSort"]">⋮⋮</span>
                                                }

                                                <span aria-hidden="true" class="pt-0.5">
                                                    <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletList())" />
                                                </span>

                                                <span class="px-1 truncate">@list.Name</span>
                                            </button>
                                        }
                                    </div>

                                    @if (!ListsInGroupOrdered(g.Id).Any())
                                    {
                                        <div class="text-xs text-slate-400 px-2 py-1">
                                            @L["Nav_DropListsHere"]
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    var list = _lists.FirstOrDefault(x => x.Id == entry.Id);
                    @if (list is not null)
                    {
                        <button @key="list.Id" type="button"
                                class="nav-mixed-item @ListNavClass(list.Id)"
                                data-listid="@list.Id"
                                @onclick=@(() => Navigation.NavigateTo($"/list/{list.Id}"))>
                            <span class="nav-drag-handle inline-flex items-center justify-center w-5 cursor-grab select-none text-slate-300"
                                  title="@L["Nav_DragToSort"]">⋮⋮</span>

                            <span aria-hidden="true" class="pt-0.5">
                                <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletList())" />
                            </span>

                            <span class="px-1 truncate">@list.Name</span>
                        </button>
                    }
                }
            }
        </div>

    </div>

    <AuthorizeView>
        <Authorized>
            <div class="px-3 pb-3 shrink-0 border-t border-slate-200 pt-3 bg-white">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1">
                        <FluentButton Appearance="Appearance.Stealth"
                                      Title="@L["QuickLink_Trash"]"
                                      OnClick="@(() => Navigation.NavigateTo("/trash"))">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" />
                        </FluentButton>

                        <FloatingDropdown @ref="_notificationsDropdown" MinWidth="320" AlwaysAbove="true">
                            <ChildContent>
                                <span class="relative inline-flex">
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="Neueste Änderungen"
                                                  OnClick="ToggleNotificationsPanelAsync">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" />
                                    </FluentButton>
                                    @if (_unreadNotifications > 0)
                                    {
                                        <span class="absolute -top-1 -right-1 min-w-5 h-5 rounded-full bg-red-600 px-1 text-[11px] font-semibold leading-5 text-white text-center">
                                            @_unreadNotifications
                                        </span>
                                    }
                                </span>
                            </ChildContent>
                            <DropdownContent>
                                <div class="w-80 max-w-[calc(100vw-2rem)] rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                                    <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 flex items-center justify-between gap-2">
                                        <span>@L["Notifications_Latest"]</span>
                                        <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" @onclick="CloseNotificationsPanel">x</FluentButton>
                                    </div>
                                    <div class="max-h-80 overflow-auto divide-y divide-slate-100">
                                        @if (_latestNotifications.Count == 0)
                                        {
                                            <div class="px-3 py-4 text-sm text-slate-500">@L["Notifications_Empty"]</div>
                                        }
                                        else
                                        {
                                            @foreach (var n in _latestNotifications)
                                            {
                                                <div class="flex items-start gap-1 px-3 py-2 hover:bg-slate-50 @(n.ReadAtUtc is null ? "bg-blue-50/60" : "")">
                                                    <button class="min-w-0 flex-1 text-left"
                                                            @onclick="() => OpenNotificationAsync(n)">
                                                        <div class="flex items-center gap-2 text-sm font-medium text-slate-800">
                                                            @if (n.ReadAtUtc is null)
                                                            {
                                                                <span class="h-2 w-2 shrink-0 rounded-full bg-blue-600" aria-label="@L["Notifications_Unread"]"></span>
                                                            }
                                                            <span>@n.Title</span>
                                                        </div>
                                                        <div class="text-xs text-slate-500">@n.Message</div>
                                                        <div class="text-[11px] text-slate-400">@n.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                                                    </button>
                                                    <FluentButton Appearance="Appearance.Stealth"
                                                                  Title="@L["Btn_Delete"]"
                                                                  Disabled="@_notificationMutationBusy"
                                                                  OnClick="() => DeleteNotificationAsync(n.Id)">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
                                                    </FluentButton>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="border-t border-slate-100 p-2 flex items-center justify-between gap-2">
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      Disabled="@(_notificationMutationBusy || _latestNotifications.Count == 0)"
                                                      OnClick="DeleteAllNotificationsAsync">
                                            @L["Notifications_DeleteAll"]
                                        </FluentButton>
                                        <FluentButton Appearance="Appearance.Stealth" Disabled="@(_notificationMutationBusy || _unreadNotifications == 0)" OnClick="MarkNotificationsReadAsync">@L["Notifications_MarkAllRead"]</FluentButton>
                                    </div>
                                </div>
                            </DropdownContent>
                        </FloatingDropdown>
                    </div>

                    <FloatingDropdown @ref="_accountDropdown" MinWidth="220" AlwaysAbove="true" CloseOnContentClick="true">
                        <ChildContent>
                            <button type="button"
                                    class="app-account-menu-trigger inline-flex items-center gap-2 rounded-xl hover:bg-slate-100 p-2 transition-colors"
                                    title="@_userName">
                                @if (!string.IsNullOrEmpty(_profilePictureUrl))
                                {
                                    <img src="@_profilePictureUrl" alt="@_userName"
                                         class="w-9 h-9 rounded-full object-cover shrink-0 border border-slate-200"
                                         @key="_profilePictureUrl" />
                                }
                                else
                                {
                                    <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-semibold shrink-0">
                                        @(_userName?.Length > 0 ? _userName[0].ToString().ToUpper() : "?")
                                    </div>
                                }
                                <FluentIcon Value="@(new Icons.Regular.Size20.ChevronDown())" Color="Color.Neutral" />
                            </button>
                        </ChildContent>
                        <DropdownContent>
                            <div class="rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden py-1">
                                @* Konto-Einstellungen *@
                                <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50">
                                    @_userName
                                </div>

                                <button type="button"
                                        class="w-full text-left px-4 py-2.5 text-sm hover:bg-slate-50 flex items-center gap-2"
                                        @onclick="@(() => NavigateFromAccountMenuAsync("/konto"))">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="Color.Neutral" />
                                    @L["Nav_Account"]
                                </button>

                                <button type="button"
                                        class="w-full text-left px-4 py-2.5 text-sm hover:bg-slate-50 flex items-center gap-2"
                                        @onclick="@(() => NavigateFromAccountMenuAsync("/profile"))">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.ImageCircle())" Color="Color.Neutral" />
