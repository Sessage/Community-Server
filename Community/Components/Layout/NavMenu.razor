                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseManageGroupLists">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="text-sm text-slate-600 mb-2">
                @L["Dlg_ManageGroupLists_Description"]
            </div>

            <div class="mb-4 flex flex-col sm:flex-row gap-2 sm:items-end rounded-xl border border-slate-200 bg-slate-50 p-3">
                <div class="flex-1">
                    <div class="text-sm font-medium text-slate-700 mb-1">@ManageGroupCreateLabel</div>
                    <input class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                           placeholder="@L["Lbl_ListName"]" aria-label="@L["Lbl_ListName"]" maxlength="200" disabled="@_manageCreateBusy" @bind-value="_manageNewListName" @bind-value:event="oninput" @onkeydown="HandleManageNewListKeyDown" />
                </div>
                <FluentButton Appearance="Appearance.Accent" Disabled="@(_manageCreateBusy || string.IsNullOrWhiteSpace(_manageNewListName))" OnClick="CreateListInManagedGroupAsync">@L["Btn_Create"]</FluentButton>
            </div>

            <div class="space-y-2 max-h-[55vh] overflow-auto pr-1">
                @foreach (var l in _lists.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                {
                    var isInGroup = l.NavigationGroupId == _manageGroupId;
                    var canChange = CanChangeListPlacement(l, isInGroup ? null : _manageGroupId);

                    <div class="flex items-center gap-2 rounded-xl border border-slate-200 p-2 bg-white">
                        <FluentCheckbox Value="@isInGroup"
                                        Disabled="@(!canChange)"
                                        ValueChanged="@(v => ToggleListInManageGroup(l.Id, v))" />
                        <div class="truncate">@l.Name</div>
                    </div>
                }
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseManageGroupLists">@L["Btn_Done"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

