    private static NavLinkMatch GetQuickLinkMatch(string href)
        => href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix;

    private async Task NavigateFromAccountMenuAsync(string targetUri)
    {
        // FloatingDropdown wird außerhalb des normalen DOM-Flusses gerendert.
        // Deshalb vor der Navigation explizit schließen, damit es auf mobilen
        // Geräten nicht über der neu geladenen Seite stehen bleibt.
        if (_accountDropdown is not null)
            await _accountDropdown.CloseAsync();

        Navigation.NavigateTo(targetUri);
