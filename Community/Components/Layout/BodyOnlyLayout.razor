@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components


 
<FluentDialogProvider @rendermode="new InteractiveServerRenderMode(prerender: false)" />
<FluentMenuProvider @rendermode="new InteractiveServerRenderMode(prerender: false)" />

<div class="body-only-shell min-h-[100dvh] bg-slate-50 flex text-slate-900">
    <main class="p-2 max-w-6xl mx-auto flex-1 min-w-0 flex flex-col">
        <section class="mt-5 flex-1">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <button type="button" class="dismiss" aria-label="Fehlermeldung schließen">🗙</button>
</div>
    
