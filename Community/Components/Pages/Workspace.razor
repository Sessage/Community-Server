    private async Task OpenEmailImportDialogAsync()
    {
        _actionsOpen = false;
        if (_list is null || !CanAdminCurrentList()) return;

        ResetEmailImportDraft();
        try
        {
            var config = await EmailImportService.GetConfigurationAsync(_userId, _list.Id);
            if (config is not null)
            {
                _emailImportHasConfiguration = true;
                _emailImportEnabled = config.Enabled;
                _emailImportHost = config.Host;
                _emailImportPort = config.Port;
                _emailImportUseSsl = config.UseSsl;
                _emailImportUserName = config.UserName;
                _emailImportFolderName = string.IsNullOrWhiteSpace(config.FolderName) ? "INBOX" : config.FolderName;
                _emailImportTargetColumn = ResolveEmailImportTargetColumn(config.TargetColumn);
                _emailImportHasPassword = config.HasPassword;
                _emailImportLastImportAtUtc = config.LastImportAtUtc;
                _emailImportLastError = config.LastError;
                _emailImportFolders = new List<string> { _emailImportFolderName };
                if (!string.Equals(_emailImportFolderName, "INBOX", StringComparison.OrdinalIgnoreCase))
                    _emailImportFolders.Insert(0, "INBOX");
            }

            _emailImportOpen = true;
            EnsureEmailImportTargetColumn();
        }
        catch (Exception ex)
        {
            _error = $"E-Mail-Konfiguration konnte nicht geladen werden. Details: {ex.Message}";
        }
    }

    private void CloseEmailImportDialog() => _emailImportOpen = false;

    private async Task TestEmailImportConnectionAsync()
    {
        if (_list is null || !CanAdminCurrentList()) return;

        _emailImportBusy = true;
        _emailImportBusyText = "Verbindung wird geprüft...";
        _emailImportStatus = "";
        _emailImportTestSucceeded = false;
        _emailImportCreatedTasks.Clear();

        try
        {
            var result = await EmailImportService.TestConnectionAsync(_userId, _list.Id, BuildEmailImportRequest());
            _emailImportStatus = result.Message;
            _emailImportTestSucceeded = result.Success;

            if (result.Success)
            {
                _emailImportFolders = result.Folders.Count == 0 ? new List<string> { "INBOX" } : result.Folders.ToList();
                if (!_emailImportFolders.Contains(_emailImportFolderName, StringComparer.OrdinalIgnoreCase))
                    _emailImportFolderName = _emailImportFolders.FirstOrDefault(f => string.Equals(f, "INBOX", StringComparison.OrdinalIgnoreCase))
                        ?? _emailImportFolders.FirstOrDefault()
                        ?? "INBOX";
            }
        }
        catch (Exception ex)
