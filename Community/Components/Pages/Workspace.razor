        if (isOpen && !hookActive)
        {
            try
            {
                await JS.InvokeVoidAsync("todoUi.enableDialogOutsideCloseById", dialogId, _selfRef, Array.Empty<string>());
                return true;
            }
            catch { }
        }
        else if (!isOpen && hookActive)
        {
