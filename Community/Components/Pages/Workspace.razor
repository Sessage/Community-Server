    /* Dragging in ListView */
    private async Task OnDraggingChangedAsync(bool dragging)
    {
        _isDragging = dragging;

        if (!_isDragging && _reloadQueued)
        {
            _reloadQueued = false;
            var force = _reloadQueuedForce;
            _reloadQueuedForce = false;

            await ReloadAsyncCore(force: force);
        }
    }



    private Task ReloadAsync()
        => ReloadAsyncCore(force: false);

    private Task ReloadAsyncForce()
        => ReloadAsyncCore(force: true);

    private Task ReloadForListChangeAsync()
        => ReloadAsyncCore(force: false, showLoading: true);

    private async Task ReloadAsyncCore(bool force, bool? showLoading = null)
    {
        // ✅ Während Dragging nie reloaden – auch nicht "force"
        if (_isDragging)
        {
            _reloadQueued = true;
            _reloadQueuedForce = _reloadQueuedForce || force;
            return;
        }

        _error = "";
        var requestedListId = ListId ?? (_selectedListId != Guid.Empty ? _selectedListId : null);
        var shouldShowLoading = showLoading ?? (_list is null || (requestedListId.HasValue && _list.Id != requestedListId.Value));
        if (shouldShowLoading)
        {
            _listLoading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _lists = (await ListService.GetWorkspaceListsAsync(_userId, requestedListId)).ToList();

            if (_shareOpen && !CanAdminCurrentList())
                _shareOpen = false;

            if (_lists.Count == 0)
            {
                _list = null;
                _selectedListId = Guid.Empty;

                // ✅ Subscription ggf. aufräumen
                await EnsureListSubscriptionAsync();
                return;
            }

            if (ListId.HasValue)
                _selectedListId = ListId.Value;
            else if (_selectedListId == Guid.Empty)
                _selectedListId = _lists[0].Id;

            _list = _lists.FirstOrDefault(x => x.Id == _selectedListId) ?? _lists[0];
            _selectedListId = _list.Id;

            // ✅ Hier nach Auswahl/Load in die richtige Hub-Gruppe
            await EnsureListSubscriptionAsync();

            var keepFormsView = _view == BoardView.Forms;

            // Preferences...
            try
            {
                var pref = await ListPreferencesService.GetListPreferencesAsync(_userId, _list.Id);
                if (pref is not null && !keepFormsView)
                {
                    _view = pref.LastView switch
                    {
                        DefaultListView.Kanban => BoardView.Kanban,
                        DefaultListView.Calendar => BoardView.Calendar,
                        DefaultListView.Tabelle => BoardView.Table,
                        DefaultListView.Forms => BoardView.Forms,
                        _ => BoardView.List
                    };
                    _listSortMode = pref.ListSortMode;
                    _kanbanSortMode = pref.KanbanSortMode;
                }
                else if (!keepFormsView)
                {
                    _view = _list.DefaultView switch
                    {
                        DefaultListView.Kanban => BoardView.Kanban,
                        DefaultListView.Calendar => BoardView.Calendar,
                        DefaultListView.Tabelle => BoardView.Table,
                        DefaultListView.Forms => BoardView.Forms,
                        _ => BoardView.List
                    };
                }
            }
            catch { }

            if (_selectedTaskId.HasValue && _list is not null)
            {
                _selectedTask = _list.Tasks.FirstOrDefault(task => task.Id == _selectedTaskId.Value);
                if (_selectedTask is null) _selectedTaskId = null;
            }
        }
        catch (Exception ex)
        {
            _error = $"Beim Laden ist ein Fehler aufgetreten. Benutzer: '{_userId}'. Details: {ex.Message}";
        }
        finally
        {
            if (shouldShowLoading)
                _listLoading = false;
        }
    }


    private async Task SwitchView(BoardView v)
    {
        if (_viewDropdown is not null)
        {
            await _viewDropdown.CloseAsync();
        }

        _view = v;
        _selectionMode = false;

        // Auswahl beim View-Wechsel zurücksetzen
        _selectedTaskId = null;
        _selectedTask = null;

        CloseOverlays();

        // ✅ Persistieren (nur wenn Liste vorhanden)
        if (_list is not null)
        {
            var prefView = _view switch
            {
                BoardView.Kanban => DefaultListView.Kanban,
                BoardView.Calendar => DefaultListView.Calendar,
                BoardView.Table => DefaultListView.Tabelle,
                BoardView.Forms => DefaultListView.Forms,
                _ => DefaultListView.Liste
            };

            // View speichern, Sortmodes beibehalten
            await ListPreferencesService.SetListPreferencesAsync(
                _userId,
                _list.Id,
                prefView,
                _listSortMode,
                _kanbanSortMode);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleBulkSelection()
        => _selectionMode = !_selectionMode;


    private async Task SetSortAsync(ListSortMode mode)
    {
        if (_list is null) return;

        if (_view == BoardView.List) _listSortMode = mode;
        else if (_view == BoardView.Kanban) _kanbanSortMode = mode;
        else
        {
            CloseOverlays();
            return;
        }

        CloseOverlays();

        // ✅ Persistieren (Sort nur für die betroffene View ändern)
        await ListPreferencesService.SetListPreferencesAsync(
            _userId,
            _list.Id,
            null, // View unverändert
            _listSortMode,
            _kanbanSortMode);

        await InvokeAsync(StateHasChanged);
    }


