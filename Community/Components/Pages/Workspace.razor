    private async Task OpenNotificationAsync(UserNotificationEntity notification)
    {
        _notificationsOpen = false;
        if (notification.TaskId.HasValue)
            Nav.NavigateTo($"/list/{notification.ListId}?taskId={notification.TaskId.Value}");
        else
            Nav.NavigateTo($"/list/{notification.ListId}");
        await Task.CompletedTask;
