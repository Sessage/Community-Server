    private void HandleTaskUpdated(TodoTaskEntity updatedTask)
    {
        if (_selectedTaskId == updatedTask.Id)
            _selectedTask = updatedTask;

        if (_list?.Tasks is null) return;

        var existing = _list.Tasks.FirstOrDefault(t => t.Id == updatedTask.Id);
        if (existing is null) return;

        // Felder patchen (Referenz bleibt gleich)
        existing.Title = updatedTask.Title;
        existing.Description = updatedTask.Description;
        existing.StartDate = updatedTask.StartDate;
        existing.DueDate = updatedTask.DueDate;
        existing.Done = updatedTask.Done;
        existing.IsImportant = updatedTask.IsImportant;
        existing.Assignee = updatedTask.Assignee;
        existing.Recurrence = updatedTask.Recurrence;
        existing.CustomRecurrence = updatedTask.CustomRecurrence;
        existing.Column = updatedTask.Column;

        // Children ersetzen (ok)
        existing.Attachments = updatedTask.Attachments;
        existing.Comments = updatedTask.Comments;
        existing.Steps = updatedTask.Steps;
        existing.Watchers = updatedTask.Watchers;
        existing.CustomFieldValues = updatedTask.CustomFieldValues;

        // ✅ Sortable neu synchronisieren
        _listViewRef?.RequestSortableResync();

        StateHasChanged();
    }



