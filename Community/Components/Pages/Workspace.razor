    private string ResolveEmailImportTargetColumn(string? configuredColumn)
    {
        var columns = EmailImportColumnOptions;
        if (columns.Count == 0)
            return "Backlog";

        if (!string.IsNullOrWhiteSpace(configuredColumn))
        {
            var existing = columns.FirstOrDefault(column => string.Equals(column, configuredColumn.Trim(), StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(existing))
                return existing;
        }

        return columns[0];
    }

