    /* Hub */
    private async Task StartHubAsync()
    {
        if (_hubStarted) return;

        _hubConnection = await HubConnectionFactory.CreateAsync();
        if (_hubConnection is null)
            return;

        // ✅ Wenn sich eine Liste ändert -> nur reload, wenn wir diese Liste gerade offen haben
        _hubConnection.On<Guid>(TodoHub.ListsUpdated, async (listId) =>
        {
            if (listId != _selectedListId) return;

            await InvokeAsync(async () =>
            {
                // nicht "force", weil Dragging-Queue sonst übergangen würde
                await ReloadAsyncCore(force: false);
                StateHasChanged();
            });
        });

        // ✅ Wenn ein Kommentar oder Anhang sich ändert -> Liste neu laden (Kommentar-/Anhang-Zähler aktualisieren)
        _hubConnection.On<Guid, Guid>(TodoHub.TaskCommentsUpdated, async (listId, taskId) =>
        {
            if (listId != _selectedListId) return;

            await InvokeAsync(async () =>
            {
                await ReloadAsyncCore(force: false);
                StateHasChanged();
            });
        });

        _hubConnection.On<Guid, Guid>(TodoHub.TaskAttachmentsUpdated, async (listId, taskId) =>
        {
            if (listId != _selectedListId) return;

            await InvokeAsync(async () =>
            {
                await ReloadAsyncCore(force: false);
                StateHasChanged();
            });
        });

        _hubConnection.On(TodoHub.BrowserNotification, async () =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshNotificationsAsync();
                StateHasChanged();
            });
        });

        _hubConnection.On<string, string, Guid>(TodoHub.ReminderTriggered, async (title, body, taskId) =>
        {
            await InvokeAsync(async () =>
            {
                try { await JS.InvokeVoidAsync("todoUi.showNotification", title, body); } catch { }

                await RefreshNotificationsAsync();

                if (_selectedListId != Guid.Empty)
                    await ReloadAsyncCore(force: false);

                StateHasChanged();
            });
        });

        // ✅ Reconnect: User + List subscriptions erneut setzen
        _hubConnection.Reconnected += async _ =>
        {
            try
            {
                await _hubConnection.SendAsync(TodoHub.SubscribeToUser, _userId);

                if (_selectedListId != Guid.Empty)
                {
                    await _hubConnection.SendAsync(TodoHub.SubscribeToList, _selectedListId);
                    _subscribedListId = _selectedListId;
                }
            }
            catch { }
        };

        await _hubConnection.StartAsync();
        await _hubConnection.SendAsync(TodoHub.SubscribeToUser, _userId);

        _hubStarted = true;
    }

    private async Task EnsureListSubscriptionAsync()
    {
        if (_hubConnection is null) return;
        if (_hubConnection.State != HubConnectionState.Connected) return;

        // keine Liste offen -> ggf. abmelden
        if (_selectedListId == Guid.Empty)
        {
            if (_subscribedListId is not null)
            {
                try { await _hubConnection.SendAsync(TodoHub.UnsubscribeFromList, _subscribedListId.Value); } catch { }
                _subscribedListId = null;
            }
            return;
        }

        // schon korrekt subscribed
        if (_subscribedListId == _selectedListId) return;

        // alte List-Gruppe verlassen
        if (_subscribedListId is not null)
        {
            try { await _hubConnection.SendAsync(TodoHub.UnsubscribeFromList, _subscribedListId.Value); } catch { }
        }

        // neue List-Gruppe beitreten
        await _hubConnection.SendAsync(TodoHub.SubscribeToList, _selectedListId);
        _subscribedListId = _selectedListId;
    }

