@page "/list/{ListId:guid?}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Klassenbibliothek.Components.Views
@using Klassenbibliothek.Data
@using System.Security.Claims
@inject ITodoListService ListService
@inject ITodoListPreferencesService ListPreferencesService
@inject INotificationService NotificationService
@inject IListEmailImportService EmailImportService
@inject ITodoTrashService TrashService
@inject AuthenticationStateProvider AuthStateProvider
@inject ITodoHubConnectionFactory HubConnectionFactory
@inject NavigationManager Nav
@inject UserDirectoryService Directory
@inject IJSRuntime JS
@inject IProductFeatureCatalog ProductFeatures
@using Klassenbibliothek.Features
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>@L["Workspace_PageTitle"]</PageTitle>

<div class="mx-auto h-full min-h-0 flex flex-col overflow-hidden overflow-x-hidden"
     style="@(!string.IsNullOrWhiteSpace(_list?.BackgroundColor) ? $"background-color:{_list!.BackgroundColor}" : "")">

    <!-- Sticky Header -->
    <div class="sticky rounded-xl top-0 z-30 shrink-0">
        <div class="py-2 px-4 flex items-center justify-between gap-3">

            <div class="min-w-0 flex items-center gap-3">
                @if (ToggleNavCallback is not null)
                {
                    <FluentButton Appearance="Appearance.Stealth"
                                          Title="@L["Nav_CollapseExpand"]"
                                          OnClick="ToggleNavCallback">
                        @if (IsNavCollapsed)
                        {
                            
                            
                                <FluentIcon Value="@(new Icons.Regular.Size20.ChevronRight())" />
                           
                        }
                        else
                        {
                          
                                <FluentIcon Value="@(new Icons.Regular.Size20.ChevronLeft())" />
                            
                            
                        }
                    </FluentButton>
                   
                }
                <div class="text-lg font-semibold truncate">
                    <span class="inline-flex items-center rounded-md px-2 py-1"
                              style="background-color: var(--neutral-fill-stealth-rest); color: var(--neutral-foreground-rest);">
                              @(_list?.Name ?? "—")
                              </span>
                    </div>
                <div class="text-sm whitespace-nowrap">
                    @{
                        var total = _list?.Tasks?.Count ?? 0;
                        var filtered = total; // optional: könntest du in Workspace berechnen, wenn du willst
                    }
                    <div class="text-sm whitespace-nowrap">
                        <span class="inline-flex items-center rounded-md px-2 py-1"
                              style="background-color: var(--neutral-fill-stealth-rest); color: var(--neutral-foreground-rest);">
                        @L["Page_Workspace_Tasks"] @total
                        </span>
                        @if (_filter.IsActive())
                        {
                            <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-green-100 border border-green-200 text-green-700">
                                @L["Page_Workspace_FilterActive"]
                            </span>
                        }
                        @if (_currentSortMode != ListSortMode.Custom)
                        {
                            <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-green-100 border border-green-200 text-green-700">
                                @L["Page_Workspace_SortActive"]
                            </span>
                        }
                    </div>

                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">

                @if (SupportsBulkSelection)
                {
                    <FluentButton Appearance="Appearance.Stealth"
                                  Style="@(_selectionMode ? "background-color:#dbeafe;color:#1d4ed8;" : null)"
                                  Disabled="@(_list is null)"
                                  Title="@L["Bulk_SelectTasks"]"
                                  aria-pressed="@_selectionMode"
                                  OnClick="ToggleBulkSelection">
                        @if (_selectionMode)
                        {
                            <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkSquare())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkSquare())" />
                        }
                    </FluentButton>
                }

                <FluentButton Appearance="Appearance.Stealth"
                              Disabled="@(_list is null)"
                              Title="@(IsWatchingList ? L["Workspace_StopWatching"] : L["Workspace_StartWatching"])"
                              OnClick="ToggleListWatchingAsync">
                    @if (IsWatchingList)
                    {
                        <FluentIcon Value="@(new Icons.Filled.Size20.Alert())" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" />
                    }
                </FluentButton>

                <FloatingDropdown @ref="_viewDropdown">
                    <ChildContent>
                        <button type="button"
                                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
                            <span>@CurrentViewLabel</span>
                            <span aria-hidden="true">▾</span>
                        </button>
                    </ChildContent>
                    <DropdownContent>
                        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg">
                            <button class="@ViewMenuItemCss(BoardView.List)" @onclick="() => SwitchView(BoardView.List)">
                                @L["Page_Workspace_ListView"]
                            </button>
                            <button class="@ViewMenuItemCss(BoardView.Kanban)" @onclick="() => SwitchView(BoardView.Kanban)">
                                @L["Page_Workspace_KanbanView"]
                            </button>
                            <button class="@ViewMenuItemCss(BoardView.Calendar)" @onclick="() => SwitchView(BoardView.Calendar)">
                                @L["QuickLink_Calendar"]
                            </button>
                            <button class="@ViewMenuItemCss(BoardView.Table)" @onclick="() => SwitchView(BoardView.Table)">
                                @L["Workspace_TableView"]
                            </button>
                            @if (ProductFeatures.IsEnabled(ProductFeatureIds.Forms))
                            {
                                <button class="@ViewMenuItemCss(BoardView.Forms)" @onclick="() => SwitchView(BoardView.Forms)">@L["FormDesigner_Forms"]</button>
                            }
                        </div>
                    </DropdownContent>
                </FloatingDropdown>

                <!-- Papierkorb: Gelöschte Aufgaben wiederherstellen -->
                <div class="relative">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Title="@L["Page_Workspace_RestoreTasks"]"
                                  OnClick="OpenRestoreTasksDialog">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowCounterclockwise())" />
                    </FluentButton>
                </div>

                <div class="relative">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Title="@L["Page_Workspace_FilterTitle"]"
                                  OnClick="OpenFilterDialog">
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Filter())" />
                    </FluentButton>
                </div>

                @if (_view != BoardView.Table && _view != BoardView.Forms)
                {
                <!-- Actions Dropdown (ohne FluentMenu) -->
                <div class="relative">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Title="@L["Nav_Options"]"
                                  @onclick="ToggleSorts">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSort())" />
                    </FluentButton>

                    @if (_sortsOpen)
                    {
                        <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-slate-200 bg-white shadow-lg z-50 overflow-hidden"
                             @onclick:stopPropagation="true">

                            <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 flex items-center justify-between gap-2">
                                <span>@L["Dashboard_SortBy"]</span>
                                <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" @onclick="() => _sortsOpen = false">✕</FluentButton>
                            </div>

                            <button class="@MenuItemCss(_currentSortMode == ListSortMode.Custom)"
                                    @onclick="() => SetSortAsync(ListSortMode.Custom)">
                                @L["Sort_Custom"]
                            </button>
                            <button class="@MenuItemCss(_currentSortMode == ListSortMode.Importance)"
                                    @onclick="() => SetSortAsync(ListSortMode.Importance)">
                                @L["Sort_Importance"]
                            </button>
                            <button class="@MenuItemCss(_currentSortMode == ListSortMode.DueDate)"
                                    @onclick="() => SetSortAsync(ListSortMode.DueDate)">
                                @L["Sort_DueDate"]
                            </button>
                            <button class="@MenuItemCss(_currentSortMode == ListSortMode.Alphabetical)"
                                    @onclick="() => SetSortAsync(ListSortMode.Alphabetical)">
                                @L["Sort_Alphabetical"]
                            </button>
                            <button class="@MenuItemCss(_currentSortMode == ListSortMode.CreatedAt)"
                                    @onclick="() => SetSortAsync(ListSortMode.CreatedAt)">
                                @L["Sort_CreatedAt"]
                            </button>

                            
                        </div>
                    }
                </div>
                }

                @if (CanAdminCurrentList())
                {
                <!-- Actions Dropdown (ohne FluentMenu) -->
                <div class="relative">
                    <FluentButton Appearance="Appearance.Stealth"
                                  Title="@L["Nav_Options"]"
                                  @onclick="ToggleActions">
                        ⋯
                    </FluentButton>

                    @if (_actionsOpen)
                    {
                        <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-slate-200 bg-white shadow-lg z-50 overflow-hidden"
                             @onclick:stopPropagation="true">


                            
                                <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 flex items-center justify-between gap-2">
                                    <span>@L["Workspace_ListOptions"]</span>
                                    <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" @onclick="() => _actionsOpen = false">✕</FluentButton>
                                </div>

                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenRenameDialog">
                                    @L["Workspace_RenameList"]
                                </button>

                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenLabelsDialog">
                                    @L["Workspace_ManageLabels"]
                                </button>
                                @if (ProductFeatures.IsEnabled(ProductFeatureIds.Forms))
                                {
                                    <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                            @onclick="OpenCustomFieldsDialog">
                                        @L["CustomField_SectionTitle"]
                                    </button>
                                }
                                @if (ProductFeatures.IsEnabled(ProductFeatureIds.Automation))
                                {
                                    <button class="w-full text-left px-3 py-2 hover:bg-slate-50" @onclick="OpenAutomationDialog">@L["Automation_Title"]</button>
                                }
                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenBackgroundDialog">
                                    @L["Workspace_ChangeBackground"]
                                </button>

                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenNotificationSettingsDialog">
                                    @L["Workspace_Notifications"]
                                </button>
                                @if (ProductFeatures.IsEnabled(ProductFeatureIds.EmailImport))
                                {
                                    <button class="w-full text-left px-3 py-2 hover:bg-slate-50" @onclick="OpenEmailImportDialogAsync">E-Mail</button>
                                }

                                <div class="my-1 border-t border-slate-100"></div>

                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenCopyDialog">
                                    @L["Workspace_CopyList"]
                                </button>
                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenTemplateDialog">
                                    @L["Workspace_SaveAsTemplate"]
                                </button>
                                <button class="w-full text-left px-3 py-2 hover:bg-slate-50"
                                        @onclick="OpenExportDialog">
                                    @L["Dashboard_Export"]
                                </button>

                                <div class="my-1 border-t border-slate-100"></div>

                                <button class="w-full text-left px-3 py-2 hover:bg-red-50 text-red-700"
                                        @onclick="OpenDeleteDialog">
                                    @L["Workspace_DeleteList"]
                                </button>
                            
                        </div>
                    }
                </div>
                }

                <!-- Share -->
                <!-- Share (nur Admin) -->
                @if (_list is not null && CanAdminCurrentList())
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="OpenShareDialog">
                        @L["Workspace_Share"]
                    </FluentButton>
                }

            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="flex-1 min-h-0 overflow-hidden" @onclick="CloseOverlays">
        <div class="flex flex-col lg:flex-row gap-4 h-full min-h-0">

            <!-- Main -->
            <div class="flex-1 min-w-0 min-h-0 overflow-hidden">
                <div class="flex flex-col h-full min-h-0">

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="mt-4 mx-5 md:mx-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 shrink-0">
                            <div class="font-semibold">@L["Lbl_Error"]</div>
                            <div>@_error</div>
                        </div>
                    }

                    <div class="flex-1 min-h-0 overflow-hidden pt-2">
                        @if (_listLoading)
                        {
                            <div class="px-4 py-3 flex items-center gap-2 text-slate-600">
                                <FluentProgressRing Style="width:20px;height:20px;" />
                                <span>@L["Lbl_Loading"]</span>
                            </div>
                        }
                        else if (_list is null)
                        {
                            <div class="text-slate-600 px-4">@L["Workspace_NoListLoaded"]</div>
                        }
                        else
                        {
                            @if (_view == BoardView.List)
                            {
                                <ToDoListView @ref="_listViewRef"
                                              List="_list"
                                              Filter="_filter"
                                              SidebarVisible="_selectedTask is not null"
                                              SortMode="_listSortMode"
                                              @bind-SelectionMode="_selectionMode"
                                              OnChanged="ReloadAsync"
                                              OnDraggingChanged="OnDraggingChangedAsync"
                                              OnTaskSelected="OpenTaskDetails" />

                               @*  <ToDoListView @ref="_listViewRef" 
                                    List="_list"
                                              SidebarVisible="_selectedTask is not null"
                                              SortMode="_listSortMode"
                                              OnChanged="ReloadAsync"
                                              OnDraggingChanged="OnDraggingChangedAsync"
                                              OnTaskSelected="OpenTaskDetails" /> *@

                               

                            }
                            else if (_view == BoardView.Kanban)
                            {

                                <ToDoKanbanView @key="_view"
                                                List="_list"
                                                Filter="_filter"
                                                SortMode="_kanbanSortMode"
                                                @bind-SelectionMode="_selectionMode"
                                                OnChanged="ReloadAsync"
                                                OnDraggingChanged="OnDraggingChangedAsync"
                                                OnTaskSelected="OpenTaskDetails" />

                                @* <ToDoKanbanView @key="_view"
                                                List="_list"
                                                SortMode="_kanbanSortMode"
                                                OnChanged="ReloadAsync"
                                                OnTaskSelected="OpenTaskDetails" /> *@

                            }
                            else if (_view == BoardView.Table)
                            {
                                <ToDoTableView List="_list"
                                               EnableCustomFields="@ProductFeatures.IsEnabled(ProductFeatureIds.Forms)"
                                               Filter="_filter"
                                               AvailableLists="_lists"
                                               @bind-SelectionMode="_selectionMode"
                                               OnChanged="ReloadAsync"
                                               OnTaskUpdated="HandleTaskUpdated"
                                               OnTaskSelected="OpenTaskDetails"
                                               OnTaskOpenRequested="OpenTaskFromTable"
                                               OnTaskDetailsRequested="OpenTaskDetailsFromTable"
                                               OnTaskAttachmentsRequested="OpenTaskAttachmentsFromTable"
                                               OnTaskCommentsRequested="OpenTaskCommentsFromTable" />
                            }
                            else if (_view == BoardView.Forms)
                            {
                                <TodoFormDesignerView List="_list"
                                                      UserId="@_userId"
                                                      OnChanged="ReloadAsync" />
                            }
                            else
                            {
                                <TodoCalendarView Items="GetCalendarItemsForCurrentList()"
                                                  OnItemClick="OpenCalendarTaskAsync"
                                                  EmptyText="@L["Page_Calendar_Empty"]"
                                                  HostClass="p-3 h-full"
                                                  ContainerClass="min-h-[70vh] rounded-xl border border-slate-200 bg-white p-3 shadow-sm" />
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            @if (_selectedTask is not null)
            {
                @* <aside class="w-full lg:w-96 shrink-0 h-full min-h-0 overflow-hidden"> *@
                    @* <TaskDetailsPanel Task="_selectedTask"
                                      ListId="_selectedListId"
                                      Columns="_list?.Columns"
                                      Labels="_list?.Labels"
                                      OnClose="CloseTaskDetails"
                                      OnTaskUpdated="HandleTaskUpdated"
                                      OnListChanged="ReloadAsync" /> *@

                     <TaskEditModal @key="SelectedTaskModalKey"
                                      Task="_selectedTask"
                                      ListId="_selectedListId"
                                     Columns="_list?.Columns"
                                     Labels="_list?.Labels"
                                     List="_list"
                                     AvailableLists="_lists"
                                     EnableCustomFields="@ProductFeatures.IsEnabled(ProductFeatureIds.Forms)"
                               InitialTabId="@_selectedTaskInitialTabId"
                               InitialTabVersion="@_selectedTaskInitialTabVersion"
                                      OnClose="CloseTaskDetails"
                                      OnTaskUpdated="HandleTaskUpdated"
                                      OnListChanged="ReloadAsync" />

               @*  </aside> *@
            }
        </div>
    </div>
</div>

@if (_renameOpen)
{
    <FluentDialog id="workspace-rename-dlg" Open="true" Modal="true" Style="width:min(560px,92vw);" TrapFocus="true" HiddenChanged="@(_ => CloseRenameDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_RenameList"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseRenameDialog">✕</FluentButton>

            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-2">
                <div class="text-sm text-slate-600">@L["Workspace_NewName"]</div>
                <input class="w-full rounded-xl border border-slate-200 p-2"
                       @bind="_renameValue" />
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseRenameDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="RenameAsync" Disabled="@(_list is null)">@L["Btn_Save"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_customFieldsOpen && _list is not null && ProductFeatures.IsEnabled(ProductFeatureIds.Forms))
{
    <div class="fixed inset-0 flex items-center justify-center p-4"
         style="z-index: 1000; background: rgba(0, 0, 0, 0.35);"
         role="presentation"
         @onclick="CloseCustomFieldsDialog">
        <div class="w-full rounded-lg bg-white shadow-2xl"
             style="max-width: 953px; max-height: calc(100vh - 48px); overflow: auto;"
             role="dialog"
             aria-modal="true"
             aria-labelledby="workspace-custom-fields-title"
             @onclick:stopPropagation="true">
            <div class="flex items-center justify-between gap-3 px-8 pb-6 pt-8">
                <div id="workspace-custom-fields-title" class="text-xl font-semibold">@L["CustomField_SectionTitle"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseCustomFieldsDialog">✕</FluentButton>
            </div>
            <div class="px-8 pb-8">
                <CustomFieldManagerPanel List="_list" AvailableLists="_lists" UserId="@_userId" OnChanged="ReloadAsync" />
            </div>
        </div>
    </div>
}

@if (_automationOpen && _list is not null && CanAdminCurrentList())
{
    <div class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/40 p-4"
         role="presentation"
         @onclick="CloseAutomationDialog">
        <section class="flex max-h-[calc(100dvh-32px)] w-full max-w-[1120px] flex-col overflow-hidden rounded-lg bg-white shadow-2xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="workspace-automation-title"
                 @onclick:stopPropagation="true">
            <div class="shrink-0 border-b border-slate-200 px-6 py-4">
            <div class="flex w-full items-center justify-between gap-4">
                <div class="min-w-0">
                    <div id="workspace-automation-title" class="text-lg font-semibold text-slate-900">@L["Automation_Title"]</div>
                    <div class="truncate text-sm text-slate-500">@_list.Name</div>
                </div>
                <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" OnClick="CloseAutomationDialog">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" />
                </FluentButton>
            </div>
            </div>
            <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
                <AutomationManagerPanel @key="_list.Id"
                                        List="_list"
                                        UserId="@_userId"
                                        OnChanged="ReloadAsync" />
            </div>
        </section>
    </div>
}

@if (_deleteOpen)
{
    <FluentDialog id="workspace-delete-dlg" Open="true" Modal="true" Style="width:min(560px,92vw);" TrapFocus="true" HiddenChanged="@(_ => CloseDeleteDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold text-red-700">@L["Workspace_DeleteList"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseDeleteDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-2">
                <div>@((MarkupString)string.Format(L["Workspace_DeleteListConfirm"], $"<span class=\"font-semibold\">{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(_list?.Name ?? string.Empty)}</span>"))</div>
                <div class="text-sm text-slate-600">@L["Workspace_DeleteListWarning"]</div>
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseDeleteDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="DeleteAsync" Disabled="@(_list is null)">
                @L["Btn_Delete"]
            </FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_shareOpen)
{
    <FluentDialog id="workspace-share-dlg" Open="true" Modal="true" Style="width:min(1100px,96vw); max-width:96vw; height:min(820px,92vh); max-height:92vh; --dialog-width: min(1100px, 96vw); --dialog-height: min(820px, 92vh);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_Share"]</div>
                
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseShareDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="share-dialog-scroll-content max-h-[calc(92vh-120px)] overflow-y-auto">
                <ParticipantsPanel List="_list"
                                   Directory="Directory"
                                   RequestingUserId="@_userId"
                                   OnChanged="ReloadAsync" />
            </div>
        </FluentDialogBody>

        
    </FluentDialog>
}

@if (_labelsOpen)
{
    <FluentDialog id="workspace-labels-dlg" Open="true" Modal="true" Style="--dialog-width: min(600px, 96vw);" TrapFocus="true" HiddenChanged="@(_ => CloseLabelsDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_ManageLabels"]</div>
               
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseLabelsDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            @if (_list is null)
            {
                <div class="text-slate-600">@L["Workspace_NoListLoaded"]</div>
            }
            else
            {
                <LabelManagerPanel ListId="_list.Id"
                                   Labels="_list.Labels"
                                   OnChanged="ReloadAsyncForce" />
            }
        </FluentDialogBody>

       
    </FluentDialog>
}

@if (_backgroundOpen)
{
    <FluentDialog id="workspace-background-dlg" Open="true" Modal="true" Style="width:min(480px,92vw);" TrapFocus="true" HiddenChanged="@(_ => CloseBackgroundDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_ChangeBackground"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseBackgroundDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <LabelColorPicker Palette="@_backgroundPalette"
                              SelectedColor="@_backgroundDraft"
                              SelectedColorChanged="@(c => _backgroundDraft = c)"
                              ShowHexValue="true" />
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseBackgroundDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="SaveBackgroundAsync" Disabled="@(_list is null)">@L["Btn_Save"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_restoreTasksOpen && _list is not null)
{
    <FluentDialog id="workspace-restore-dlg" Open="true" Modal="true" Style="--dialog-width: min(640px, 96vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 font-semibold">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowCounterclockwise())" />
                    @L["Workspace_RestoreDeletedTasks"]
                </div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseRestoreTasksDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            @if (_restoreTasksLoading)
            {
                <div class="text-slate-500 text-sm py-4">@L["Lbl_Loading"]</div>
            }
            else if (_deletedTasks.Count == 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">
                    @L["Workspace_RestoreEmpty"]
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2 max-h-[55vh] overflow-auto pr-1">
                    @foreach (var task in _deletedTasks)
                    {
                        var daysLeft = TrashDaysLeft(task.DeletedAt);
                        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3 shadow-sm gap-3">
                            <div class="min-w-0">
                                <div class="font-medium truncate">@task.Title</div>
                                <div class="text-xs text-slate-500">
                                    @L["Workspace_RestoreDeletedOn"] @task.DeletedAt!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    &bull; @string.Format(L["Workspace_RestoreDaysLeft"], daysLeft)
                                </div>
                            </div>
                            <FluentButton Appearance="Appearance.Outline"
                                           Title="@L["Workspace_RestoreTask"]"
                                          OnClick="@(() => RestoreTaskAsync(task.Id))">
                                          <div class="flex">
                                <FluentIcon Value="@(new Icons.Regular.Size20.ArrowCounterclockwise())" />
                                <span class="ml-1 text-sm">@L["Btn_Restore"]</span>
                                </div>
                            </FluentButton>
                        </div>
                    }
                </div>
            }
        </FluentDialogBody>

        
    </FluentDialog>
}

@if (_filterOpen && _list is not null)
{
    <FluentDialog id="workspace-filter-dlg" Open="true" Modal="true" Style="--dialog-width: min(560px, 96vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_FilterTitle"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseFilterDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-4">

                <!-- Suche -->
                <div class="space-y-1">
                    <input class="w-full rounded-xl border border-slate-200 p-2"
                           placeholder="@L["Workspace_FilterPlaceholder"]"
                           @bind="_filterDraft.Query" />
                    <div class="text-xs text-slate-500">
                        @L["Workspace_FilterHint"]
                    </div>
                </div>

                <!-- Bearbeiter -->
                <div class="space-y-2">
                    <div class="text-sm font-semibold text-slate-700">@L["Workspace_FilterAssignee"]</div>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox"
                               class="accent-slate-700"
                               checked="@_filterDraft.AssignedToMe"
                               @onchange="OnAssignedToMeChanged" />
                        <span>@L["Workspace_FilterAssignedToMe"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox"
                               class="accent-slate-700"
                               checked="@_filterDraft.NoAssignee"
                               @onchange="OnNoAssigneeChanged" />
                        <span>@L["Workspace_FilterNoAssignee"]</span>
                    </label>
                </div>


                <!-- Mitglieder -->
                <div class="space-y-2">
                    <div class="text-sm font-semibold text-slate-700">@L["Task_Members"]</div>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.NoMembers" />
                        <span>@L["Workspace_FilterNoMembers"]</span>
                    </label>

                    <div class="rounded-xl border border-slate-200 p-2 space-y-2">
                        <div class="text-xs text-slate-500">@L["Workspace_FilterSelectMembers"]</div>

                        @foreach (var p in (_list.Participants ?? new()))
                        {
                            var uid = (p.UserId ?? "").Trim();
                            if (string.IsNullOrWhiteSpace(uid)) { continue; }

                            <label class="flex items-center gap-2 text-sm">
                                <input type="checkbox"
                                       class="accent-slate-700"
                                       checked="@IsMemberChecked(uid)"
                                       @onchange="(e) => ToggleMember(uid, e)" />
                                <span>@p.DisplayName</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Status -->
                <div class="space-y-2">
                    <div class="text-sm font-semibold text-slate-700">@L["Workspace_FilterCardStatus"]</div>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700"
                               checked="@(_filterDraft.Done == true)"
                               @onchange="(e) => SetDoneFilter(true, e)" />
                        <span>@L["Workspace_FilterDone"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700"
                               checked="@(_filterDraft.Done == false)"
                               @onchange="(e) => SetDoneFilter(false, e)" />
                        <span>@L["Workspace_FilterNotDone"]</span>
                    </label>
                </div>

                <!-- Frist -->
                <div class="space-y-2">
                    <div class="text-sm font-semibold text-slate-700">@L["Workspace_FilterDue"]</div>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.NoDueDate" />
                        <span>@L["Workspace_FilterNoDueDate"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.Overdue" />
                        <span>@L["Workspace_FilterOverdue"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.DueNextDay" />
                        <span>@L["Workspace_FilterDueNextDay"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.DueNextWeek" />
                        <span>@L["Workspace_FilterDueNextWeek"]</span>
                    </label>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" class="accent-slate-700" @bind="_filterDraft.DueNextMonth" />
                        <span>@L["Workspace_FilterDueNextMonth"]</span>
                    </label>
                </div>

                <!-- Labels -->
                <div class="space-y-2">
                    <div class="text-sm font-semibold text-slate-700">@L["Task_Labels"]</div>

                    @if (_list.Labels is null || _list.Labels.Count == 0)
                    {
                        <div class="text-sm text-slate-500">@L["Workspace_FilterNoLabels"]</div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var lab in _list.Labels)
                            {
                                <label class="flex items-center gap-2 text-sm">
                                    <input type="checkbox"
                                           class="accent-slate-700"
                                           checked="@_filterDraft.LabelIds.Contains(lab.Id)"
                                           @onchange="(e) => ToggleLabel(lab.Id, e)" />
                                    <span>@lab.Title</span>
                                </label>
                            }
                        </div>
                    }
                </div>

            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="ClearFilter">
                @L["Workspace_FilterReset"]
            </FluentButton>

            <div class="flex-1"></div>

            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseFilterDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="ApplyFilter">@L["Workspace_FilterApply"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@* ─── Liste kopieren ─────────────────────────────────────────────────────── *@
@if (_copyOpen)
{
    <FluentDialog id="workspace-copy-dlg" Open="true" Modal="true" Style="width:min(520px,92vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_CopyList"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseCopyDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-4">
                <div class="space-y-1">
                    <div class="text-sm text-slate-600">@L["Workspace_CopyName"]</div>
                    <input class="w-full rounded-xl border border-slate-200 p-2"
                           @bind="_copyName" />
                </div>
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="checkbox" class="accent-slate-700" @bind="_copyIncludeTasks" />
                    <span>@L["Workspace_CopyIncludeTasks"]</span>
                </label>
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseCopyDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="CopyListAsync"
                          Disabled="@(_list is null || string.IsNullOrWhiteSpace(_copyName))">
                @L["Workspace_CopyAction"]
            </FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@* ─── Als Vorlage speichern ──────────────────────────────────────────────── *@
@if (_templateOpen)
{
    <FluentDialog id="workspace-template-dlg" Open="true" Modal="true" Style="width:min(520px,92vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_SaveAsTemplate"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseTemplateDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            @if (_templateSaved)
            {
                <div class="rounded-2xl border border-green-200 bg-green-50 p-4 text-sm text-green-800 flex items-center gap-2">
                    <span>✓</span>
                    <span>@((MarkupString)string.Format(L["Workspace_TemplateSaved"], $"<strong>{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(_templateName)}</strong>"))</span>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <div class="space-y-1">
                        <div class="text-sm text-slate-600">@L["Workspace_TemplateName"]</div>
                        <input class="w-full rounded-xl border border-slate-200 p-2"
                               @bind="_templateName" />
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-600">
                        @L["Workspace_TemplateHelp"]
                    </div>
                </div>
            }
        </FluentDialogBody>

        <FluentDialogFooter>
            @if (_templateSaved)
            {
                <FluentButton Appearance="Appearance.Accent" OnClick="CloseTemplateDialog">@L["Btn_Close"]</FluentButton>
            }
            else
            {
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseTemplateDialog">@L["Btn_Cancel"]</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="SaveAsTemplateAsync"
                              Disabled="@(_list is null || string.IsNullOrWhiteSpace(_templateName))">
                    @L["Btn_Save"]
                </FluentButton>
            }
        </FluentDialogFooter>
    </FluentDialog>
}

@* ─── Exportieren ────────────────────────────────────────────────────────── *@
@if (_exportOpen)
{
    <FluentDialog id="workspace-export-dlg" Open="true" Modal="true" Style="width:min(480px,92vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3">
                <div class="font-semibold">@L["Workspace_ExportList"]</div>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseExportDialog">✕</FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-2">
                <div class="text-sm text-slate-500 mb-3">
                    <span class="font-medium text-slate-700">@(_list?.Name)</span> –
                    @string.Format(L["Workspace_ExportTaskCount"], (_list?.Tasks?.Count(t => t.DeletedAt == null)) ?? 0)
                </div>

                <button class="w-full flex items-center gap-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 text-left transition-colors"
                        @onclick="ExportJsonAsync">
                    <span class="text-xl">{ }</span>
                    <div>
                        <div class="font-medium text-sm">@L["Workspace_ExportJson"]</div>
                        <div class="text-xs text-slate-500">@L["Workspace_ExportJsonHelp"]</div>
                    </div>
                </button>

                <button class="w-full flex items-center gap-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 text-left transition-colors"
                        @onclick="ExportCsvAsync">
                    <span class="text-xl">≡</span>
                    <div>
                        <div class="font-medium text-sm">@L["Workspace_ExportCsv"]</div>
                        <div class="text-xs text-slate-500">@L["Workspace_ExportCsvHelp"]</div>
                    </div>
                </button>

                <button class="w-full flex items-center gap-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 px-4 py-3 text-left transition-colors"
                        @onclick="ExportPdfAsync">
                    <span class="text-xl">⎙</span>
                    <div>
                        <div class="font-medium text-sm">@L["Workspace_ExportPdf"]</div>
                        <div class="text-xs text-slate-500">@L["Workspace_ExportPdfHelp"]</div>
                    </div>
                </button>
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseExportDialog">@L["Btn_Close"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_emailImportOpen && _list is not null && CanAdminCurrentList())
{
    <FluentDialog id="workspace-email-import-dlg" Open="true" Modal="true" Style="width:min(680px,94vw);" TrapFocus="true" HiddenChanged="@(_ => CloseEmailImportDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-3 w-full">
                <div>
                    <div class="font-semibold">E-Mail-Import</div>
                    <div class="text-sm text-slate-500">@_list.Name</div>
                </div>
                <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" OnClick="CloseEmailImportDialog">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" />
                </FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="space-y-4">
                <div class="rounded-lg border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900">
                    Ungelesene E-Mails aus dem gewählten IMAP-Ordner werden als Aufgaben importiert. Der Betreff wird zur Aufgabenbezeichnung, der E-Mail-Text zur Beschreibung. Importierte E-Mails werden als gelesen markiert und nicht gelöscht. Der automatische Import läuft standardmäßig alle 15 Minuten; der Abstand kann zentral in der appsettings.json geändert werden.
                </div>

                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" class="accent-slate-700" @bind="_emailImportEnabled" />
                    <span>Import für diese Liste aktivieren</span>
                </label>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div class="md:col-span-2 space-y-1">
                        <div class="text-sm text-slate-600">IMAP-Server</div>
                        <input class="w-full rounded-lg border border-slate-200 p-2"
                               placeholder="imap.example.com"
                               @bind="_emailImportHost"
                               @bind:event="oninput" />
                    </div>
                    <div class="space-y-1">
                        <div class="text-sm text-slate-600">Port</div>
                        <input type="number" class="w-full rounded-lg border border-slate-200 p-2"
                               min="1"
                               @bind="_emailImportPort"
                               @bind:event="oninput" />
                    </div>
                </div>

                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" class="accent-slate-700" @bind="_emailImportUseSsl" />
                    <span>SSL/TLS verwenden</span>
                </label>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <div class="text-sm text-slate-600">Benutzername</div>
                        <input class="w-full rounded-lg border border-slate-200 p-2"
                               autocomplete="username"
                               @bind="_emailImportUserName"
                               @bind:event="oninput" />
                    </div>
                    <div class="space-y-1">
                        <div class="text-sm text-slate-600">Passwort</div>
                        <input type="password" class="w-full rounded-lg border border-slate-200 p-2"
                               autocomplete="current-password"
                               placeholder="@(_emailImportHasPassword ? "Gespeichertes Passwort beibehalten" : "")"
                               @bind="_emailImportPassword"
                               @bind:event="oninput" />
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <FluentButton Appearance="Appearance.Neutral" OnClick="TestEmailImportConnectionAsync" Disabled="@(_emailImportBusy || !EmailImportCanTest)">
                        Verbindung testen
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" OnClick="RunEmailImportNowAsync" Disabled="@(_emailImportBusy || !_emailImportHasConfiguration)">
                        Neue E-Mails prüfen
                    </FluentButton>
                    @if (_emailImportBusy)
                    {
                        <span class="text-sm text-slate-500">@_emailImportBusyText</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(_emailImportStatus))
                    {
                        <span class="@(_emailImportTestSucceeded ? "text-sm text-green-700" : "text-sm text-red-700")">@_emailImportStatus</span>
                    }
                </div>

                <div class="space-y-1">
                    <div class="text-sm text-slate-600">Ordner zum Einlesen</div>
                    @if (_emailImportFolders.Count > 0)
                    {
                        <select class="w-full rounded-lg border border-slate-200 p-2 bg-white"
                                @bind="_emailImportFolderName">
                            @foreach (var folder in _emailImportFolders)
                            {
                                <option value="@folder">@folder</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="w-full rounded-lg border border-slate-200 p-2"
                               @bind="_emailImportFolderName" />
                    }
                    <div class="text-xs text-slate-500">Standard ist INBOX. Nach einem erfolgreichen Verbindungstest kannst du aus den gefundenen Ordnern auswählen.</div>
                </div>

                <div class="space-y-1">
                    <div class="text-sm text-slate-600">Zielspalte</div>
                    <select class="w-full rounded-lg border border-slate-200 p-2 bg-white"
                            @bind="_emailImportTargetColumn"
                            disabled="@(EmailImportColumnOptions.Count == 0)">
                        @if (EmailImportColumnOptions.Count == 0)
                        {
                            <option value="Backlog">Backlog</option>
                        }
                        else
                        {
                            @foreach (var column in EmailImportColumnOptions)
                            {
                                <option value="@column">@column</option>
                            }
                        }
                    </select>
                    <div class="text-xs text-slate-500">Neue Aufgaben aus E-Mails werden in diese Spalte eingeordnet.</div>
                </div>

                @if (_emailImportCreatedTasks.Count > 0)
                {
                    <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-950">
                        <div class="font-semibold mb-2">Neu angelegte Aufgaben</div>
                        <div class="divide-y divide-emerald-100 rounded-lg overflow-hidden bg-white/70">
                            @foreach (var task in _emailImportCreatedTasks)
                            {
                                <div class="flex items-center justify-between gap-3 px-3 py-2">
                                    <div class="min-w-0">
                                        <div class="font-medium truncate">@task.Title</div>
                                        <div class="text-xs text-emerald-800">@task.Column</div>
                                    </div>
                                    <div class="text-xs text-emerald-700 shrink-0">@task.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_emailImportLastImportAtUtc is not null || !string.IsNullOrWhiteSpace(_emailImportLastError))
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
                        @if (_emailImportLastImportAtUtc is not null)
                        {
                            <div>Letzter Import: @_emailImportLastImportAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_emailImportLastError))
                        {
                            <div class="text-red-700">Letzter Fehler: @_emailImportLastError</div>
                        }
                    </div>
                }
            </div>
        </FluentDialogBody>

        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="DeleteEmailImportConfigurationAsync" Disabled="@(_emailImportBusy || !_emailImportHasConfiguration)">
                Entfernen
            </FluentButton>
            <div class="flex-1"></div>
            <FluentButton Appearance="Appearance.Stealth" OnClick="CloseEmailImportDialog">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="SaveEmailImportConfigurationAsync" Disabled="@(_emailImportBusy || !EmailImportCanSave)">
                @L["Btn_Save"]
            </FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_notificationSettingsOpen && _list is not null && CanAdminCurrentList())
{
    <FluentDialog id="workspace-notifications-dlg"
                  Class="notifications-dialog"
                  Open="true"
                  Modal="true"
                  Style="--dialog-width:min(1040px, calc(100vw - 32px)); --dialog-height:min(920px, calc(100dvh - 32px));"
                  TrapFocus="true"
                  HiddenChanged="@(_ => CloseNotificationSettingsDialog())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between gap-4 w-full px-1">
                <div class="min-w-0">
                    <div class="text-lg font-semibold text-slate-900">@L["Workspace_Notifications"]</div>
                    <div class="text-sm text-slate-500 truncate">@_list.Name</div>
                </div>
                <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Close"]" OnClick="CloseNotificationSettingsDialog">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" />
                </FluentButton>
            </div>
        </FluentDialogHeader>

        <FluentDialogBody>
            <div class="notifications-modal-scroll">
            <div class="notifications-modal-content">
                <div class="notifications-table-wrap rounded-lg border border-slate-200 bg-white">
                    <table class="w-full text-sm" style="min-width:860px; table-layout:fixed;">
                        <colgroup>
                            <col style="width:230px;" />
                            <col style="width:90px;" />
                            <col style="width:100px;" />
                            <col style="width:125px;" />
                            <col style="width:125px;" />
                            <col style="width:110px;" />
                            <col style="width:80px;" />
                        </colgroup>
                        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                            <tr>
                                <th class="sticky top-0 z-10 bg-slate-50 px-3 py-2.5 text-left font-semibold">@L["Notifications_Event"]</th>
                                <th class="sticky top-0 z-10 bg-slate-50 px-2 py-2.5 text-center font-semibold">@L["Notifications_Admins"]</th>
                                <th class="sticky top-0 z-10 bg-slate-50 px-2 py-2.5 text-center font-semibold">@L["Notifications_Users"]</th>
                                <th class="sticky top-0 z-10 bg-slate-50 px-2 py-2.5 text-center font-semibold">@L["Notifications_BoardWatchersShort"]</th>
