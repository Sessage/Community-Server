    private async Task CopyListAsync()
    {
        if (_list is null) return;

        var name = (_copyName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        // Label-ID-Mapping: alt -> neu
        var labelIdMap = new Dictionary<Guid, Guid>();
        var newLabels = (_list.Labels ?? new()).Select(l =>
        {
            var newId = Guid.NewGuid();
            labelIdMap[l.Id] = newId;
            return new TodoLabelEntity { Id = newId, Title = l.Title, BackgroundColor = l.BackgroundColor };
        }).ToList();

        var newTasks = new List<TodoTaskEntity>();
        var customFieldIdMap = new Dictionary<Guid, Guid>();
        List<TodoCustomFieldDefinitionEntity> newCustomFields = ProductFeatures.IsEnabled(ProductFeatureIds.Forms)
            ? (_list.CustomFields ?? new()).OrderBy(f => f.SortOrder).Select((f, index) =>
        {
            var newFieldId = Guid.NewGuid();
            customFieldIdMap[f.Id] = newFieldId;
            return new TodoCustomFieldDefinitionEntity
            {
                Id = newFieldId,
                Name = f.Name,
                Type = f.Type,
                IsRequired = f.IsRequired,
                SortOrder = index,
                Options = (f.Options ?? new()).OrderBy(o => o.SortOrder).Select((o, optionIndex) => new TodoCustomFieldOptionEntity
                {
                    Id = Guid.NewGuid(),
                    Value = o.Value,
                    SortOrder = optionIndex
                }).ToList()
            };
        }).ToList() : [];

        if (_copyIncludeTasks)
        {
            foreach (var t in (_list.Tasks ?? new()).Where(t => t.DeletedAt == null))
            {
                var newTaskId = Guid.NewGuid();
                newTasks.Add(new TodoTaskEntity
                {
                    Id = newTaskId,
                    Title = t.Title,
                    Description = t.Description,
                    Column = t.Column,
                    Done = t.Done,
                    IsImportant = t.IsImportant,
                    DueDate = t.DueDate,
                    StartDate = t.StartDate,
                    Recurrence = t.Recurrence,
                    CustomRecurrence = t.CustomRecurrence,
                    CardColor = t.CardColor,
                    CardColorMode = t.CardColorMode,
                    CustomFieldValues = (t.CustomFieldValues ?? new())
                        .Where(v => customFieldIdMap.ContainsKey(v.FieldId))
                        .Select(v => new TodoTaskCustomFieldValueEntity { Id = Guid.NewGuid(), TaskId = newTaskId, FieldId = customFieldIdMap[v.FieldId], Value = v.Value })
                        .ToList(),
                    LabelLinks = (t.LabelLinks ?? new())
                        .Where(ll => labelIdMap.ContainsKey(ll.LabelId))
                        .Select(ll => new TodoTaskLabelEntity { TaskId = newTaskId, LabelId = labelIdMap[ll.LabelId] })
                        .ToList()
                });
            }
        }

        var newList = new TodoListEntity
        {
            Name = name,
            Columns = new List<string>(_list.Columns ?? new()),
            DoneColumns = new List<string>(_list.DoneColumns ?? new()),
            DefaultView = _list.DefaultView,
            BackgroundColor = _list.BackgroundColor,
            Labels = newLabels,
            CustomFields = newCustomFields,
            Tasks = newTasks
        };

        try
        {
            var created = await ListService.AddListAsync(_userId, newList);
            _copyOpen = false;
            await ReloadAsync();
            Nav.NavigateTo($"/list/{created.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Liste konnte nicht kopiert werden. Details: {ex.Message}";
            _copyOpen = false;
        }
    }
    /* Ende Liste kopieren */

    /* ─── Als Vorlage speichern ──────────────────────────────────────────── */
    private bool _templateOpen;
    private bool _templateSaved;
    private string _templateName = "";

    private void OpenTemplateDialog()
    {
        CloseOverlays();
        _templateName = _list?.Name ?? "";
        _templateSaved = false;
        _templateOpen = true;
    }

    private void CloseTemplateDialog()
    {
        _templateOpen = false;
        _templateSaved = false;
    }

    private async Task SaveAsTemplateAsync()
    {
        if (_list is null) return;

        var name = (_templateName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        var newLabels = (_list.Labels ?? new()).Select(l => new TodoLabelEntity
        {
            Id = Guid.NewGuid(),
            Title = l.Title,
            BackgroundColor = l.BackgroundColor
        }).ToList();

        List<TodoCustomFieldDefinitionEntity> newCustomFields = ProductFeatures.IsEnabled(ProductFeatureIds.Forms)
            ? (_list.CustomFields ?? new()).OrderBy(f => f.SortOrder).Select((f, index) => new TodoCustomFieldDefinitionEntity
        {
            Id = Guid.NewGuid(),
            Name = f.Name,
            Type = f.Type,
            IsRequired = f.IsRequired,
            SortOrder = index,
            Options = (f.Options ?? new()).OrderBy(o => o.SortOrder).Select((o, optionIndex) => new TodoCustomFieldOptionEntity
            {
                Id = Guid.NewGuid(),
                Value = o.Value,
                SortOrder = optionIndex
            }).ToList()
        }).ToList() : [];

        var template = new TodoListEntity
        {
            Name = name,
            Columns = new List<string>(_list.Columns ?? new()),
            DoneColumns = new List<string>(_list.DoneColumns ?? new()),
            DefaultView = _list.DefaultView,
            BackgroundColor = _list.BackgroundColor,
            Labels = newLabels,
            CustomFields = newCustomFields,
            IsTemplate = true
        };

        try
        {
            await ListService.AddListAsync(_userId, template);
            _templateSaved = true;
        }
        catch (Exception ex)
        {
            _error = $"Vorlage konnte nicht gespeichert werden. Details: {ex.Message}";
            _templateOpen = false;
        }
    }
    /* Ende Vorlage */

    /* ─── Exportieren ────────────────────────────────────────────────────── */
    private bool _exportOpen;

    private void OpenExportDialog()
    {
        CloseOverlays();
        _exportOpen = true;
    }

    private void CloseExportDialog() => _exportOpen = false;

    private async Task ExportJsonAsync()
    {
        if (_list is null) return;

        var tasks = (_list.Tasks ?? new()).Where(t => t.DeletedAt == null).Select(t => new
        {
            titel = t.Title,
            beschreibung = t.Description,
            spalte = t.Column,
            erledigt = t.Done,
            wichtig = t.IsImportant,
            faelligkeitsdatum = t.DueDate?.ToString("yyyy-MM-dd"),
            erstellt = t.CreatedAtUtc.ToString("yyyy-MM-dd"),
            labels = (t.LabelLinks ?? new()).Select(ll => ll.Label?.Title ?? "").Where(s => s.Length > 0).ToList()
        });

        var export = new
        {
            liste = _list.Name,
            exportiert_am = DateTime.Now.ToString("yyyy-MM-dd HH:mm"),
            spalten = _list.Columns,
            labels = (_list.Labels ?? new()).Select(l => new { l.Title, l.BackgroundColor }),
            aufgaben = tasks
        };

        var json = System.Text.Json.JsonSerializer.Serialize(export,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });

        var filename = $"{SanitizeFilename(_list.Name)}_{DateTime.Now:yyyy-MM-dd}.json";
        await JS.InvokeVoidAsync("todoUi.downloadFile", filename, json, "application/json");
    }

    private async Task ExportCsvAsync()
    {
        if (_list is null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", new[]
        {
            CsvEscape(L["Export_Header_Title"]),
            CsvEscape(L["Export_Header_Description"]),
            CsvEscape(L["Export_Header_Column"]),
            CsvEscape(L["Export_Header_Done"]),
            CsvEscape(L["Export_Header_Important"]),
            CsvEscape(L["Export_Header_DueDate"]),
            CsvEscape(L["Export_Header_Labels"])
        }));

        foreach (var t in (_list.Tasks ?? new()).Where(t => t.DeletedAt == null))
        {
            var labels = string.Join("|", (t.LabelLinks ?? new()).Select(ll => ll.Label?.Title ?? "").Where(s => s.Length > 0));
            sb.AppendLine(string.Join(",", new[]
            {
                CsvEscape(t.Title),
                CsvEscape(t.Description ?? ""),
                CsvEscape(t.Column),
                t.Done ? L["Common_Yes"] : L["Common_No"],
                t.IsImportant ? L["Common_Yes"] : L["Common_No"],
                t.DueDate?.ToString("dd.MM.yyyy") ?? "",
                CsvEscape(labels)
            }));
        }

        var filename = $"{SanitizeFilename(_list.Name)}_{DateTime.Now:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("todoUi.downloadFile", filename, "\uFEFF" + sb.ToString(), "text/csv;charset=utf-8");
    }

    private async Task ExportPdfAsync()
    {
        if (_list is null) return;

        var tasks = (_list.Tasks ?? new()).Where(t => t.DeletedAt == null).ToList();

        var rows = new System.Text.StringBuilder();
        foreach (var t in tasks)
        {
            var cls = t.Done ? " style=\"text-decoration:line-through;color:#64748b\"" : "";
            rows.Append($"<tr><td{cls}>{HtmlEncode(t.Title)}</td>" +
                        $"<td>{HtmlEncode(t.Column)}</td>" +
                        $"<td>{(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd.MM.yyyy") : "–")}</td>" +
                        $"<td>{(t.IsImportant ? "★" : "")}</td></tr>");
        }

        var mediaPrintCss = "@media print{body{padding:0}}";
        var exportedAt = string.Format(L["Workspace_ExportedAt"], DateTime.Now.ToString("dd.MM.yyyy HH:mm"), tasks.Count);
        var html = $$"""
            <!DOCTYPE html>
            <html><head>
            <meta charset="utf-8"/>
            <title>{{HtmlEncode(_list.Name)}}</title>
            <style>
              body{font-family:Arial,sans-serif;padding:24px;color:#1e293b}
              h1{font-size:18px;margin-bottom:4px}
              .meta{font-size:11px;color:#64748b;margin-bottom:16px}
              table{border-collapse:collapse;width:100%;font-size:12px}
              th{background:#f1f5f9;text-align:left;padding:6px 8px;border:1px solid #e2e8f0}
              td{padding:5px 8px;border:1px solid #e2e8f0;vertical-align:top}
              {{mediaPrintCss}}
            </style>
            </head><body>
            <h1>{{HtmlEncode(_list.Name)}}</h1>
            <div class="meta">{{HtmlEncode(exportedAt)}}</div>
            <table>
              <thead><tr>
                <th>{{HtmlEncode(L["Export_Header_Title"])}}</th><th>{{HtmlEncode(L["Export_Header_Column"])}}</th><th>{{HtmlEncode(L["Export_Header_DueDate"])}}</th><th>{{HtmlEncode(L["Export_Header_Important"])}}</th>
              </tr></thead>
              <tbody>{{rows}}</tbody>
            </table>
            </body></html>
            """;

        await JS.InvokeVoidAsync("todoUi.printContent", html);
    }

    private static string CsvEscape(string? value)
    {
        if (value is null) return "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return $"\"{value.Replace("\"", "\"\"")}\"";
        return value;
    }

    private static string HtmlEncode(string? value)
        => System.Net.WebUtility.HtmlEncode(value ?? "");

    private static string SanitizeFilename(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "liste";
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        return new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray()).Trim();
    }
    /* Ende Exportieren */
