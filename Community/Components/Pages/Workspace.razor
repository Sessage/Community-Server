            var id =
                user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? user.FindFirstValue("sub"); // ✅ fallback für OIDC

            _userId = string.IsNullOrWhiteSpace(id) ? "gast" : id;
        }
