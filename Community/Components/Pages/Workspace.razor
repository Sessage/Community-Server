    private IReadOnlyList<TodoCalendarItem> GetCalendarItemsForCurrentList()
    {
        if (_list is null)
        {
            return [];
        }

        return (_list.Tasks ?? [])
            .Where(task => task.StartDate.HasValue && task.DueDate.HasValue)
            .Where(PassesCalendarFilter)
            .Select(task =>
            {
                var startDate = task.StartDate!.Value.Date;
                var dueDate = task.DueDate!.Value.Date;
                var endDate = dueDate >= startDate ? dueDate.AddDays(1) : startDate.AddDays(1);

                return new TodoCalendarItem
                {
                    TaskId = task.Id,
                    ListId = _list.Id,
                    Title = task.Title,
                    Start = startDate,
                    End = endDate,
                    CardColor = task.CardColor,
                    CardColorMode = task.CardColorMode,
                    AssigneeUserId = string.IsNullOrWhiteSpace(task.Assignee) ? null : task.Assignee.Trim(),
                    AssigneeDisplayName = GetCalendarAssigneeDisplayName(task.Assignee),
                    AssigneeInitials = GetCalendarAssigneeInitials(task.Assignee),
                    AssigneeAvatarColor = GetCalendarAssigneeAvatarColor(task.Assignee),
                    AssigneeProfilePictureUrl = GetCalendarAssigneeProfilePictureUrl(task.Assignee)
                };
            })
            .ToList();
    }

    private string? GetCalendarAssigneeDisplayName(string? userId)
    {
        var participant = FindCalendarParticipant(userId);
        return participant is not null && !string.IsNullOrWhiteSpace(participant.DisplayName)
            ? participant.DisplayName
            : string.IsNullOrWhiteSpace(userId) ? null : userId.Trim();
    }

    private string? GetCalendarAssigneeInitials(string? userId)
    {
        var displayName = GetCalendarAssigneeDisplayName(userId);
        if (string.IsNullOrWhiteSpace(displayName))
            return null;

        var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();

        return parts.Length == 1 && parts[0].Length > 0
            ? parts[0][0].ToString().ToUpperInvariant()
            : "?";
    }

    private ListParticipantEntity? FindCalendarParticipant(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId) || _list?.Participants is null)
            return null;

        var uid = userId.Trim();
        return _list.Participants.FirstOrDefault(p =>
            (!string.IsNullOrWhiteSpace(p.UserId) && string.Equals(p.UserId.Trim(), uid, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(p.Email) && string.Equals(p.Email.Trim(), uid, StringComparison.OrdinalIgnoreCase)));
    }

    private static string? GetCalendarAssigneeAvatarColor(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
            return null;

        var colors = new[] { "#0079bf", "#d29034", "#519839", "#b04632", "#89609e", "#cd5a91", "#4bbf6b", "#00aecc", "#838c91" };
        var hash = 0;
        foreach (var c in userId.Trim())
            hash = unchecked(hash * 31 + c);
        return colors[Math.Abs(hash) % colors.Length];
    }

    private static string? GetCalendarAssigneeProfilePictureUrl(string? userId)
        => string.IsNullOrWhiteSpace(userId)
            ? null
            : $"/api/profile-picture/{Uri.EscapeDataString(userId.Trim())}";

    private bool PassesCalendarFilter(TodoTaskEntity task)
    {
        var now = DateTime.UtcNow;
        var query = (_filter.Query ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(query)
            && !($"{task.Title} {task.Description} {task.Column}".Contains(query, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        if (_filter.Done is not null && task.Done != _filter.Done.Value) return false;
        if (_filter.NoDueDate && task.DueDate is not null) return false;
        if (_filter.Overdue && (task.DueDate is null || task.DueDate >= now)) return false;
        if (_filter.DueNextDay && (task.DueDate is null || task.DueDate > now.AddDays(1) || task.DueDate < now)) return false;
        if (_filter.DueNextWeek && (task.DueDate is null || task.DueDate > now.AddDays(7) || task.DueDate < now)) return false;
        if (_filter.DueNextMonth && (task.DueDate is null || task.DueDate > now.AddDays(30) || task.DueDate < now)) return false;
        if (_filter.NoMembers && (task.MemberUserIds?.Count ?? 0) > 0) return false;
        if (_filter.AssignedToMe && !(task.MemberUserIds?.Contains(_userId) ?? false)) return false;
        if (_filter.NoAssignee && (!string.IsNullOrWhiteSpace(task.Assignee) || (task.MemberUserIds?.Count ?? 0) > 0)) return false;
        if (_filter.MemberUserIds.Count > 0 && !(task.MemberUserIds ?? []).Any(memberId => _filter.MemberUserIds.Contains(memberId))) return false;
        if (_filter.LabelIds.Count > 0 && !(task.LabelLinks ?? []).Any(link => _filter.LabelIds.Contains(link.LabelId))) return false;

        return true;
    }

