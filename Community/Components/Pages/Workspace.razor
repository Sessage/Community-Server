    private bool IsWatchingList =>
        _list?.Watchers?.Any(w => string.Equals(w.UserId, _userId, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task ToggleListWatchingAsync()
    {
        if (_list is null) return;
        var watch = !IsWatchingList;
        if (await ListService.SetListWatchingAsync(_userId, _list.Id, watch))
            await ReloadAsyncForce();
