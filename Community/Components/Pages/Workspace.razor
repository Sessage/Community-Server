    private async Task RefreshNotificationsAsync()
    {
        _unreadNotifications = await NotificationService.GetUnreadCountAsync(_userId);
        if (_notificationsOpen)
            _latestNotifications = (await NotificationService.GetLatestAsync(_userId)).ToList();
    }

    private async Task ToggleNotificationsPanelAsync()
    {
        _notificationsOpen = !_notificationsOpen;
        if (_notificationsOpen)
            await RefreshNotificationsAsync();
    }

    private void CloseNotificationsPanel()
        => _notificationsOpen = false;

    private async Task MarkNotificationsReadAsync()
    {
        await NotificationService.MarkAllReadAsync(_userId);
        _unreadNotifications = 0;
        _latestNotifications = (await NotificationService.GetLatestAsync(_userId)).ToList();
    }

    private async Task DeleteNotificationAsync(Guid notificationId)
    {
        await NotificationService.DeleteNotificationAsync(_userId, notificationId);
        _latestNotifications.RemoveAll(n => n.Id == notificationId);
        _unreadNotifications = await NotificationService.GetUnreadCountAsync(_userId);
    }

    private async Task DeleteAllNotificationsAsync()
    {
        await NotificationService.DeleteAllNotificationsAsync(_userId);
        _latestNotifications.Clear();
        _unreadNotifications = 0;
