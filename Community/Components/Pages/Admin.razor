@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@* Community administration UI. The controller/service layer rechecks administrator authorization for every mutation. *@
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Klassenbibliothek.Data
@using Klassenbibliothek.Features
@using Klassenbibliothek.Administration
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IProductFeatureCatalog FeatureCatalog
@inject IAuditEventSink Audit
@inject UserAccountArtifactCleanupService AccountArtifactCleanup
@inject ILogger<Admin> Logger

<PageTitle>@L["App_SystemAdministration"] – Sessage</PageTitle>

<div class="h-full min-h-0 overflow-y-auto">
<div class="admin-page space-y-6 max-w-5xl mx-auto p-4 sm:p-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-indigo-500 mb-1">@SharedText.Get("App_SystemAdministration")</p>
            <h1 class="text-2xl font-bold text-slate-900">@SharedText.Get("Page_Admin_Title")</h1>
        </div>
    </div>

    <!-- Lizenzübersicht -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="Lizenzstatus">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex items-center justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">@SharedText.Get("App_License")</p>
                <p class="text-lg font-semibold text-slate-900">@LicenseEdition</p>
                <p class="text-xs text-slate-500 mt-1">@LicenseStatusDescription</p>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-semibold @LicenseBadgeCss">@LicenseEdition</span>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">@SharedText.Get("App_Expireson")</p>
            <p class="text-lg font-semibold text-slate-900">@LicenseExpiryText</p>
            <p class="text-xs text-slate-500 mt-1">@LicenseExpiryDescription</p>
        </div>
    </div>

    @if (Services.GetService<IEnterpriseOperationsDiagnostics>() is { } diagnostics)
    {
        <EnterpriseDiagnosticsPanel Snapshot="new EnterpriseDiagnosticsSnapshot(diagnostics.GetOperations(), diagnostics.GetPush())"
                                    OnRefresh="() => StateHasChanged()" />
    }

    <!-- Benutzer anlegen / bearbeiten -->
    <div class="grid grid-cols-1 gap-4">

        <!-- Benutzer anlegen / bearbeiten -->
        <div id="admin-user-form" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4 scroll-mt-4">
            <div class="flex items-center gap-3 mb-1">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 text-base">
                    @(_editingUserId == null ? "+" : "✎")
                </div>
                <h2 class="text-base font-semibold text-slate-800">
                    @(_editingUserId == null ? SharedText.Get("App_Createuser") : SharedText.Get("App_Edituser"))
                </h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div role="status" aria-live="polite"
                     class="rounded-xl px-4 py-3 text-sm font-medium @(_messageIsError ? "bg-red-50 border border-red-200 text-red-700" : "bg-blue-50 border border-blue-200 text-blue-700")">
                    @_message
                </div>
            }
            <EditForm Model="@_form" OnValidSubmit="SaveUserAsync" autocomplete="off">
                <DataAnnotationsValidator />
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">@SharedText.Get("App_DisplayName")</label>
                        <FluentTextField @bind-Value="_form.DisplayName" Placeholder="@SharedText.Get("App_Fullname")" Class="admin-text-field w-full" />
                        <ValidationMessage For="@(() => _form.DisplayName)" class="text-xs text-red-600 mt-0.5" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">@SharedText.Get("Account_EmailAddress")</label>
                        <FluentTextField @bind-Value="_form.Email" Placeholder="benutzer@beispiel.de" Class="admin-text-field w-full"
                                         autocomplete="off"
                                         ReadOnly="@(_editingUserId != null)" />
                        <ValidationMessage For="@(() => _form.Email)" class="text-xs text-red-600 mt-0.5" />
                    </div>
                    @if (_editingUserId == null)
                    {
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">@SharedText.Get("Login_Password")</label>
                            <FluentTextField @bind-Value="_form.Password" Placeholder="Mindestens 6 Zeichen"
                                             TextFieldType="TextFieldType.Password" autocomplete="new-password"
                                             Class="admin-text-field w-full" />
                            <ValidationMessage For="@(() => _form.Password)" class="text-xs text-red-600 mt-0.5" />
                            <p class="text-xs text-slate-500 mt-1">@SharedText.Get("App_Useuppercaseandlowercaselettersanumberandasymbol")</p>
                        </div>
                    }
                    <FluentSwitch @bind-Checked="_form.IsAdmin" Disabled="@IsEditingCurrentUser">@SharedText.Get("App_Administrator")</FluentSwitch>
                    @if (IsEditingCurrentUser)
                    {
                        <p class="mt-1 text-xs text-slate-500">@SharedText.Get("App_Youcannotremoveyourownadministratorrolehere")</p>
                    }
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    @if (_editingUserId != null)
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="() => ResetForm()">@SharedText.Get("Btn_Cancel")</FluentButton>
                    }
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@_saving">
                        @if (_saving)
                        {
                            <FluentProgressRing Style="width:14px;height:14px;margin-right:6px;" />
                        }
                        @(_editingUserId == null ? "Anlegen" : SharedText.Get("Btn_Save"))
                    </FluentButton>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Benutzerliste -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex flex-col items-stretch gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500 text-base">👥</div>
                <h2 class="text-base font-semibold text-slate-800">@SharedText.Get("App_Users")</h2>
                <span class="rounded-full bg-indigo-100 text-indigo-700 text-xs font-semibold px-2.5 py-0.5">@_users.Count</span>
            </div>
            <div class="flex flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
                <FluentTextField @bind-Value="_searchTerm" Placeholder="@SharedText.Get("App_Searchnameoremail")" Class="admin-text-field w-full" Style="width:100%;min-width:0;"
                                 @oninput="OnSearchInput" />
                <a href="#admin-user-form"
                   @onclick="() => ResetForm()"
                   class="inline-flex min-h-8 shrink-0 items-center justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    + @L["App_Createuser"]
                </a>
            </div>
        </div>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-12 gap-3 text-slate-400">
                <FluentProgressRing Style="width:20px;height:20px;" />
                <span class="text-sm">@SharedText.Get("App_Loadingusers")</span>
            </div>
        }
        else if (_users.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-12 text-slate-400 gap-2">
                <span class="text-3xl">🔍</span>
                <span class="text-sm">@SharedText.Get("App_Nousersfound")</span>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var user in _users)
                {
                    <div class="flex flex-col items-stretch gap-3 px-4 py-3.5 transition-colors hover:bg-slate-50 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-semibold text-sm shrink-0">
                                @UserInitial(user.Email ?? user.UserName ?? "?")
                            </div>
                            <div class="min-w-0">
                                <div class="font-medium text-slate-800 truncate">@(user.DisplayName ?? user.UserName ?? user.Email)</div>
                                <div class="text-xs text-slate-500 truncate">@user.Email</div>
                            </div>
                            @if (user.IsAdmin)
                            {
                                <span class="shrink-0 rounded-full bg-amber-100 text-amber-700 text-[11px] font-semibold px-2 py-0.5 uppercase tracking-wide">
                                    @SharedText.Get("Participants_RoleAdmin")
                                </span>
                            }
                        </div>
                        <div class="flex shrink-0 justify-end gap-2 sm:ml-3">
                            <FluentButton Appearance="Appearance.Outline" OnClick="() => StartEdit(user)"
                                          Title="@SharedText.Get("Btn_Edit")">
                                @SharedText.Get("Btn_Edit")
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline"
                                          Style="border-color: #fca5a5; color: #dc2626;"
                                          Disabled="@IsCurrentUser(user)"
                                          OnClick="() => ConfirmDelete(user)"
                                          Title="@(IsCurrentUser(user) ? SharedText.Get("App_OwnAccountDeleteDenied") : SharedText.Get("Btn_Delete"))">
                                @SharedText.Get("Btn_Delete")
                            </FluentButton>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
</div>

<!-- Lösch-Bestätigungsdialog -->
@if (_deleteTarget != null)
{
    <FluentDialog Open="true" Modal="true" Style="width:min(440px,92vw);" TrapFocus="true">
        <FluentDialogHeader>
            <div class="font-semibold text-red-700">@SharedText.Get("App_Deleteuser")</div>
        </FluentDialogHeader>
        <FluentDialogBody>
            <p class="text-sm text-slate-700">
                @L["App_DeleteUserConfirm", _deleteTarget.Email ?? ""]
            </p>
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="() => _deleteTarget = null">@SharedText.Get("Btn_Cancel")</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Style="background:#dc2626;" Disabled="@_saving" OnClick="ExecuteDeleteAsync">
                @SharedText.Get("Btn_Delete")
            </FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private string _message = string.Empty;
    private bool _messageIsError;
    private string _currentUserId = string.Empty;
    private List<UserViewModel> _allUsers = new();
    private List<UserViewModel> _users = new();
    private string? _editingUserId;
    private UserViewModel? _deleteTarget;
    private ProductCapabilitiesDocument _capabilities = new(
        ProductEdition.Community,
        [],
        new Dictionary<string, long>(),
        "community");

    private UserFormModel _form = new();

    private class UserViewModel
    {
        public string Id { get; init; } = string.Empty;
        public string? UserName { get; init; }
        public string? Email { get; init; }
        public string? DisplayName { get; init; }
        public bool IsAdmin { get; init; }
    }

    private class UserFormModel
    {
        [LocalizedRequired("App_Nameisrequired")]
        [LocalizedMaxLength(200, "App_Namemustnotexceed200characters")]
        public string DisplayName { get; set; } = string.Empty;

        [LocalizedRequired("App_Emailisrequired")]
        [LocalizedEmailAddress("App_Invalidemailaddress")]
        public string Email { get; set; } = string.Empty;

        [LocalizedMinLength(6, "App_Passwordmusthaveatleast6characters")]
        public string Password { get; set; } = string.Empty;

        public bool IsAdmin { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _capabilities = FeatureCatalog.GetCapabilities();
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadUsersAsync();
    }

    private static string DiagnosticTime(DateTimeOffset? value)
        => value?.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture) ?? "—";

    private async Task LoadUsersAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var allUsers = await UserManager.Users.AsNoTracking().ToListAsync();
            var result = new List<UserViewModel>();

            foreach (var u in allUsers)
            {
                var isAdmin = await UserManager.IsInRoleAsync(u, "Admin");
                result.Add(new UserViewModel
                {
                    Id = u.Id, UserName = u.UserName, Email = u.Email,
                    DisplayName = u.DisplayName, IsAdmin = isAdmin
                });
            }

            _allUsers = result.OrderBy(u => u.Email, StringComparer.OrdinalIgnoreCase).ToList();
            ApplySearchFilter();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, SharedText.Get("App_Couldnotloadusers"));
            ShowMessage(SharedText.Get("App_Couldnotloadtheuserlist"), true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplySearchFilter();
    }

    private void ApplySearchFilter()
    {
        var search = _searchTerm.Trim();
        _users = string.IsNullOrWhiteSpace(search)
            ? _allUsers.ToList()
            : _allUsers.Where(user =>
                    user.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                    || user.UserName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
                    || user.DisplayName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true)
                .ToList();
    }

    private async Task SaveUserAsync()
    {
        if (_saving) return;

        _saving = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            if (_editingUserId == null)
            {
                // Neuen Benutzer anlegen
                if (string.IsNullOrWhiteSpace(_form.Password))
                {
                    ShowMessage(SharedText.Get("App_Enterapassword"), isError: true);
                    return;
                }

                var normalizedEmail = _form.Email.Trim();
                var existing = await UserManager.FindByEmailAsync(normalizedEmail);
                if (existing != null)
                {
                    ShowMessage(SharedText.Get("Err_Admin_UserAlreadyExists"), isError: true);
                    return;
                }

                var newUser = new ApplicationUser
                {
                    UserName = normalizedEmail,
                    Email = normalizedEmail,
                    DisplayName = _form.DisplayName.Trim(),
                    EmailConfirmed = true
                };

                var createResult = await UserManager.CreateAsync(newUser, _form.Password);
                if (!createResult.Succeeded)
                {
                    ShowMessage(string.Join(" ", createResult.Errors.Select(e => e.Description)), isError: true);
                    return;
                }

                if (_form.IsAdmin)
                {
                    var roleResult = await UserManager.AddToRoleAsync(newUser, "Admin");
                    if (!roleResult.Succeeded)
                    {
                        await UserManager.DeleteAsync(newUser);
                        ShowMessage(IdentityErrors(roleResult), isError: true);
                        return;
                    }
                }

                await TryRecordAuditAsync("user-created", $"userId={newUser.Id}; isAdmin={_form.IsAdmin}");
                ShowMessage($"Benutzer {_form.Email} wurde angelegt.", isError: false);
            }
            else
            {
                // Bestehenden Benutzer bearbeiten
                var user = await UserManager.FindByIdAsync(_editingUserId);
                if (user == null)
                {
                    ShowMessage(SharedText.Get("App_Usernotfound"), isError: true);
                    return;
                }

                user.DisplayName = _form.DisplayName.Trim();
                var updateResult = await UserManager.UpdateAsync(user);
                if (!updateResult.Succeeded)
                {
                    ShowMessage(IdentityErrors(updateResult), isError: true);
                    return;
                }

                var isCurrentlyAdmin = await UserManager.IsInRoleAsync(user, "Admin");
                if (!_form.IsAdmin && isCurrentlyAdmin && IsCurrentUser(user.Id))
                {
                    ShowMessage(SharedText.Get("Err_Admin_CannotRemoveOwnAdminRole"), isError: true);
                    return;
                }

                if (_form.IsAdmin && !isCurrentlyAdmin)
                {
                    var roleResult = await UserManager.AddToRoleAsync(user, "Admin");
                    if (!roleResult.Succeeded)
                    {
                        ShowMessage(IdentityErrors(roleResult), isError: true);
                        return;
                    }
                }
                else if (!_form.IsAdmin && isCurrentlyAdmin)
                {
                    var roleResult = await UserManager.RemoveFromRoleAsync(user, "Admin");
                    if (!roleResult.Succeeded)
                    {
                        ShowMessage(IdentityErrors(roleResult), isError: true);
                        return;
                    }
                }

                await TryRecordAuditAsync("user-updated", $"userId={user.Id}; isAdmin={_form.IsAdmin}");
                ShowMessage($"Benutzer {user.Email} wurde aktualisiert.", isError: false);
            }

            ResetForm(clearMessage: false);
            await LoadUsersAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, SharedText.Get("App_Usermanagementcouldnotcompletetheaction"));
            ShowMessage(SharedText.Get("App_CouldnotcompletetheuseractionTryagain"), isError: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEdit(UserViewModel user)
    {
        _editingUserId = user.Id;
        _form = new UserFormModel
        {
            Email = user.Email ?? string.Empty,
            DisplayName = user.DisplayName ?? user.UserName ?? user.Email ?? string.Empty,
            IsAdmin = user.IsAdmin,
            Password = string.Empty
        };
        _message = string.Empty;
    }

    private void ResetForm(bool clearMessage = true)
    {
        _editingUserId = null;
        _form = new UserFormModel();
        if (clearMessage)
            _message = string.Empty;
    }

    private void ConfirmDelete(UserViewModel user)
    {
        if (IsCurrentUser(user))
        {
            ShowMessage(SharedText.Get("App_Youcannotdeleteyourownaccountinadministration"), true);
            return;
        }

        _deleteTarget = user;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget == null || _saving) return;

        var target = _deleteTarget;
        if (IsCurrentUser(target))
        {
            _deleteTarget = null;
            ShowMessage(SharedText.Get("App_Youcannotdeleteyourownaccountinadministration"), true);
            return;
        }

        _saving = true;
        try
        {
            var user = await UserManager.FindByIdAsync(target.Id);
            if (user != null)
            {
                var profilePicturePath = user.ProfilePicturePath;
                var result = await UserManager.DeleteAsync(user);
                if (result.Succeeded)
                {
                    await AccountArtifactCleanup.CleanupAfterUserDeletionAsync(user.Id, profilePicturePath, CancellationToken.None);
                    await TryRecordAuditAsync("user-deleted", $"userId={user.Id}");
                    ShowMessage(SharedText.Get("App_UserDeletedMessage", target.Email ?? ""), isError: false);
                }
                else
                    ShowMessage(IdentityErrors(result), isError: true);
            }
            _deleteTarget = null;
            await LoadUsersAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Benutzer {UserId} konnte nicht gelöscht werden.", target.Id);
            ShowMessage(SharedText.Get("App_Couldnotdeletetheuser"), true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowMessage(string msg, bool isError)
    {
        _message = msg;
        _messageIsError = isError;
    }

    private static string UserInitial(string email)
        => email.Length > 0 ? email[0].ToString().ToUpperInvariant() : "?";

    private bool IsEditingCurrentUser => _editingUserId is not null && IsCurrentUser(_editingUserId);
    private bool IsCurrentUser(UserViewModel user) => IsCurrentUser(user.Id);
    private bool IsCurrentUser(string userId)
        => !string.IsNullOrWhiteSpace(_currentUserId)
           && string.Equals(userId, _currentUserId, StringComparison.Ordinal);

    private async Task TryRecordAuditAsync(string action, string details)
    {
        try
        {
            await Audit.RecordAsync("users", action, _currentUserId, details, CancellationToken.None);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Audit-Eintrag {AuditAction} konnte nicht gespeichert werden.", action);
        }
    }

    private bool HasEnterpriseLicense =>
        _capabilities.Edition == ProductEdition.Enterprise
        && _capabilities.LicenseStatus is "valid" or "development";

    private string LicenseEdition => HasEnterpriseLicense ? "Enterprise" : "Community";
    private string LicenseBadgeCss => HasEnterpriseLicense
        ? "bg-indigo-100 text-indigo-700"
        : "bg-slate-100 text-slate-700";
    private string LicenseStatusDescription => _capabilities.LicenseStatus switch
    {
        "valid" => SharedText.Get("App_Licenseisvalid"),
        "development" => "Entwicklungslizenz",
        "expired" => SharedText.Get("App_Enterpriselicenseexpired"),
        "community" => "Community-Edition",
        "license-missing" => SharedText.Get("App_NoEnterpriselicenseinstalled"),
        "public-key-missing" => SharedText.Get("App_Publiclicensekeymissing"),
        "installation-mismatch" => SharedText.Get("App_Licensebelongstoanotherinstallation"),
        "public-key-mismatch" => SharedText.Get("App_Publickeydoesnotbelongtothislicense"),
        "invalid-signature" => SharedText.Get("App_Licenseandpublickeydonotmatch"),
        "invalid-license" => SharedText.Get("App_Invalidlicensefile"),
        "unsupported-algorithm" => SharedText.Get("App_Unsupportedlicensealgorithm"),
        "license-unavailable" => SharedText.Get("App_Couldnotreadlicensefiles"),
        _ => HasEnterpriseLicense ? SharedText.Get("App_Licenseisvalid") : SharedText.Get("App_NovalidEnterpriselicense")
    };
    private string LicenseExpiryText => !HasEnterpriseLicense
        ? "–"
        : _capabilities.LicenseExpiresAtUtc is { } expiresAt
            ? DateTime.SpecifyKind(expiresAt, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            : "Unbefristet";
    private string LicenseExpiryDescription => HasEnterpriseLicense
        ? _capabilities.LicenseExpiresAtUtc is null ? SharedText.Get("App_Noexpirydateset") : SharedText.Get("App_Localservertime")
        : SharedText.Get("App_Enterpriselicensesonly");

    private static string IdentityErrors(IdentityResult result)
        => string.Join(" ", result.Errors.Select(error => error.Code switch
        {
            "PasswordTooShort" => SharedText.Get("App_Passwordistooshort"),
            "PasswordRequiresNonAlphanumeric" => SharedText.Get("App_Passwordneedsasymbol"),
            "PasswordRequiresDigit" => SharedText.Get("App_Passwordneedsanumber"),
            "PasswordRequiresLower" => SharedText.Get("App_Passwordneedsalowercaseletter"),
            "PasswordRequiresUpper" => SharedText.Get("App_Passwordneedsanuppercaseletter"),
            "DuplicateEmail" or "DuplicateUserName" => SharedText.Get("Account_EmailAlreadyUsed"),
            _ => error.Description
        }));
}
