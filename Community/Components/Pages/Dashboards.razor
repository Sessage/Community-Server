        builder.AddAttribute(1, "Title", L["Dashboard_Widget_Status"].Value);
        builder.AddAttribute(2, "Total", _visibleItems.Count);
        builder.AddAttribute(3, "Bars", new (string, int)[]
        {
            (L["Dashboard_Chart_Open"].Value,  _visibleItems.Count(x => !x.Task.Done)),
