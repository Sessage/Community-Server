    private RenderFragment RenderTaskTable() => builder =>
    {
        builder.OpenComponent<DashboardTaskTable>(0);
        builder.AddAttribute(1, "VisibleCount", _visibleItems.Count);
        builder.AddAttribute(2, "GroupedItems", GetGroupedItems());
        builder.CloseComponent();
    };

    private IReadOnlyList<TodoCalendarItem> BuildDashboardCalendarItems()
        => _visibleItems
            .Where(item => item.Task.StartDate.HasValue && item.Task.DueDate.HasValue)
            .Select(item =>
            {
                var startDate = item.Task.StartDate!.Value.Date;
                var dueDate = item.Task.DueDate!.Value.Date;
                var endDate = dueDate >= startDate ? dueDate.AddDays(1) : startDate.AddDays(1);

                return new TodoCalendarItem
                {
                    TaskId = item.Task.Id,
                    ListId = item.List.Id,
                    Title = $"{item.Task.Title} · {item.List.Name}",
                    Start = startDate,
                    End = endDate,
                    CardColor = item.Task.CardColor,
                    CardColorMode = item.Task.CardColorMode,
                    AssigneeUserId = string.IsNullOrWhiteSpace(item.Task.Assignee) ? null : item.Task.Assignee.Trim(),
                    AssigneeDisplayName = GetCalendarAssigneeDisplayName(item.List, item.Task.Assignee),
                    AssigneeInitials = GetCalendarAssigneeInitials(item.List, item.Task.Assignee),
                    AssigneeAvatarColor = GetCalendarAssigneeAvatarColor(item.Task.Assignee),
                    AssigneeProfilePictureUrl = GetCalendarAssigneeProfilePictureUrl(item.Task.Assignee)
                };
            })
            .ToList();

    // ── Helpers ───────────────────────────────────────────────────────────

    private static string? GetCalendarAssigneeDisplayName(TodoListEntity list, string? userId)
    {
        var participant = FindCalendarParticipant(list, userId);
        return participant is not null && !string.IsNullOrWhiteSpace(participant.DisplayName)
            ? participant.DisplayName
            : string.IsNullOrWhiteSpace(userId) ? null : userId.Trim();
    }

    private static string? GetCalendarAssigneeInitials(TodoListEntity list, string? userId)
    {
        var displayName = GetCalendarAssigneeDisplayName(list, userId);
        if (string.IsNullOrWhiteSpace(displayName))
            return null;

        var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();

        return parts.Length == 1 && parts[0].Length > 0
            ? parts[0][0].ToString().ToUpperInvariant()
            : "?";
    }

    private static ListParticipantEntity? FindCalendarParticipant(TodoListEntity list, string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId) || list.Participants is null)
            return null;

        var uid = userId.Trim();
        return list.Participants.FirstOrDefault(p =>
            (!string.IsNullOrWhiteSpace(p.UserId) && string.Equals(p.UserId.Trim(), uid, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(p.Email) && string.Equals(p.Email.Trim(), uid, StringComparison.OrdinalIgnoreCase)));
    }

    private static string? GetCalendarAssigneeAvatarColor(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
            return null;

        var colors = new[] { "#0079bf", "#d29034", "#519839", "#b04632", "#89609e", "#cd5a91", "#4bbf6b", "#00aecc", "#838c91" };
        var hash = 0;
        foreach (var c in userId.Trim())
            hash = unchecked(hash * 31 + c);
        return colors[Math.Abs(hash) % colors.Length];
    }

    private static string? GetCalendarAssigneeProfilePictureUrl(string? userId)
        => string.IsNullOrWhiteSpace(userId)
            ? null
            : $"/api/profile-picture/{Uri.EscapeDataString(userId.Trim())}";

    private string CurrentViewLabel => _view == DashboardView.Calendar
        ? L["QuickLink_Calendar"]
        : L["Page_Workspace_ListView"];

    private string ViewMenuItemCss(DashboardView view)
        => $"block w-full px-3 py-2 text-left hover:bg-slate-50 {(_view == view ? "bg-blue-50 text-blue-700" : "text-slate-700")}";

    private async Task SwitchView(DashboardView view)
    {
        if (_viewDropdown is not null)
        {
            await _viewDropdown.CloseAsync();
        }

        _view = view;
        _initSortableAfterRender = view == DashboardView.List;
        _sortsOpen = false;
    }

    private Task OpenCalendarTaskAsync(TodoCalendarItem item)
    {
        if (item.ListId is null || item.TaskId is null)
        {
            return Task.CompletedTask;
        }

        var list = _lists.FirstOrDefault(candidate => candidate.Id == item.ListId.Value);
        var task = list?.Tasks.FirstOrDefault(candidate => candidate.Id == item.TaskId.Value);
        if (list is not null && task is not null)
        {
            _selectedTaskList = list;
            _selectedTask = task;
        }

        return Task.CompletedTask;
    }

    private Task CloseTaskDetails()
    {
        _selectedTask = null;
        _selectedTaskList = null;
        return Task.CompletedTask;
    }

    private Task HandleTaskUpdated(TodoTaskEntity updatedTask)
    {
        _selectedTask = updatedTask;
        return Task.CompletedTask;
    }

    private async Task ReloadDashboardListsAsync()
    {
        _lists = await ListService.GetListsAsync(_userId);
        RecalculateVisibleItems();

        if (_selectedTask is not null && _selectedTaskList is not null)
        {
            _selectedTaskList = _lists.FirstOrDefault(list => list.Id == _selectedTaskList.Id);
            _selectedTask = _selectedTaskList?.Tasks.FirstOrDefault(task => task.Id == _selectedTask.Id);
        }
    }

    private string GetWidgetLabel(string widgetId) => widgetId switch
    {
        "kpi"      => L["Dashboard_Widget_Kpi"],
        "status"   => L["Dashboard_Widget_Status"],
        "priority" => L["Dashboard_Widget_Priority"],
        "due"      => L["Dashboard_Widget_Due"],
        "tasks"    => L["Dashboard_Widget_Tasks"],
        _          => widgetId
    };

    private int GetCompletionPercent()
    {
        if (_visibleItems.Count == 0) return 0;
        return (int)Math.Round((double)_visibleItems.Count(x => x.Task.Done) / _visibleItems.Count * 100, MidpointRounding.AwayFromZero);
    }

    private string _exportError = "";

    private void CloseOverlays() => _sortsOpen = false;

    // ── Export ────────────────────────────────────────────────────────────

    private async Task ExportJsonAsync()
    {
        _exportError = "";
        try
        {
            var payload = JsonSerializer.Serialize(_visibleItems.Select(ToExportRow), new JsonSerializerOptions { WriteIndented = true });
            await JS.InvokeVoidAsync("todoUi.downloadFile", BuildFileName("json"), payload, "application/json");
        }
        catch { _exportError = L["Dashboard_ExportError", "JSON"].Value; }
    }

    private async Task ExportCsvAsync()
    {
        _exportError = "";
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine(string.Join(",", new[]
            {
                L["Dashboard_Col_Task"].Value,
                L["Dashboard_Col_List"].Value,
                L["Dashboard_Col_Column"].Value,
                L["Dashboard_Col_Due"].Value,
                L["Export_Header_Done"].Value,
                L["Export_Header_Important"].Value
            }.Select(CsvEscape)));
            foreach (var item in _visibleItems)
            {
                sb.AppendLine(string.Join(",", new[]
                {
                    CsvEscape(item.Task.Title), CsvEscape(item.List.Name), CsvEscape(item.Task.Column),
                    item.Task.DueDate?.ToString("yyyy-MM-dd") ?? string.Empty,
                    item.Task.Done ? "true" : "false", item.Task.IsImportant ? "true" : "false"
                }));
            }
            await JS.InvokeVoidAsync("todoUi.downloadFile", BuildFileName("csv"), "\uFEFF" + sb.ToString(), "text/csv;charset=utf-8");
        }
        catch { _exportError = L["Dashboard_ExportError", "CSV"].Value; }
    }

    private async Task ExportPdfAsync()
    {
        _exportError = "";
        try
        {
            var rows = string.Join("", _visibleItems.Select(i =>
            $"<tr><td>{System.Net.WebUtility.HtmlEncode(i.Task.Title)}</td>" +
            $"<td>{System.Net.WebUtility.HtmlEncode(i.List.Name)}</td>" +
            $"<td>{System.Net.WebUtility.HtmlEncode(i.Task.Column)}</td>" +
            $"<td>{i.Task.DueDate?.ToLocalTime().ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) ?? "-"}</td></tr>"));
        var html = $"<html><head><meta charset='utf-8'><title>Dashboard</title>" +
                   $"<style>body{{font-family:Arial;padding:16px}}table{{width:100%;border-collapse:collapse}}th,td{{border:1px solid #ddd;padding:8px;text-align:left}}</style></head>" +
                   $"<body><h2>{System.Net.WebUtility.HtmlEncode(_activeDashboard?.Name ?? "Dashboard")}</h2>" +
                   $"<table><thead><tr><th>{System.Net.WebUtility.HtmlEncode(L["Dashboard_Col_Task"].Value)}</th>" +
                   $"<th>{System.Net.WebUtility.HtmlEncode(L["Dashboard_Col_List"].Value)}</th>" +
                   $"<th>{System.Net.WebUtility.HtmlEncode(L["Dashboard_Col_Column"].Value)}</th>" +
                   $"<th>{System.Net.WebUtility.HtmlEncode(L["Dashboard_Col_Due"].Value)}</th></tr></thead><tbody>{rows}</tbody></table></body></html>";
            await JS.InvokeVoidAsync("todoUi.printContent", html);
        }
        catch { _exportError = L["Dashboard_ExportError", "PDF"].Value; }
    }

    private object ToExportRow((TodoListEntity List, TodoTaskEntity Task) item) => new
    {
        item.Task.Id, item.Task.Title, item.Task.Description,
        List = item.List.Name, item.Task.Column,
        item.Task.DueDate, item.Task.Done, item.Task.IsImportant
    };

    private string BuildFileName(string ext) => $"dashboard-{DateTime.UtcNow:yyyyMMdd-HHmmss}.{ext}";

    private static string CsvEscape(string? value)
    {
        if (value is null) return string.Empty;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return $"\"{value.Replace("\"", "\"\"")}\"";
        return value;
    }
}
