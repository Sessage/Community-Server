        });
        builder.CloseComponent();
    };

    private RenderFragment RenderPriorityChart() => builder =>
    {
        builder.OpenComponent<DashboardChartWidget>(0);
        builder.AddAttribute(1, "Title", L["Dashboard_Widget_Priority"].Value);
        builder.AddAttribute(2, "Total", _visibleItems.Count);
        builder.AddAttribute(3, "Bars", new (string, int)[]
        {
            (L["Dashboard_Chart_Important"].Value, _visibleItems.Count(x => x.Task.IsImportant)),
