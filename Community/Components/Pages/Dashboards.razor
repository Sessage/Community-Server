        builder.AddAttribute(1, "Total", _visibleItems.Count);
        builder.AddAttribute(2, "Open", _visibleItems.Count(x => !x.Task.Done));
        builder.AddAttribute(3, "Done", _visibleItems.Count(x => x.Task.Done));
        builder.AddAttribute(4, "CompletionPercent", GetCompletionPercent());
        builder.CloseComponent();
    };

    private RenderFragment RenderStatusChart() => builder =>
