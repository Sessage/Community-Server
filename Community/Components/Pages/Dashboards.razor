    private RenderFragment RenderDueChart() => builder =>
    {
        var now = DateTime.UtcNow;
        builder.OpenComponent<DashboardChartWidget>(0);
        builder.AddAttribute(1, "Title", L["Dashboard_Widget_Due"].Value);
        builder.AddAttribute(2, "Total", _visibleItems.Count);
        builder.AddAttribute(3, "Bars", new (string, int)[]
        {
            (L["Dashboard_Chart_Overdue"].Value, _visibleItems.Count(x => x.Task.DueDate < now && !x.Task.Done && x.Task.DueDate is not null)),
            (L["Dashboard_Chart_DueSoon"].Value, _visibleItems.Count(x => x.Task.DueDate >= now && x.Task.DueDate <= now.AddDays(7))),
            (L["Dashboard_Chart_NoDate"].Value,  _visibleItems.Count(x => x.Task.DueDate is null))
        });
        builder.CloseComponent();
