@page "/trash"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@* Trash view for authorized soft-deleted lists and tasks. Permanent deletion requires an explicit user action. *@
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Klassenbibliothek.Data
@using Klassenbibliothek.Services
@using System.Security.Claims
@inject ITodoTrashService TrashService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<PageTitle>@L["Page_Trash_Title"]</PageTitle>

<div class="mx-auto h-full min-h-0 flex flex-col overflow-hidden max-w-3xl px-4 py-6">

    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center gap-3 mb-1">
            <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Neutral" />
            <h1 class="text-2xl font-bold text-slate-800">@L["Page_Trash_Title"]</h1>
        </div>
        <p class="text-sm text-slate-500">
            @L["Page_Trash_Description"]
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 mb-4">
            <div class="font-semibold">@L["Lbl_Error"]</div>
            <div>@_error</div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-slate-500 text-sm">@L["Lbl_Loading"]</div>
    }
    else
    {
        <!-- Listen wiederherstellen -->
        <section class="mb-8">
            <h2 class="text-base font-semibold text-slate-700 mb-3 flex items-center gap-2">
                <FluentIcon Value="@(new Icons.Regular.Size20.DocumentBulletList())" Color="Color.Neutral" />
                @L["Page_Trash_RestoreLists"]
            </h2>

            @if (_deletedLists.Count == 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">
                    @L["Page_Trash_NoDeletedLists"]
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var list in _deletedLists)
                    {
                        var daysLeft = DaysLeft(list.DeletedAt);
                        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3 shadow-sm gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <FluentIcon Value="@(new Icons.Regular.Size20.DocumentBulletList())" Color="Color.Neutral" />
                                <div class="min-w-0">
                                    <div class="font-medium truncate">@list.Name</div>
                                    <div class="text-xs text-slate-500">
                                        @L["Page_Trash_DeletedOn"] @list.DeletedAt!.Value.ToLocalTime().ToString("g")
                                        &bull; @(daysLeft == 1 ? string.Format(L["Page_Trash_DaysLeft"], daysLeft) : string.Format(L["Page_Trash_DaysLeftPlural"], daysLeft))
                                    </div>
                                </div>
                            </div>
                            <FluentButton Appearance="Appearance.Outline"
                                          Title="@L["Page_Trash_RestoreList"]"
                                          Disabled="@TrashMutationBusy"
                                          OnClick="@(() => RestoreListAsync(list.Id))">
                                <div class="flex">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowCounterclockwise())" />
                                    <span class="ml-1 text-sm">@L["Btn_Restore"]</span>
                                </div>
                            </FluentButton>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="mb-8">
            <h2 class="text-base font-semibold text-slate-700 mb-3 flex items-center gap-2">
                <FluentIcon Value="@(new Icons.Regular.Size20.CheckboxChecked())" Color="Color.Neutral" />
                @L["Workspace_RestoreDeletedTasks"]
            </h2>

            @if (_deletedTasks.Count == 0)
            {
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">
                    @L["Workspace_RestoreEmpty"]
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var task in _deletedTasks)
                    {
                        var daysLeft = DaysLeft(task.DeletedAtUtc);
                        <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3 shadow-sm gap-3">
                            <div class="min-w-0">
                                <div class="font-medium truncate">@task.TaskTitle</div>
                                <div class="text-xs text-slate-500 truncate">@task.ListName</div>
                                <div class="text-xs text-slate-500">
                                    @L["Workspace_RestoreDeletedOn"] @task.DeletedAtUtc.ToLocalTime().ToString("g")
                                    &bull; @string.Format(L["Workspace_RestoreDaysLeft"], daysLeft)
                                </div>
                            </div>
                            <FluentButton Appearance="Appearance.Outline"
                                          Title="@L["Workspace_RestoreTask"]"
                                          Disabled="@TrashMutationBusy"
                                          OnClick="@(() => RestoreTaskAsync(task))">
                                <div class="flex">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowCounterclockwise())" />
                                    <span class="ml-1 text-sm">@L["Btn_Restore"]</span>
                                </div>
                            </FluentButton>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private string _userId = "gast";
    private string _error = "";
    private bool _loading = true;
    private Guid? _restoringListId;
    private Guid? _restoringTaskId;
    private bool TrashMutationBusy => _restoringListId.HasValue || _restoringTaskId.HasValue;

    private List<TodoListEntity> _deletedLists = new();
    private List<DeletedTaskTrashItem> _deletedTasks = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            var id = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? user.FindFirstValue("sub");
            _userId = string.IsNullOrWhiteSpace(id) ? "gast" : id;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = "";

        try
        {
            var deletedListsTask = TrashService.GetDeletedListsAsync(_userId);
            var deletedTasksTask = TrashService.GetDeletedTaskEntriesAsync(_userId);
            await Task.WhenAll(deletedListsTask, deletedTasksTask);
            _deletedLists = (await deletedListsTask).ToList();
            _deletedTasks = (await deletedTasksTask).ToList();
        }
        catch (Exception ex)
        {
            _deletedLists.Clear();
            _deletedTasks.Clear();
            _error = string.Format(L["Err_TrashLoad"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RestoreListAsync(Guid listId)
    {
        if (TrashMutationBusy) return;

        _restoringListId = listId;
        _error = "";
        try
        {
            if (!await TrashService.RestoreListAsync(_userId, listId))
            {
                await LoadAsync();
                _error = string.Format(L["Err_ListRestore"], L["Trash_ItemNoLongerAvailable"]);
                return;
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_ListRestore"], ex.Message);
        }
        finally
        {
            _restoringListId = null;
        }
    }

    private async Task RestoreTaskAsync(DeletedTaskTrashItem task)
    {
        if (TrashMutationBusy) return;

        _restoringTaskId = task.TaskId;
        _error = "";
        try
        {
            if (!await TrashService.RestoreTaskAsync(_userId, task.ListId, task.TaskId))
            {
                await LoadAsync();
                _error = string.Format(L["Err_TaskRestore"], L["Trash_ItemNoLongerAvailable"]);
                return;
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_TaskRestore"], ex.Message);
        }
        finally
        {
            _restoringTaskId = null;
        }
    }

    private static int DaysLeft(DateTime? deletedAt)
    {
        if (deletedAt is null) return 0;
        var expiry = deletedAt.Value.AddDays(14);
        var remaining = (expiry - DateTime.UtcNow).TotalDays;
        return Math.Max(0, (int)Math.Ceiling(remaining));
    }
}
