@inherits LayoutComponentBase
@layout TodoSuite.Server.Components.Layout.MainLayout

<div class="h-full overflow-y-auto bg-slate-50">
    <div class="max-w-5xl mx-auto p-6">

        <div class="mb-6">
            <h1 class="text-2xl font-semibold text-slate-900">Konto verwalten</h1>
            <p class="text-sm text-slate-500 mt-1">Verwalten Sie Ihre Kontoeinstellungen und Sicherheitsoptionen.</p>
        </div>

        <div class="flex gap-6 items-start">
            <aside class="w-52 shrink-0 bg-white rounded-2xl border border-slate-200 shadow-sm p-2">
                <ManageNavMenu />
            </aside>
            <div class="flex-1 min-w-0 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                @Body
            </div>
        </div>

    </div>
</div>
