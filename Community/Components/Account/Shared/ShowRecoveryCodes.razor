<StatusMessage Message="@StatusMessage" />
<h3>Wiederherstellungscodes</h3>
<div class="ui-alert ui-alert-warning" role="alert">
    <p>
        <strong>Bewahren Sie diese Codes an einem sicheren Ort auf.</strong>
    </p>
    <p>
        Wenn Sie Ihr Gerät verlieren und keine Wiederherstellungscodes haben, verlieren Sie den Zugang zu Ihrem Konto.
    </p>
</div>
<div class="ui-row">
    <div class="ui-col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
