@page "/Account/ResetPasswordConfirmation"
@layout BodyOnlyLayout

<PageTitle>@L["Account_Ui_30"]</PageTitle>

<div class="ui-row justify-center">
    <div class="ui-col-lg-6">
        <div class="flex justify-center mb-3">
            <img class="object-center" src="_content/TodoSuite.Community.Shared/img/logo.png" />
        </div>
        <h1 class="h1">@L["Account_Ui_30"]</h1>
        <p role="alert">
            @L["Account_ResetDoneHint"]
        </p>
        <p class="mt-3">
            <a href="Account/Login">@L["Account_Login_Button"]</a>
        </p>
    </div>
</div>
