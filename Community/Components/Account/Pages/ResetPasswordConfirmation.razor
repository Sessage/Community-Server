@page "/Account/ResetPasswordConfirmation"
@layout BodyOnlyLayout

<PageTitle>Passwort geändert</PageTitle>

<div class="row justify-center">
    <div class="col-lg-6">
        <div class="flex justify-center mb-3">
            <img class="object-center" src="_content/TodoSuite.Community.Shared/img/logo.png" />
        </div>
        <h1 class="h1">Passwort geändert</h1>
        <p role="alert">
            Dein Passwort wurde zurückgesetzt.
        </p>
        <p class="mt-3">
            <a href="Account/Login">Jetzt anmelden</a>
        </p>
    </div>
</div>
