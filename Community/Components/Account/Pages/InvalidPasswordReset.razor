@page "/Account/InvalidPasswordReset"
@layout BodyOnlyLayout

<PageTitle>Reset-Link ungültig</PageTitle>

<div class="row justify-center">
    <div class="col-lg-6">
        <div class="flex justify-center mb-3">
            <img class="object-center" src="_content/TodoSuite.Community.Shared/img/logo.png" />
        </div>
        <h1 class="h1">Reset-Link ungültig</h1>
        <p role="alert">
            Der Link zum Zurücksetzen des Passworts ist ungültig oder abgelaufen.
        </p>
        <p class="mt-3">
            <a href="Account/ForgotPassword">Neuen Reset-Link anfordern</a>
        </p>
    </div>
</div>
