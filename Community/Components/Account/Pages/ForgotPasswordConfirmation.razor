@page "/Account/ForgotPasswordConfirmation"
@layout BodyOnlyLayout

<PageTitle>Reset-Link gesendet</PageTitle>

<div class="row justify-center">
    <div class="col-lg-6">
        <div class="flex justify-center mb-3">
            <img class="object-center" src="_content/TodoSuite.Community.Shared/img/logo.png" />
        </div>
        <h1 class="h1">Reset-Link gesendet</h1>
        <p role="alert">
            Bitte überprüfe dein Postfach. Wenn ein bestätigtes Konto existiert, erhältst du einen Link zum Zurücksetzen des Passworts.
        </p>
        <p class="mt-3">
            <a href="Account/Login">Zur Anmeldung</a>
        </p>
    </div>
</div>
