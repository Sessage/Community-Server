@page "/Account/Manage/ResetAuthenticator"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data
@using System.Security.Claims
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Authenticator-Schlüssel zurücksetzen</PageTitle>

<h3>Authenticator-Schlüssel zurücksetzen</h3>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-2">@_statusMessage</div>
}

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Wenn Sie Ihren Authenticator-Schlüssel zurücksetzen, funktioniert Ihre Authenticator-App erst wieder, wenn Sie sie neu konfigurieren.</strong>
    </p>
    <p>
        Dieser Vorgang deaktiviert 2FA, bis Sie Ihre Authenticator-App verifizieren.
        Wenn Sie die Konfiguration Ihrer Authenticator-App nicht abschließen, verlieren Sie möglicherweise den Zugang zu Ihrem Konto.
    </p>
</div>

<button class="btn btn-danger" @onclick="OnResetAsync" disabled="@_loading">
    @(_loading ? "Wird zurückgesetzt…" : "Authenticator-Schlüssel zurücksetzen")
</button>

@code {
    private bool _loading;
    private string _statusMessage = "";
    private bool _isError;

    private async Task OnResetAsync()
    {
        _loading = true;
        _statusMessage = "";
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? authState.User.FindFirst("sub")?.Value;

            if (userId is null) { Navigation.NavigateTo("/"); return; }

            var user = await UserManager.FindByIdAsync(userId);
            if (user is null) { Navigation.NavigateTo("/"); return; }

            await UserManager.SetTwoFactorEnabledAsync(user, false);
            await UserManager.ResetAuthenticatorKeyAsync(user);
            Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

            // RefreshSignInAsync writes cookies and cannot be called in Blazor Server
            // interactive mode (response already ended). It is safe to skip here because
            // ResetAuthenticatorKeyAsync does not update the security stamp, so the
            // current session cookie remains valid for the redirect that follows.
            Navigation.NavigateTo("Account/Manage/EnableAuthenticator", forceLoad: true);
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"Fehler: {ex.Message}";
            _loading = false;
            StateHasChanged();
        }
    }
}
