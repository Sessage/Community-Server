@page "/Account/Manage/TwoFactorAuthentication"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data
@using System.Security.Claims

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@L["Security_TwoFactor"]</PageTitle>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="ui-alert ui-alert-success mt-2">@_statusMessage</div>
}

<h3>@L["Security_TwoFactor"]</h3>

@if (_loading)
{
    <p>@L["App_Loading"]</p>
}
else if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="ui-alert ui-alert-danger">
                <strong>@L["Account_Ui_95"]</strong>
                <p>@L["Account_RecoveryGenerateHint"] <a href="Account/Manage/GenerateRecoveryCodes" data-enhance-nav="false">@L["Security_NewRecoveryCodes"]</a></p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="ui-alert ui-alert-danger">
                <strong>@L["Account_Ui_99"]</strong>
                <p>@L["Account_RecoveryGenerateHint"] <a href="Account/Manage/GenerateRecoveryCodes" data-enhance-nav="false">@L["Security_NewRecoveryCodes"]</a></p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="ui-alert ui-alert-warning">
                <strong>@L["Security_RecoveryCodesRemaining", recoveryCodesLeft]</strong>
                <p>@L["Account_RecoveryGenerateHint"] <a href="Account/Manage/GenerateRecoveryCodes" data-enhance-nav="false">@L["Security_NewRecoveryCodes"]</a></p>
            </div>
        }

        <div class="ui-flex flex-wrap gap-2 mb-3">
            @if (isMachineRemembered)
            {
                <a href="/Account/Manage/ForgetBrowserAction" class="ui-btn ui-btn-primary" data-enhance-nav="false">@L["Account_Ui_102"]</a>
            }
            <a href="Account/Manage/Disable2fa" class="ui-btn ui-btn-primary" data-enhance-nav="false">2FA deaktivieren</a>
            <a href="Account/Manage/GenerateRecoveryCodes" class="ui-btn ui-btn-primary" data-enhance-nav="false">@L["Account_Ui_104"]</a>
        </div>
    }

    <h4>@L["Account_Ui_105"]</h4>
    <div class="ui-flex flex-wrap gap-2 mt-2">
        <a href="Account/Manage/EnableAuthenticator" class="ui-btn ui-btn-primary" data-enhance-nav="false">
            @L["Security_Setup"]
        </a>
        @if (hasAuthenticator && is2faEnabled)
        {
            <a href="Account/Manage/ResetAuthenticator" class="ui-btn ui-btn-primary" data-enhance-nav="false">@L["Account_Ui_106"]</a>
        }
    </div>
}
else
{
    <div class="ui-alert ui-alert-danger">
        <strong>@L["Account_Ui_107"]</strong>
        <p>@L["Account_Ui_108"]</p>
    </div>
}

@code {
    private bool _loading = true;
    private string _statusMessage = "";
    private bool canTrack = true;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                  ?? authState.User.FindFirst("sub")?.Value;

        if (userId is null) return;

        var user = await UserManager.FindByIdAsync(userId);
        if (user is null) return;

        var httpContext = HttpContextAccessor.HttpContext;
        canTrack = httpContext?.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);

        if (httpContext is not null)
        {
            try
            {
                isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
            }
            catch (InvalidOperationException)
            {
                // During Blazor prerender the HTTP response is already streaming,
                // so the cookie handler's sliding-expiration renewal cannot register
                // OnStarting. Default to showing the button — clicking it is harmless
                // even if the browser is not currently remembered.
                isMachineRemembered = true;
            }
        }

        _loading = false;
    }
}
