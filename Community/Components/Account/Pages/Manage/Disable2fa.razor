@page "/Account/Manage/Disable2fa"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data
@using System.Security.Claims

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Disable2fa> Logger

<PageTitle>@L["Security_Disable"]</PageTitle>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="ui-alert @(_isError ? "ui-alert-danger" : "ui-alert-success") mt-2">@_statusMessage</div>
}

<h3>@L["Security_Disable"]</h3>

<div class="ui-alert ui-alert-warning" role="alert">
    <p>
        <strong>@L["Account_Ui_50"]</strong>
    </p>
    <p>@L["Account_KeyUnchangedHint"] <a href="Account/Manage/ResetAuthenticator" data-enhance-nav="false">@L["Account_Ui_51"]</a></p>
</div>

<button class="ui-btn ui-btn-danger" @onclick="OnDisableAsync" disabled="@_loading">
    @L[_loading ? "App_Loading" : "Security_Disable"]
</button>

@code {
    private bool _loading;
    private string _statusMessage = "";
    private bool _isError;

    private async Task OnDisableAsync()
    {
        _loading = true;
        _statusMessage = "";
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? authState.User.FindFirst("sub")?.Value;

            if (userId is null) { Navigation.NavigateTo("/"); return; }

            var user = await UserManager.FindByIdAsync(userId);
            if (user is null) { Navigation.NavigateTo("/"); return; }

            var result = await UserManager.SetTwoFactorEnabledAsync(user, false);
            if (!result.Succeeded)
            {
                _isError = true;
                _statusMessage = SharedText.Get("Security_RequestFailed");
                _loading = false;
                StateHasChanged();
                return;
            }

            Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
            Navigation.NavigateTo("Account/Manage/TwoFactorAuthentication", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while disabling 2FA.");
            _isError = true;
            _statusMessage = SharedText.Get("Security_RequestFailed");
            _loading = false;
            StateHasChanged();
        }
    }
}
