@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["PersonalData_Title"]</PageTitle>

<StatusMessage />
<h3>@L["PersonalData_Title"]</h3>

<div class="ui-row">
    <div class="ui-col-md-6">
        <p>@L["Account_Ui_84"]</p>
        <p>
            <strong>@L["Account_Ui_45"]</strong>
        </p>
        <div class="ui-flex flex-wrap gap-2 mt-3">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <button class="ui-btn ui-btn-primary" type="submit">@L["Account_Ui_85"]</button>
            </form>
            <a href="Account/Manage/DeletePersonalData" class="ui-btn ui-btn-danger" data-enhance-nav="false">@L["Dashboard_Delete"]</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
