@page "/Account/Manage/GenerateRecoveryCodes"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data
@using System.Security.Claims

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>@L["Account_Ui_68"]</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <h3>@L["Account_Ui_68"]</h3>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="ui-alert ui-alert-danger mt-2">@_errorMessage</div>
    }

    <div class="ui-alert ui-alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>@L["Account_Ui_35"]</strong>
        </p>
        <p>
            @L["Account_RecoveryLossHint"]
        </p>
        <p>@L["Account_KeyUnchangedHint"] <a href="Account/Manage/ResetAuthenticator" data-enhance-nav="false">@L["Account_Ui_51"]</a></p>
    </div>

    <button class="ui-btn ui-btn-danger" @onclick="OnGenerateAsync" disabled="@_loading">
        @L[_loading ? "App_Loading" : "Security_NewRecoveryCodes"]
    </button>
}

@code {
    private string? message;
    private string? _errorMessage;
    private bool _loading;
    private IEnumerable<string>? recoveryCodes;

    private async Task OnGenerateAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? authState.User.FindFirst("sub")?.Value;

            if (userId is null) return;

            var user = await UserManager.FindByIdAsync(userId);
            if (user is null) return;

            var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
            if (!isTwoFactorEnabled)
            {
                _errorMessage = SharedText.Get("Account_RecoveryDisabled");
                _loading = false;
                StateHasChanged();
                return;
            }

            recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
            if (recoveryCodes is null)
            {
                _errorMessage = SharedText.Get("Security_RequestFailed");
                _loading = false;
                return;
            }
            message = SharedText.Get("Security_CodesReplaced");
            Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while generating 2FA recovery codes.");
            _errorMessage = SharedText.Get("Security_RequestFailed");
            _loading = false;
            StateHasChanged();
        }
    }
}
