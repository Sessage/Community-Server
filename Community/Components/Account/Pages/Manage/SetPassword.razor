@page "/Account/Manage/SetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Klassenbibliothek.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["Account_Ui_92"]</PageTitle>

<h3>@L["Account_Ui_92"]</h3>
<StatusMessage Message="@message" />
<p class="text-info">@L["Account_SetPasswordHint"]</p>
<div class="ui-row">
    <div class="ui-col-xl-6">
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="ui-text-danger" role="alert" />
            <div class="ui-form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="ui-form-control" autocomplete="new-password" placeholder="@L["Account_Ui_42"]" />
                <label for="Input.NewPassword" class="ui-form-label">@L["Account_NewPassword"]</label>
                <ValidationMessage For="() => Input.NewPassword" class="ui-text-danger" />
            </div>
            <div class="ui-form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="ui-form-control" autocomplete="new-password" placeholder="@L["Account_ConfirmNewPassword"]" />
                <label for="Input.ConfirmPassword" class="ui-form-label">@L["Account_ConfirmPassword"]</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="ui-text-danger" />
            </div>
            <button type="submit" class="ui-full-width ui-btn ui-btn-lg ui-btn-primary">@L["Account_Ui_92"]</button>
        </EditForm>
     </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var hasPassword = await UserManager.HasPasswordAsync(user);
        if (hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var addPasswordResult = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            message = SharedText.Get("Err_Generic", string.Join(",", addPasswordResult.Errors.Select(error => error.Description)));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(SharedText.Get("Account_PasswordChanged"), HttpContext);
    }

    private sealed class InputModel
    {
        [LocalizedRequired("Account_Required")]
        [LocalizedStringLength(100, 6, "Account_LengthInvalid")]
        [DataType(DataType.Password)]
        [Display(Name = "Neues Passwort")]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Display(Name = "Neues Passwort bestätigen")]
        [LocalizedCompare("NewPassword", "Account_PasswordMismatch")]
        public string? ConfirmPassword { get; set; }
    }
}
