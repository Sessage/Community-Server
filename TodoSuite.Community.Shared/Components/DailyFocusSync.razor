@inject DailyFocusClient Focus
@inject ITodoCurrentUserService CurrentUser
@inject ITodoListService ListService
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<DailyFocusSync> Logger
@implements IAsyncDisposable

@code {
    private IJSObjectReference? _module, _watch;
    private DotNetObjectReference<DailyFocusSync>? _reference;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _gate = new(1, 1);
    private CancellationToken _ct;
    private string? _legacyScope;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _ct = _lifetime.Token;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
    }
    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        Focus.InvalidateSession();
        if (!_disposed) _ = InvokeAsync(() => RefreshDay(false));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await _gate.WaitAsync();
        try
        {
            if (_disposed) return;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/TodoSuite.Community.Shared/js/daily-focus.js");
            await Focus.InitializeAsync(await _module.InvokeAsync<string>("timeZone"), _ct);
            if (_disposed) return;
            _reference = DotNetObjectReference.Create(this);
            // Keep retrying when the app was opened offline.
            _watch = await _module.InvokeAsync<IJSObjectReference>("watch", _reference,
                Focus.State?.ResetsAtUtc ?? DateTimeOffset.UtcNow.AddSeconds(10));
            await ImportLegacyAsync();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { LogFailure(ex); }
        finally { _gate.Release(); }
    }
    private async Task ImportLegacyAsync()
    {
        if (_module is null || Focus.State is not { } state) return;
        var user = await CurrentUser.GetCurrentUserAsync(_ct);
        var scope = user.ScopeKey ?? user.UserId;
        if (!user.IsAuthenticated || _legacyScope == scope) return;
        var legacy = await _module.InvokeAsync<Guid[]>("legacy", user.UserId, state.Date.ToString("yyyy-MM-dd"));
        if (legacy.Length > 0)
        {
            var lists = await ListService.GetListsAsync(user.UserId, _ct);
            var accessible = lists.SelectMany(l => l.Tasks).Where(t => t.DeletedAt is null).Select(t => t.Id).ToHashSet();
            var ids = legacy.Where(accessible.Contains).Distinct().ToArray();
            if (ids.Length > 0 && (Focus.State?.Date != state.Date || !await Focus.SetAsync(ids, true, _ct))) return;
        }
        try { await _module.InvokeVoidAsync("clearLegacy", user.UserId); } catch (JSException) { }
        _legacyScope = scope;
    }
    [JSInvokable] public async Task RefreshDay(bool expired)
    {
        if (_disposed) return;
        await _gate.WaitAsync();
        try
        {
            if (_disposed) return;
            await Focus.RefreshAsync(expired, _ct);
            await ImportLegacyAsync();
            if (!_disposed && _watch is not null && Focus.State is { } state)
                await _watch.InvokeVoidAsync("update", state.ResetsAtUtc);
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { LogFailure(ex); }
        finally { _gate.Release(); }
    }
    private void LogFailure(Exception ex) => Microsoft.Extensions.Logging.LoggerExtensions.LogWarning(Logger, ex, "Daily focus synchronization failed; changes remain unconfirmed.");
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        await _lifetime.CancelAsync();
        await _gate.WaitAsync();
        try
        {
            if (_watch is not null) { await _watch.InvokeVoidAsync("dispose"); await _watch.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); _lifetime.Dispose(); _gate.Release(); }
    }
}
