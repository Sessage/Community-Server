@if (!string.IsNullOrWhiteSpace(Value))
{
    @* _markup is produced by RichTextContent; never construct MarkupString directly from an untrusted Value. *@
    <div class="rich-text-display break-words">@_markup</div>
}

@code {
    [Parameter] public string? Value { get; set; }

    private string? _renderedValue;
    private MarkupString _markup;

    protected override void OnParametersSet()
    {
        if (string.Equals(Value, _renderedValue, StringComparison.Ordinal))
            return;

        _renderedValue = Value;
        _markup = RichTextContent.ToMarkupString(Value);
    }
}
