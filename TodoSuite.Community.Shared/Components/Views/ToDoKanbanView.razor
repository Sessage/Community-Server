    private async Task AddColumnAsync()
    {
        _error = "";
        var name = (_addColumnValue ?? "").Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            _error = string.Format(L["Err_KanbanColumnCreateEmpty"].Value, List.Name);
            _addColumnOpen = false;
            _addColumnAnchor = null;
            return;
        }

        try
        {
            await ColumnService.AddColumnAsync(_userId, List.Id, name);

            var current = (List.Columns ?? new List<string>()).ToList();
            if (!current.Contains(name, StringComparer.OrdinalIgnoreCase))
                current.Add(name);

            if (!string.IsNullOrWhiteSpace(_addColumnAnchor))
            {
                current.RemoveAll(c => c.Equals(name, StringComparison.OrdinalIgnoreCase));

                var anchorIndex = current.FindIndex(c => c.Equals(_addColumnAnchor, StringComparison.OrdinalIgnoreCase));
                if (anchorIndex < 0) anchorIndex = current.Count - 1;

                var insertIndex = _addColumnInsertRight ? anchorIndex + 1 : anchorIndex;
                insertIndex = Math.Clamp(insertIndex, 0, current.Count);

                current.Insert(insertIndex, name);

                await ColumnService.ReorderColumnsAsync(_userId, List.Id, current);
            }

            _addColumnOpen = false;
            _addColumnAnchor = null;

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_KanbanColumnCreate"].Value, List.Name, name, ex.Message);
            _addColumnOpen = false;
            _addColumnAnchor = null;
        }
    }

