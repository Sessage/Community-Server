    protected override async Task OnInitializedAsync()
    {
        var currentUser = await CurrentUserService.GetCurrentUserAsync();
        _userId = currentUser.UserId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAddColumnTextField && _addColumnOpen && _addColumnTextField is not null)
        {
            _focusAddColumnTextField = false;
            try { _addColumnTextField.FocusAsync(); } catch { }
        }

        if (_focusRenameColumnTextField && _renameColumnOpen && _renameColumnTextField is not null)
        {
            _focusRenameColumnTextField = false;
            try { _renameColumnTextField.FocusAsync(); } catch { }
        }

        if (FilterActive || SelectionMode)
        {
            // damit Drag/Drop sicher aus ist
            try { await JS.InvokeVoidAsync("todoUi.disposeKanban"); } catch { }
            _initialized = false;
            return;
        }

        var sig = BuildColumnsSignature();

        if (List.Columns is null || List.Columns.Count == 0)
        {
            _lastColumnsSignature = sig;
            return;
        }

        if (!_initialized || sig != _lastColumnsSignature)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);

            try { await JS.InvokeVoidAsync("todoUi.disposeKanban"); } catch { }

            await JS.InvokeVoidAsync(
                "todoUi.initKanban",
                _boardScrollId,
                _columnsHostId,
                _dotNetRef,
                SortMode.ToString());

            _initialized = true;
            _lastColumnsSignature = sig;
        }

        _addColumnHookActive = await UpdateDialogHookAsync(_addColumnOpen, "kanban-add-column-dlg", _addColumnHookActive);
        _renameColumnHookActive = await UpdateDialogHookAsync(_renameColumnOpen, "kanban-rename-column-dlg", _renameColumnHookActive);
        _deleteColumnHookActive = await UpdateDialogHookAsync(_deleteColumnOpen, "kanban-delete-column-dlg", _deleteColumnHookActive);
    }

    private async Task<bool> UpdateDialogHookAsync(bool isOpen, string dialogId, bool hookActive)
    {
        if (isOpen && !hookActive)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("todoUi.enableDialogOutsideCloseById", dialogId, _dotNetRef, Array.Empty<string>());
                return true;
            }
            catch { }
        }
        else if (!isOpen && hookActive)
        {
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", dialogId); } catch { }
            return false;
        }

        return hookActive;
    }

