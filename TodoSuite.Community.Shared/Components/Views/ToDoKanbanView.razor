    /* ---------- Bearbeiter-Avatar ---------- */

    private string GetAssigneeInitials(string userId)
    {
        var p = FindParticipant(userId);
        if (p is not null && !string.IsNullOrWhiteSpace(p.DisplayName))
        {
            var parts = p.DisplayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
            if (parts[0].Length > 0)
                return parts[0][0].ToString().ToUpperInvariant();
        }
        return userId.Length > 0 ? userId[0].ToString().ToUpperInvariant() : "?";
    }

    private string GetAssigneeDisplayName(string userId)
    {
        var p = FindParticipant(userId);
        return (p is not null && !string.IsNullOrWhiteSpace(p.DisplayName)) ? p.DisplayName : userId;
    }

    private ListParticipantEntity? FindParticipant(string userId)
    {
        if (string.IsNullOrWhiteSpace(userId) || List.Participants is null)
            return null;

        var uid = userId.Trim();
        return List.Participants.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(x.UserId) && string.Equals(x.UserId.Trim(), uid, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(x.Email) && string.Equals(x.Email.Trim(), uid, StringComparison.OrdinalIgnoreCase)));
    }

    private static string GetAssigneeAvatarColor(string userId)
    {
        var colors = new[] { "#0079bf", "#d29034", "#519839", "#b04632", "#89609e", "#cd5a91", "#4bbf6b", "#00aecc", "#838c91" };
        var hash = 0;
        foreach (var c in userId)
            hash = unchecked(hash * 31 + c);
        return colors[Math.Abs(hash) % colors.Length];
    }

