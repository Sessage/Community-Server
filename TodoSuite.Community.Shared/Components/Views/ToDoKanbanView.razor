    // ✅ WICHTIG: fromCol / toCol sind jetzt echte Spaltennamen, keine IDs mehr!
    [JSInvokable]
    public Task OnKanbanDropped(string taskId, string fromCol, string toCol, string[] fromIds, string[] toIds)
    {
        _error = "";

        if (!Guid.TryParse(taskId, out var movedId))
            return Task.CompletedTask;

        var moved = List.Tasks.FirstOrDefault(t => t.Id == movedId);
        if (moved is null)
            return Task.CompletedTask;

        fromCol = (fromCol ?? "").Trim();
        toCol = (toCol ?? "").Trim();

        if (string.IsNullOrWhiteSpace(fromCol) || string.IsNullOrWhiteSpace(toCol))
            return Task.CompletedTask;

        // Harte Validierung (verhindert Drops in "Geisterspalten")
        if (List.Columns is null
            || !List.Columns.Contains(fromCol)
            || !List.Columns.Contains(toCol))
        {
            _error = string.Format(L["Err_KanbanDropInvalid"].Value, fromCol, toCol, List.Name);
            _ = OnChanged.InvokeAsync();
            return Task.CompletedTask;
        }

        // Spalte im UI sofort setzen
        moved.Column = toCol;

        // Erledigt-Status basierend auf Ziel- und Quellspalte setzen
        var movingIntoDone = IsDoneColumn(toCol) && !IsDoneColumn(fromCol);
        var movingOutOfDone = IsDoneColumn(fromCol) && !IsDoneColumn(toCol);

        if (movingIntoDone)
        {
            moved.Done = true;
            moved.ReminderAtUtc = null;
        }
        else if (movingOutOfDone)
        {
            moved.Done = false;
        }

        // ==============================
        // ✅ CUSTOM: Reihenfolge ist User-Driven -> persistieren
        // ==============================
        if (SortMode == ListSortMode.Custom)
        {
            ApplyKanbanOrdersStrict(toCol, toIds);

            if (!string.Equals(fromCol, toCol, StringComparison.Ordinal))
                ApplyKanbanOrdersStrict(fromCol, fromIds);

            // Reihenfolge merken, damit OnParametersSet sie nach dem Parent-Reload
            // auf das neue List-Objekt übertragen kann (verhindert Zurückspringen).
            _pendingColOrder = new Dictionary<string, string[]>(StringComparer.Ordinal)
            {
                [toCol] = toIds
            };
            if (!string.Equals(fromCol, toCol, StringComparison.Ordinal))
                _pendingColOrder[fromCol] = fromIds;

            // ✅ Optimistisches UI-Update sofort anzeigen – JS-Callback kehrt JETZT zurück.
            // Persistence (HTTP + SQLite) läuft im Hintergrund und blockiert weder den
            // JS-Thread noch die nächste Benutzerinteraktion. Besonders wichtig in der
            // MAUI-App: die mobilen Services versuchen HTTP zuerst (1-3 s Latenz) und
            // fallen dann auf SQLite zurück. Würden wir hier awaiten, hinge die UI für
            // genau diese Zeit ein.
            StateHasChanged();
            BeginDropPersistence();
            _ = PersistKanbanDropAsync(moved, fromCol, toCol, fromIds, toIds);
            return Task.CompletedTask;
        }

        // ==============================
        // ✅ NICHT-CUSTOM: Reihenfolge ergibt sich aus SortMode -> KEIN Reorder persistieren
        //    (sonst Chaos, weil UI nach DueDate/Importance/etc. wieder anders rendert)
        // ==============================

        // Für späteres Zurückschalten auf Custom: ans Ende der Zielspalte hängen
        var max = List.Tasks
            .Where(t => string.Equals(t.Column, toCol, StringComparison.Ordinal) && t.Id != moved.Id)
            .Max(t => (int?)t.KanbanSortOrder) ?? -1;

        moved.KanbanSortOrder = max + 1;

        StateHasChanged();
        BeginDropPersistence();
        _ = PersistKanbanMoveAsync(moved, fromCol, toCol);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Persistiert einen Kanban-Drop (Custom-Modus) im Hintergrund.
    /// Wird nach dem optimistischen UI-Update fire-and-forget aufgerufen,
    /// damit der JS-Callback sofort zurückkehren kann.
    /// </summary>
    private async Task PersistKanbanDropAsync(TodoTaskEntity moved, string fromCol, string toCol, string[] fromIds, string[] toIds)
    {
        try
        {
            // Jede Operation bekommt ein eigenes Timeout, damit ein langsamer UpdateTask-Aufruf
            // nicht das Timeout der nachfolgenden Reorder-Aufrufe aufbraucht. Die mobilen Services
            // haben außerdem einen eigenen Fallback (MarkServerUnreachable + SQLite-Queue), der
            // unabhängig vom hier übergebenen Token arbeitet.
            using var ctsUpdate = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await TaskService.UpdateTaskAsync(_userId, List.Id, moved, ctsUpdate.Token);

            using var ctsReorderTo = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await TaskService.ReorderKanbanColumnAsync(_userId, List.Id, toCol, ParseGuids(toIds), ctsReorderTo.Token);
            if (!string.Equals(fromCol, toCol, StringComparison.Ordinal))
            {
                using var ctsReorderFrom = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                await TaskService.ReorderKanbanColumnAsync(_userId, List.Id, fromCol, ParseGuids(fromIds), ctsReorderFrom.Token);
            }

            // Ab jetzt ist der vollständige Drop auf dem Server gespeichert. Der folgende
            // Reload darf deshalb den finalen Automatisierungszustand übernehmen, etwa wenn
            // eine Regel die Karte anschließend in eine weitere Spalte verschoben hat.
            _pendingColOrder = null;

            // Nur wenn online: Parent holt frische Serverdaten.
            if (IsOnline)
                await OnChanged.InvokeAsync();

            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (_disposed) return;

            _error = IsLikelyTimeoutOrOffline(ex)
                ? string.Format(L["Err_KanbanDropOffline"].Value, List.Name, moved.Id, fromCol, toCol, ex.Message)
                : string.Format(L["Err_KanbanDropFailed"].Value, List.Name, moved.Id, fromCol, toCol, ex.Message);

            // Bei Timeout/Offline den optimistischen UI-Stand nicht durch Resync zurückspringen lassen.
            if (!IsLikelyTimeoutOrOffline(ex))
            {
                _pendingColOrder = null;
                await OnChanged.InvokeAsync();
                RequestKanbanResync();
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            if (!_disposed)
                await EndDropPersistenceAsync();
        }
    }

    /// <summary>
    /// Persistiert eine Spalten-Verschiebung (nicht-Custom-Modus) im Hintergrund.
    /// </summary>
    private async Task PersistKanbanMoveAsync(TodoTaskEntity moved, string fromCol, string toCol)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await TaskService.UpdateTaskAsync(_userId, List.Id, moved, cts.Token);

            if (IsOnline)
                await OnChanged.InvokeAsync();

            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (_disposed) return;

            _error = IsLikelyTimeoutOrOffline(ex)
                ? string.Format(L["Err_KanbanMoveOffline"].Value, List.Name, moved.Id, fromCol, toCol, ex.Message)
                : string.Format(L["Err_KanbanMoveFailed"].Value, List.Name, moved.Id, fromCol, toCol, ex.Message);

            if (!IsLikelyTimeoutOrOffline(ex))
            {
                await OnChanged.InvokeAsync();
                RequestKanbanResync();
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            if (!_disposed)
                await EndDropPersistenceAsync();
        }
    }

    private static bool IsLikelyTimeoutOrOffline(Exception ex)
    {
        // OperationCanceledException covers both TaskCanceledException (HTTP timeout / user CT)
        // and plain OperationCanceledException (e.g., SQLite cancelled by a CancellationToken).
        if (ex is OperationCanceledException || ex is TimeoutException || ex is HttpRequestException)
            return true;

        var message = ex.Message ?? string.Empty;
        return message.Contains("HttpClient.Timeout", StringComparison.OrdinalIgnoreCase)
               || message.Contains("The request was canceled", StringComparison.OrdinalIgnoreCase)
               || message.Contains("timed out", StringComparison.OrdinalIgnoreCase)
               || message.Contains("network", StringComparison.OrdinalIgnoreCase)
               || message.Contains("offline", StringComparison.OrdinalIgnoreCase)
               || message.Contains("connection", StringComparison.OrdinalIgnoreCase);
    }


    /* ---------- Card click handling ---------- */

    private void OnCardPointerDown(Guid taskId, PointerEventArgs e)
    {
        _pointerDownTaskId = taskId;
        _pointerDownX = e.ClientX;
        _pointerDownY = e.ClientY;
        _pointerDownUtc = DateTime.UtcNow;
        _pointerMoved = false;
    }

    private void OnCardPointerMove(PointerEventArgs e)
    {
        if (_pointerDownTaskId is null) return;

        var dx = Math.Abs(e.ClientX - _pointerDownX);
        var dy = Math.Abs(e.ClientY - _pointerDownY);

        if (dx > ClickMoveThresholdPx || dy > ClickMoveThresholdPx)
            _pointerMoved = true;
    }

    private async Task OnCardPointerUpAsync(TodoTaskEntity t, PointerEventArgs e)
    {
        try
        {
            if ((DateTime.UtcNow - _lastDragEndUtc).TotalMilliseconds < ClickBlockAfterDragMs)
                return;

            if (_isDraggingFromSortable)
                return;

            if (_pointerDownTaskId != t.Id)
                return;

            if ((DateTime.UtcNow - _pointerDownUtc).TotalMilliseconds < ClickMinMs)
                return;

            if (_pointerMoved)
                return;

            // ✅ wie ToDoListView: Auswahl an Workspace melden -> TaskEditModal öffnet rechts
            if (SelectionMode)
            {
                if (!_selectedTaskIds.Add(t.Id))
                    _selectedTaskIds.Remove(t.Id);
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (OnTaskSelected.HasDelegate)
                await OnTaskSelected.InvokeAsync(t);
        }
        finally
        {
            _pointerDownTaskId = null;
            _pointerMoved = false;
        }
    }

    private void OnCardPointerCancel(PointerEventArgs _)
    {
        _pointerDownTaskId = null;
        _pointerMoved = false;
    }


    /* ---------- Add card ---------- */

    private string NewTitleFor(string col)
        => _newTitles.TryGetValue(col, out var v) ? v : "";

    private void SetNewTitleFor(string col, string v)
        => _newTitles[col] = v ?? "";

    private string NewTitleInputKey(string col)
        => $"{col}:{(_newTitleInputVersions.TryGetValue(col, out var version) ? version : 0)}";

    private void ResetNewTitleInput(string col)
    {
        _newTitles[col] = "";
        _newTitleInputVersions[col] = _newTitleInputVersions.TryGetValue(col, out var version)
            ? version + 1
            : 1;
    }

    private void RestoreNewTitleInput(string col, string? value)
    {
        _newTitles[col] = value ?? "";
        _newTitleInputVersions[col] = _newTitleInputVersions.TryGetValue(col, out var version)
            ? version + 1
            : 1;
    }

    private readonly HashSet<string> _creatingCardColumns = new(StringComparer.Ordinal);

    private async Task OnNewCardKeyDown(string col, KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await CreateCardAsync(col);
    }

    private async Task CreateCardAsync(string col)
    {
        _error = "";

        if (!_creatingCardColumns.Add(col))
            return;

        var raw = NewTitleFor(col);
        var title = (raw ?? "").Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            _error = string.Format(L["Err_KanbanCardCreateEmpty"].Value, col);
            _creatingCardColumns.Remove(col);
            return;
        }

        var max = List.Tasks.Where(t => t.Column == col)
                            .Max(t => (int?)t.KanbanSortOrder) ?? -1;

        var createInDoneColumn = IsDoneColumn(col);

        var task = new TodoTaskEntity
        {
            Id = Guid.NewGuid(),
            Title = title,
            Column = col,
            KanbanSortOrder = max + 1,
            Done = createInDoneColumn,
            // StartDate = DateTime.Today,
            // DueDate = DateTime.Today.AddDays(1)
        };

        try
        {
            ResetNewTitleInput(col);
            await InvokeAsync(StateHasChanged);
            await TaskService.AddTaskAsync(_userId, List.Id, task);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_KanbanCardCreate"].Value, col, title, ex.Message);
            RestoreNewTitleInput(col, raw);
        }
        finally
        {
            _creatingCardColumns.Remove(col);
        }
    }

    private bool CanWriteToList()
    {
        if (List is null) return true;

        var uid = (_userId ?? "").Trim();
        if (string.IsNullOrWhiteSpace(uid)) return false;

        if (string.Equals((List.OwnerId ?? "").Trim(), uid, StringComparison.OrdinalIgnoreCase))
            return true;

        var p = List.Participants?.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(x.UserId) && string.Equals(x.UserId.Trim(), uid, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(x.Email) && string.Equals(x.Email.Trim(), uid, StringComparison.OrdinalIgnoreCase)));

        if (p is null) return false;
        return p.Role != ListRole.Observer;
    }

    /* ---------- helpers ---------- */

    private void ApplyKanbanOrdersStrict(string col, string[] ids)
    {
        // ids = neue Reihenfolge (Top -> Bottom) aus dem DOM
        var index = new Dictionary<Guid, int>(ids.Length);

        for (int i = 0; i < ids.Length; i++)
        {
            if (Guid.TryParse(ids[i], out var g))
                index[g] = i;
        }

        // 1) SortOrder + Column setzen (für alle, die in ids vorkommen)
        foreach (var kv in index)
        {
            var t = List.Tasks.FirstOrDefault(x => x.Id == kv.Key);
            if (t is null) continue;

            t.Column = col;
            t.KanbanSortOrder = kv.Value;
        }

        // 2) Tasks, die in der Spalte sind aber NICHT in ids vorkommen (sollte selten sein),
        //    ans Ende hängen (damit nichts „hochspringt")
        var max = index.Count;
        foreach (var t in List.Tasks.Where(t => t.Column == col))
        {
            if (!index.ContainsKey(t.Id))
                t.KanbanSortOrder = max++;
        }

        // 3) Zusätzlich: In-Memory Reihenfolge der List.Tasks so umsortieren,
        //    dass Blazor DOM exakt nach ids rendert (unabhängig von stable sort / Diffing)
        var inColOrdered = List.Tasks
            .Where(t => t.Column == col)
            .OrderBy(t => t.KanbanSortOrder)
            .ToList();

        var other = List.Tasks
            .Where(t => t.Column != col)
            .ToList();

        List.Tasks.Clear();
        List.Tasks.AddRange(other);
        List.Tasks.AddRange(inColOrdered);
    }


    private static List<Guid> ParseGuids(string[] ids)
    {
        var result = new List<Guid>(ids.Length);
        foreach (var s in ids)
            if (Guid.TryParse(s, out var g))
                result.Add(g);
        return result;
    }

    // ✅ Nur noch DOM-Key (kollisionsarm) – NICHT für Business-Logik verwenden
    private static string GetColumnDomKey(string col)
    {
        col ??= "";
        var bytes = Encoding.UTF8.GetBytes(col);
        var hash = SHA256.HashData(bytes);
        // 10 hex chars reichen locker
        var hex = Convert.ToHexString(hash).ToLowerInvariant();
        return "c" + hex.Substring(0, 10);
    }

    private static string GetColumnScrollDomId(string colKey) => $"kanban-col-scroll-{colKey}";
    private static string GetColumnHostDomId(string colKey) => $"kanban-col-host-{colKey}";

    /* Karten einfärben */
    private static bool IsDueSoon(TodoTaskEntity t, int days = 2)
    {
        if (t.Done) return false;
        if (t.DueDate is null) return false;

        var due = t.DueDate.Value.Date;
        var today = DateTime.Today;
        // Überfällige Karten (Vergangenheit) UND bald fällige Karten sind beide „urgent"
        return due <= today.AddDays(days);
    }

    private static string? NormalizeHex(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var s = input.Trim();
        if (!s.StartsWith("#")) s = "#" + s;

        // optional: #RGB -> #RRGGBB
        if (s.Length == 4)
            s = "#" + string.Concat(s[1], s[1], s[2], s[2], s[3], s[3]);

        if (s.Length != 7) return null;

        for (int i = 1; i < 7; i++)
        {
            var c = s[i];
            var isHex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
            if (!isHex) return null;
        }

        return s.ToLowerInvariant();
    }

    private string GetCardStyle(TodoTaskEntity t)
    {
        var manual = NormalizeHex(t.CardColor);
        var dueSoon = IsDueSoon(t);

        // Basis
        var border = dueSoon ? "border-color: lightcoral;" : "";

        if (dueSoon)
        {
            return $"background-color: lightcoral;{border}";
        }

        if (manual is null)
        {
            return $"{border}";
        }

        // Manuelle Farbe vorhanden:
        if (t.CardColorMode == TaskCardColorMode.Full)
        {
            return $"background-color: {manual};{border}";
        }

        // TopOnly: wir färben NICHT den ganzen Body, sondern nutzen ein Top-Band (via inline CSS Variable)
        // -> Style liefert nur Border, das Band kommt im Markup.
        return $"{border}";
    }

    private string? GetCardTopBandColor(TodoTaskEntity t)
    {
        var manual = NormalizeHex(t.CardColor);
        if (manual is null) return null;
        if (IsDueSoon(t)) return null;

        return t.CardColorMode == TaskCardColorMode.TopOnly ? manual : null;
    }

