    private bool IsDoneColumn(string col)
        => List.DoneColumns is not null
           && List.DoneColumns.Any(c => c.Equals(col, StringComparison.OrdinalIgnoreCase));

    private async Task ToggleDoneColumnAsync(string col)
    {
        CloseColumnActions();
        _error = "";

        var isDone = IsDoneColumn(col);

        try
        {
            await ColumnService.SetDoneColumnAsync(_userId, List.Id, col, !isDone);

            // Lokales Modell sofort synchronisieren
            List.DoneColumns ??= new List<string>();
            if (!isDone)
            {
                List.DoneColumns.Add(col);

                // Alle bestehenden Aufgaben in dieser Spalte als erledigt markieren
                var tasksInColumn = List.Tasks?
                    .Where(t => t.Column.Equals(col, StringComparison.OrdinalIgnoreCase) && !t.Done)
                    .ToList() ?? new List<TodoTaskEntity>();

                foreach (var task in tasksInColumn)
                {
                    task.Done = true;
                    task.ReminderAtUtc = null;
                    try
                    {
                        await TaskService.UpdateTaskAsync(_userId, List.Id, task);
                    }
                    catch
                    {
                        // Einzelne Fehler ignorieren – UI-Stand bleibt optimistisch
                    }
                }
            }
            else
            {
                List.DoneColumns.RemoveAll(c => c.Equals(col, StringComparison.OrdinalIgnoreCase));
            }

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_KanbanDoneColumn"].Value, col, ex.Message);
        }
    }

