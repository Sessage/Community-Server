    }


    // Blazor-Re-Renders während eines aktiven Drags unterdrücken.
    // Sonst reconciliert Blazor den DOM und verschiebt die physisch von SortableJS
    // bewegte Karte zurück in die alte Spalte → "hängt in der Luft"-Effekt.
    protected override bool ShouldRender() => !_isDraggingFromSortable;

    protected override void OnParametersSet()
    {
        if (_lastSelectionMode && !SelectionMode)
        {
            _selectedTaskIds.Clear();
            RequestKanbanResync();
        }
        _lastSelectionMode = SelectionMode;

        // Listenwechsel: Drag-State sofort zurücksetzen, damit ShouldRender() wieder
        // true liefert. Ohne diesen Reset würde der Component nie neu rendern →
        // OnAfterRenderAsync würde disposeKanban() nie aufrufen → Ghost bleibt hängen.
        if (_lastListId != List.Id)
        {
            _isDraggingFromSortable = false;
            _pointerDownTaskId = null;
            _pointerMoved = false;
            _lastListId = List.Id;
            _pendingColOrder = null; // gehört zur alten Liste, nicht übertragen
        }

        // Optimistischen Drop-Stand auf das frisch geladene List-Objekt übertragen,
        // bevor Blazor rendert – verhindert das kurze Zurückspringen in die alte Reihenfolge.
        if (_pendingColOrder is not null && List?.Tasks is not null)
        {
            foreach (var (col, ids) in _pendingColOrder)
            {
                for (int i = 0; i < ids.Length; i++)
                {
                    if (Guid.TryParse(ids[i], out var g))
                    {
                        var task = List.Tasks.FirstOrDefault(x => x.Id == g);
                        if (task is not null)
                        {
                            task.Column = col;
                            task.KanbanSortOrder = i;
                        }
                    }
                }
            }
            _pendingColOrder = null;
        }

        // SortMode-Wechsel MUSS vor dem Render verarbeitet werden,
        // damit @key (_kanbanHostVersion) im nächsten Render wirklich greift.
        if (_lastSortMode != SortMode)
        {
            _isDraggingFromSortable = false;

            _lastSortMode = SortMode;
            RequestKanbanResync(); // erhöht _kanbanHostVersion + setzt _initialized=false
        }

        // Nach Reconnect: SortableJS neu initialisieren, damit die von Blazor aktualisierten
        // DOM-Elemente (neue Serverreihenfolge) mit dem internen SortableJS-Zustand übereinstimmen.
        if (_lastOnlineReloadVersion != OnlineReloadVersion)
        {
            _lastOnlineReloadVersion = OnlineReloadVersion;
            if (OnlineReloadVersion > 0)
                RequestKanbanResync();
        }
    }


    private int _kanbanHostVersion = 0;

    private void RequestKanbanResync()
    {
        _kanbanHostVersion++;
        _initialized = false; // erzwingt initKanban beim nächsten Render
    }
    private string BuildColumnsSignature()
    {
        if (List.Columns is null) return "";

        // Nur Spaltenstruktur + Done-Spalten: JS-Reinit ist nur bei strukturellen Änderungen
        // (Spalte hinzufügen/löschen/umbenennen/umsortieren) nötig – nicht bei Card-Moves.
        // Card-Moves werden durch Blazors Diff-Algorithmus (@key="t.Id") korrekt in den DOM
        // übernommen, ohne SortableJS neu zu initialisieren.
        var doneCols = List.DoneColumns is not null ? string.Join("|", List.DoneColumns.OrderBy(c => c)) : "";
        return string.Join("|", List.Columns) + "||done:" + doneCols;
    }

    private List<TodoTaskEntity> GetCardsForColumn(string col)
    {
        var q = List.Tasks.Where(t => t.Column == col)
                  .Where(t => MatchesFilter(t));

        return SortMode switch
        {
            ListSortMode.Custom => q
                .OrderBy(t => t.KanbanSortOrder)
                .ThenBy(t => t.CreatedAtUtc)
                .ToList(),

            ListSortMode.Importance => q
                .OrderByDescending(t => t.IsImportant)
                .ThenBy(t => t.DueDate ?? DateTime.MaxValue)
                .ThenBy(t => t.KanbanSortOrder)
                .ToList(),

            ListSortMode.DueDate => q
                .OrderBy(t => t.DueDate ?? DateTime.MaxValue)
                .ThenByDescending(t => t.IsImportant)
                .ThenBy(t => t.KanbanSortOrder)
                .ToList(),

            ListSortMode.Alphabetical => q
                .OrderBy(t => t.Title)
                .ThenBy(t => t.KanbanSortOrder)
                .ToList(),

            ListSortMode.CreatedAt => q
                .OrderByDescending(t => t.CreatedAtUtc)
                .ThenBy(t => t.KanbanSortOrder)
                .ToList(),

            _ => q.OrderBy(t => t.KanbanSortOrder).ToList()
        };
    }


    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopDragWatchdog();
        try { await JS.InvokeVoidAsync("todoUi.disposeKanban"); } catch { }
        if (_addColumnHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "kanban-add-column-dlg"); } catch { }
        if (_renameColumnHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "kanban-rename-column-dlg"); } catch { }
        if (_deleteColumnHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "kanban-delete-column-dlg"); } catch { }
        _dotNetRef?.Dispose();
    }

    /* Helfer für die Label-Farbe */
    private static string? NormalizeHexColor(string? input)
    {
        // akzeptiert z.B. "#FF6B6B", "FF6B6B", "#F00", "F00"
        if (string.IsNullOrWhiteSpace(input))
            return null;

        var s = input.Trim();

        if (s.StartsWith("#"))
            s = s.Substring(1);

        // 3-stellig -> 6-stellig erweitern
        if (s.Length == 3)
            s = string.Concat(s[0], s[0], s[1], s[1], s[2], s[2]);

        if (s.Length != 6)
            return null;

        // Hex validieren
        for (int i = 0; i < s.Length; i++)
        {
            var c = s[i];
            var isHex =
                (c >= '0' && c <= '9') ||
                (c >= 'a' && c <= 'f') ||
                (c >= 'A' && c <= 'F');

            if (!isHex) return null;
        }

        return "#" + s.ToLowerInvariant();
    }

    private static string GetReadableTextColor(string hexBg)
    {
        // erwartet "#rrggbb"
        try
        {
            var s = hexBg.Trim();
            if (s.StartsWith("#")) s = s.Substring(1);
            if (s.Length != 6) return "#0f172a"; // slate-900 fallback

            var r = Convert.ToInt32(s.Substring(0, 2), 16);
            var g = Convert.ToInt32(s.Substring(2, 2), 16);
            var b = Convert.ToInt32(s.Substring(4, 2), 16);

            // Relative Luminanz (W3C-ish)
            // Schwelle: bei dunklem Hintergrund -> weiß, sonst dunkel
            var luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;

            return luminance < 0.55 ? "#ffffff" : "#0f172a"; // white vs slate-900
        }
        catch
        {
            return "#0f172a";
        }
    }

