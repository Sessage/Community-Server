    /* ---------- JS -> Blazor ---------- */

    [JSInvokable]
    public Task SetDragging(bool dragging)
        => ApplyDraggingStateAsync(dragging);

    [JSInvokable]
    public Task SetDraggingWithToken(bool dragging, long token)
    {
        if (token < _latestDragToken) return Task.CompletedTask;
        _latestDragToken = token;
        // Ein frischer Token belegt einen echten neuen Drag-Start. Das IgnoreLateDragStartWindow
        // darf diesen nicht blockieren (der Token-Check hat bereits veraltete Callbacks gefiltert).
        if (dragging) _lastDragEndUtc = DateTime.MinValue;
        return ApplyDraggingStateAsync(dragging);
    }

    private async Task ApplyDraggingStateAsync(bool dragging)
    {
        if (dragging
            && _lastDragEndUtc != DateTime.MinValue
            && (DateTime.UtcNow - _lastDragEndUtc) < IgnoreLateDragStartWindow)
        {
            // Ignore delayed "start" callbacks that arrive after a finished drag.
            return;
        }

        _isDraggingFromSortable = dragging;
        if (dragging)
        {
            _pointerDownTaskId = null;
            _pointerMoved = true;
            _dragStartedUtc = DateTime.UtcNow;
            StartDragWatchdog();
        }
        else
        {
            _lastDragEndUtc = DateTime.UtcNow;
            _dragStartedUtc = DateTime.MinValue;
            StopDragWatchdog();
        }

        if (OnDraggingChanged.HasDelegate)
            await OnDraggingChanged.InvokeAsync(dragging || _pendingDropPersistenceCount > 0);
    }

    private void BeginDropPersistence()
    {
        _pendingDropPersistenceCount++;
        if (_pendingDropPersistenceCount == 1 && OnDraggingChanged.HasDelegate)
            _ = OnDraggingChanged.InvokeAsync(true);
    }

    private async Task EndDropPersistenceAsync()
    {
        if (_pendingDropPersistenceCount > 0)
            _pendingDropPersistenceCount--;

        if (_pendingDropPersistenceCount == 0 && !_isDraggingFromSortable && OnDraggingChanged.HasDelegate)
            await OnDraggingChanged.InvokeAsync(false);
    }

    private void StartDragWatchdog()
    {
        if (!EnableDragWatchdog) return;
        // deprecated: Unreachable while EnableDragWatchdog is intentionally disabled.
        // _dragWatchdogTimer?.Dispose();
        // _dragWatchdogTimer = new System.Threading.Timer(
        //     _ => OnDragWatchdogFired(),
        //     null,
        //     DragWatchdogTimeout,
        //     System.Threading.Timeout.InfiniteTimeSpan);
    }

    private void StopDragWatchdog()
    {
        _dragWatchdogTimer?.Dispose();
        _dragWatchdogTimer = null;
    }

    private void OnDragWatchdogFired()
    {
        // Wird auf einem Thread-Pool-Thread aufgerufen. Prüfen ob der Drag
        // noch hängt (könnte inzwischen regulär beendet worden sein).
        if (!_isDraggingFromSortable) return;

        _ = InvokeAsync(async () =>
        {
            _isDraggingFromSortable = false;
            _dragStartedUtc = DateTime.MinValue;
            _pointerDownTaskId = null;
            _pointerMoved = false;
            _initialized = false; // Kanban beim nächsten Render neu initialisieren
            StopDragWatchdog();
            if (OnDraggingChanged.HasDelegate)
                await OnDraggingChanged.InvokeAsync(false);
            StateHasChanged();

            // JS-Seite ebenfalls aufräumen (Geister-Elemente, Drag-Highlighting)
            try { await JS.InvokeVoidAsync("todoUi.disposeKanban"); } catch { }
        });
    }

    /// <summary>
    /// Wird vom JavaScript-Reconnect-Handler aufgerufen, wenn der Blazor-Circuit
    /// nach einer Offline-Phase wieder verbunden ist.
    /// Stellt sicher, dass ein hängengebliebener Drag-State (_isDraggingFromSortable = true)
    /// zurückgesetzt wird, damit ShouldRender() wieder true liefert und die UI
    /// nicht eingefroren bleibt.
    /// </summary>
    [JSInvokable]
    public async Task OnCircuitReconnected()
    {
        _isDraggingFromSortable = false;
        _dragStartedUtc = DateTime.MinValue;
        _pointerDownTaskId = null;
        _pointerMoved = false;
        _initialized = false; // Kanban beim nächsten Render neu initialisieren
        StopDragWatchdog();
        await InvokeAsync(StateHasChanged);
    }

