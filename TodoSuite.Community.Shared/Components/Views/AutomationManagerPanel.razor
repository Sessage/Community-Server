    private static string? ResolveFieldKey(string? fieldKey, Guid? customFieldId)
        => !string.IsNullOrWhiteSpace(fieldKey)
            ? fieldKey.Trim()
            : customFieldId is null ? null : $"custom:{customFieldId.Value:D}";

    private static bool TryParseCustomFieldKey(string? fieldKey, out Guid customFieldId)
    {
        customFieldId = Guid.Empty;
        return !string.IsNullOrWhiteSpace(fieldKey)
               && fieldKey.StartsWith("custom:", StringComparison.OrdinalIgnoreCase)
               && Guid.TryParse(fieldKey[7..], out customFieldId);
    }

    private void SetConditionField(TodoAutomationConditionEntity condition, string? fieldKey)
    {
        condition.FieldKey = fieldKey;
        condition.CustomFieldId = TryParseCustomFieldKey(fieldKey, out var id) ? id : null;
        condition.Value = TryParseCustomFieldKey(fieldKey, out var customFieldId)
            ? InitialCustomFieldValue(customFieldId)
            : fieldKey switch
        {
            "column" => List.Columns.FirstOrDefault(),
            "done" or "important" => "true",
            "assignee" => FirstAssigneeUserId(),
            "cardColor" => "#2563EB",
            _ => null
        };
    }

