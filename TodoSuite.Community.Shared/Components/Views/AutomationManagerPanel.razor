@using System.Text.Json
@using Klassenbibliothek.Data
@using Klassenbibliothek.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject ITodoAutomationService AutomationService

<div class="space-y-5">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@_error</div>
    }

    @if (_editingRule is null)
    {
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <div class="text-lg font-semibold text-slate-900">@T(AutomationText.Rules)</div>
                <div class="text-sm text-slate-500">@T(AutomationText.Subtitle)</div>
            </div>
            <button type="button"
                    class="inline-flex min-h-10 shrink-0 items-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
                    @onclick="CreateRule">
                <span class="text-lg font-normal leading-none text-white" aria-hidden="true">+</span>
                <span>@T(AutomationText.NewRule)</span>
            </button>
        </div>

        @if (_loading)
        {
            <div class="flex items-center justify-center py-12"><FluentProgressRing /></div>
        }
        else if (_rules.Count == 0)
        {
            <div class="border-y border-slate-200 py-12 text-center">
                <FluentIcon Value="@(new Icons.Regular.Size24.Flow())" Class="text-slate-400" />
                <div class="mt-3 font-medium text-slate-800">@T(AutomationText.EmptyTitle)</div>
                <div class="mt-1 text-sm text-slate-500">@T(AutomationText.EmptyHint)</div>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-200 border-y border-slate-200">
                @foreach (var rule in _rules)
                {
                    <div class="flex flex-wrap items-center gap-4 py-4">
                        <button type="button"
                                class="flex min-w-0 flex-1 items-center gap-3 text-left"
                                @onclick="() => EditRule(rule)">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-sky-50 text-sky-700">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Flow())" />
                            </span>
                            <span class="min-w-0">
                                <span class="block truncate font-semibold text-slate-900">@rule.Name</span>
                                <span class="block truncate text-sm text-slate-500">
                                    @string.Format(T(AutomationText.RuleSummary), TriggerLabel(rule.TriggerType), rule.Conditions.Count, rule.Actions.Count)
                                </span>
                            </span>
                        </button>
                        <FluentCheckbox Value="@rule.IsEnabled"
                                        ValueChanged="value => SetEnabledAsync(rule, value)"
                                        Label="@T(AutomationText.Active)" />
                        <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Edit"]" OnClick="() => EditRule(rule)">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" />
                        </FluentButton>
                        @if (_deleteCandidateId == rule.Id)
                        {
                            <span class="text-sm text-red-700">@T(AutomationText.DeleteConfirm)</span>
                            <FluentButton Appearance="Appearance.Stealth" OnClick="CancelDelete">@L["Btn_Cancel"]</FluentButton>
                            <FluentButton Appearance="Appearance.Accent" OnClick="() => DeleteRuleAsync(rule)">@L["Btn_Delete"]</FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="Appearance.Stealth" Title="@L["Btn_Delete"]" OnClick="() => RequestDelete(rule)">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" />
                            </FluentButton>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-4">
            <div class="min-w-0 flex-1">
                <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">@T(AutomationText.RuleName)</label>
                <input class="h-12 w-full rounded-md border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                       @bind="_editingRule.Name"
                       @bind:event="oninput"
                       placeholder="@T(AutomationText.RuleNamePlaceholder)" />
            </div>
            <label class="flex h-12 items-center gap-2 text-sm">
                <FluentCheckbox @bind-Value="_editingRule.IsEnabled" />
                @T(AutomationText.Active)
            </label>
        </div>

        <div class="mx-auto max-w-3xl space-y-0">
            <section class="rounded-md border border-sky-200 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-sky-100 bg-sky-50 px-4 py-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-md bg-sky-600 text-white">1</span>
                    <div>
                        <div class="font-semibold text-slate-900">@T(AutomationText.Trigger)</div>
                        <div class="text-xs text-slate-500">@T(AutomationText.TriggerHint)</div>
                    </div>
                </div>
                <div class="p-4">
                    <select class="@SelectClass" @bind="_editingRule.TriggerType">
                        @foreach (var trigger in Enum.GetValues<TodoAutomationTriggerType>())
                        {
                            <option value="@trigger">@TriggerLabel(trigger)</option>
                        }
                    </select>
                </div>
            </section>

            <FlowConnector />

            <section class="rounded-md border border-amber-200 bg-white shadow-sm">
                <div class="flex items-center justify-between gap-3 border-b border-amber-100 bg-amber-50 px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-amber-500 text-white">2</span>
                        <div>
                            <div class="font-semibold text-slate-900">@T(AutomationText.Conditions)</div>
                            <div class="text-xs text-slate-500">@T(AutomationText.ConditionsHint)</div>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex min-h-9 shrink-0 items-center gap-2 rounded-md border border-amber-300 bg-white px-3 py-1.5 text-sm font-medium text-amber-900 hover:bg-amber-100"
                            @onclick="AddCondition">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" />
                        <span>@T(AutomationText.AddCondition)</span>
                    </button>
                </div>
                <div class="space-y-3 p-4">
                    @if (_editingRule.Conditions.Count == 0)
                    {
                        <div class="text-sm text-slate-500">@T(AutomationText.NoConditions)</div>
                    }
                    @foreach (var condition in _editingRule.Conditions.OrderBy(x => x.SortOrder).ToList())
                    {
                        <div class="grid gap-3 border-b border-slate-100 pb-3 md:grid-cols-[minmax(180px,1fr)_minmax(180px,1fr)_auto]">
                            <select class="@SelectClass"
                                    value="@condition.Type"
                                    @onchange="e => ChangeConditionType(condition, e)">
                                @foreach (var type in Enum.GetValues<TodoAutomationConditionType>())
                                {
                                    <option value="@type">@ConditionLabel(type)</option>
                                }
                            </select>
                            <div>@ConditionEditor(condition)</div>
                            <FluentButton Appearance="Appearance.Stealth" Title="@T(AutomationText.RemoveCondition)" OnClick="() => RemoveCondition(condition)">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" />
                            </FluentButton>
                        </div>
                    }
                </div>
            </section>

            <FlowConnector />

            <section class="rounded-md border border-emerald-200 bg-white shadow-sm">
                <div class="flex items-center justify-between gap-3 border-b border-emerald-100 bg-emerald-50 px-4 py-3">
                    <div class="flex items-center gap-3">
                        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-emerald-600 text-white">3</span>
                        <div>
                            <div class="font-semibold text-slate-900">@T(AutomationText.Actions)</div>
                            <div class="text-xs text-slate-500">@T(AutomationText.ActionsHint)</div>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex min-h-9 shrink-0 items-center gap-2 rounded-md border border-emerald-300 bg-white px-3 py-1.5 text-sm font-medium text-emerald-900 hover:bg-emerald-100"
                            @onclick="AddAction">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Add())" />
                        <span>@T(AutomationText.AddAction)</span>
                    </button>
                </div>
                <div class="space-y-3 p-4">
                    @foreach (var action in _editingRule.Actions.OrderBy(x => x.SortOrder).ToList())
                    {
                        <div class="grid items-start gap-3 border-b border-slate-100 pb-3 md:grid-cols-[minmax(180px,1fr)_minmax(220px,1.4fr)_auto]">
                            <select class="@SelectClass"
                                    value="@action.Type"
                                    @onchange="e => ChangeActionType(action, e)">
                                @foreach (var type in Enum.GetValues<TodoAutomationActionType>())
                                {
                                    <option value="@type">@ActionLabel(type)</option>
                                }
                            </select>
                            <div>@ActionEditor(action)</div>
                            <FluentButton Appearance="Appearance.Stealth" Title="@T(AutomationText.RemoveAction)" OnClick="() => RemoveAction(action)">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" />
                            </FluentButton>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="mt-5 flex justify-end gap-2 border-t border-slate-200 bg-white py-4">
            <FluentButton Appearance="Appearance.Stealth" OnClick="CancelEdit">@L["Btn_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Disabled="@_saving" OnClick="SaveRuleAsync">
                @if (_saving) { <FluentProgressRing Style="width:16px;height:16px;" /> }
                @L["Btn_Save"]
            </FluentButton>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TodoListEntity List { get; set; } = default!;
    [Parameter, EditorRequired] public string UserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }

    private const string SelectClass = "w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm";
    private readonly List<TodoAutomationRuleEntity> _rules = [];
    private TodoAutomationRuleEntity? _editingRule;
    private bool _loading = true;
    private bool _saving;
    private string _error = string.Empty;
    private Guid? _deleteCandidateId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            _rules.Clear();
            _rules.AddRange(await AutomationService.GetRulesAsync(UserId, List.Id));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void CreateRule()
    {
        _error = string.Empty;
        _editingRule = new TodoAutomationRuleEntity
        {
            Id = Guid.Empty,
            Name = T(AutomationText.DefaultName),
            ListId = List.Id,
            IsEnabled = true,
            TriggerType = TodoAutomationTriggerType.ColumnChanged,
            Actions =
            [
                new TodoAutomationActionEntity
                {
                    Type = TodoAutomationActionType.SetCardColor,
                    Value = "#2563EB"
                }
            ]
        };
    }

    private void EditRule(TodoAutomationRuleEntity source)
    {
        _error = string.Empty;
        _editingRule = new TodoAutomationRuleEntity
        {
            Id = source.Id,
            ListId = source.ListId,
            Name = source.Name,
            IsEnabled = source.IsEnabled,
            TriggerType = source.TriggerType,
            Conditions = source.Conditions.OrderBy(x => x.SortOrder).Select(CloneCondition).ToList(),
            Actions = source.Actions.OrderBy(x => x.SortOrder).Select(CloneAction).ToList()
        };
        foreach (var action in _editingRule.Actions.Where(x => x.Type == TodoAutomationActionType.PostWebhook))
            action.Value = action.GetWebhookConfiguration().Url;
        foreach (var condition in _editingRule.Conditions)
            EnsureConditionConfiguration(condition);
        foreach (var action in _editingRule.Actions)
            EnsureActionConfiguration(action);
    }

    private void CancelEdit() { _editingRule = null; _error = string.Empty; }
    private void AddCondition() => _editingRule?.Conditions.Add(new TodoAutomationConditionEntity
    {
        SortOrder = _editingRule.Conditions.Count,
        Type = TodoAutomationConditionType.ToColumnEquals,
        Value = List.Columns.FirstOrDefault()
    });
    private void RemoveCondition(TodoAutomationConditionEntity item) => _editingRule?.Conditions.Remove(item);
    private void AddAction() => _editingRule?.Actions.Add(new TodoAutomationActionEntity
    {
        SortOrder = _editingRule.Actions.Count,
        Type = TodoAutomationActionType.AddComment
    });
    private void RemoveAction(TodoAutomationActionEntity item) => _editingRule?.Actions.Remove(item);

    private void ChangeConditionType(TodoAutomationConditionEntity condition, ChangeEventArgs args)
    {
        if (!Enum.TryParse<TodoAutomationConditionType>(args.Value?.ToString(), out var type))
            return;

        condition.Type = type;
        condition.CustomFieldId = null;
        condition.Value = type switch
        {
            TodoAutomationConditionType.FromColumnEquals or TodoAutomationConditionType.ToColumnEquals
                => List.Columns.FirstOrDefault(),
            TodoAutomationConditionType.CustomFieldEquals or TodoAutomationConditionType.CustomFieldIsEmpty
                => null,
            _ => null
        };
        if (type is TodoAutomationConditionType.CustomFieldEquals or TodoAutomationConditionType.CustomFieldIsEmpty)
            condition.CustomFieldId = List.CustomFields.FirstOrDefault()?.Id;
    }

    private void ChangeActionType(TodoAutomationActionEntity action, ChangeEventArgs args)
    {
        if (!Enum.TryParse<TodoAutomationActionType>(args.Value?.ToString(), out var type))
            return;

        action.Type = type;
        action.CustomFieldId = null;
        action.LabelId = null;
        action.ConfigurationJson = "{}";
        action.Value = type switch
        {
            TodoAutomationActionType.SetCardColor => "#2563EB",
            TodoAutomationActionType.MoveToColumn => List.Columns.FirstOrDefault(),
            TodoAutomationActionType.SetImportant => "true",
            _ => null
        };
        if (type is TodoAutomationActionType.SetCustomField or TodoAutomationActionType.ClearCustomField)
            action.CustomFieldId = List.CustomFields.FirstOrDefault()?.Id;
        if (type == TodoAutomationActionType.AddLabel)
            action.LabelId = List.Labels.FirstOrDefault()?.Id;
        EnsureActionConfiguration(action);
    }

    private void EnsureConditionConfiguration(TodoAutomationConditionEntity condition)
    {
        if (condition.Type is TodoAutomationConditionType.FromColumnEquals or TodoAutomationConditionType.ToColumnEquals
            && string.IsNullOrWhiteSpace(condition.Value))
            condition.Value = List.Columns.FirstOrDefault();
        if (condition.Type is TodoAutomationConditionType.CustomFieldEquals or TodoAutomationConditionType.CustomFieldIsEmpty
            && condition.CustomFieldId is null)
            condition.CustomFieldId = List.CustomFields.FirstOrDefault()?.Id;
    }

    private void EnsureActionConfiguration(TodoAutomationActionEntity action)
    {
        if (action.Type == TodoAutomationActionType.SetCardColor && string.IsNullOrWhiteSpace(action.Value))
            action.Value = "#2563EB";
        if (action.Type == TodoAutomationActionType.MoveToColumn && string.IsNullOrWhiteSpace(action.Value))
            action.Value = List.Columns.FirstOrDefault();
        if (action.Type == TodoAutomationActionType.SetImportant && string.IsNullOrWhiteSpace(action.Value))
            action.Value = "true";
        if (action.Type is TodoAutomationActionType.SetCustomField or TodoAutomationActionType.ClearCustomField
            && action.CustomFieldId is null)
            action.CustomFieldId = List.CustomFields.FirstOrDefault()?.Id;
        if (action.Type == TodoAutomationActionType.AddLabel && action.LabelId is null)
            action.LabelId = List.Labels.FirstOrDefault()?.Id;
        if (action.Type == TodoAutomationActionType.PostWebhook)
        {
            var configuration = action.GetWebhookConfiguration();
            var fields = configuration.GetSelectedFields().ToHashSet(StringComparer.OrdinalIgnoreCase);
            if (fields.Remove("customFields"))
            {
                foreach (var field in List.CustomFields)
                    fields.Add($"custom:{field.Id}");
            }
            configuration.SelectedFields = fields.ToList();
            action.ConfigurationJson = JsonSerializer.Serialize(configuration);
        }
    }

    private async Task SaveRuleAsync()
    {
        if (_editingRule is null) return;
        _saving = true;
        _error = string.Empty;
        try
        {
            foreach (var action in _editingRule.Actions.Where(x => x.Type == TodoAutomationActionType.PostWebhook))
            {
                var configuration = action.GetWebhookConfiguration();
                configuration.Url = action.Value?.Trim() ?? "";
                configuration.SelectedFields = configuration.GetSelectedFields().ToList();
                action.ConfigurationJson = JsonSerializer.Serialize(configuration);
            }
            await AutomationService.SaveRuleAsync(UserId, List.Id, _editingRule);
            _editingRule = null;
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteRuleAsync(TodoAutomationRuleEntity rule)
    {
        try
        {
            await AutomationService.DeleteRuleAsync(UserId, List.Id, rule.Id);
            _deleteCandidateId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void RequestDelete(TodoAutomationRuleEntity rule) => _deleteCandidateId = rule.Id;
    private void CancelDelete() => _deleteCandidateId = null;

    private async Task SetEnabledAsync(TodoAutomationRuleEntity rule, bool enabled)
    {
        rule.IsEnabled = enabled;
        try { await AutomationService.SetRuleEnabledAsync(UserId, List.Id, rule.Id, enabled); }
        catch (Exception ex) { rule.IsEnabled = !enabled; _error = ex.Message; }
    }

    private RenderFragment ConditionEditor(TodoAutomationConditionEntity condition) => builder =>
    {
        var seq = 0;
        if (condition.Type is TodoAutomationConditionType.TaskIsCompleted or TodoAutomationConditionType.TaskIsOpen)
        {
            builder.OpenElement(seq++, "span"); builder.AddAttribute(seq++, "class", "text-sm text-slate-500"); builder.AddContent(seq++, T(AutomationText.NoAdditionalValue)); builder.CloseElement(); return;
        }
        if (condition.Type is TodoAutomationConditionType.CustomFieldEquals or TodoAutomationConditionType.CustomFieldIsEmpty)
        {
            RenderFieldSelect(builder, ref seq, condition.CustomFieldId, value => condition.CustomFieldId = value);
            if (condition.Type == TodoAutomationConditionType.CustomFieldIsEmpty) return;
        }
        if (condition.Type is TodoAutomationConditionType.FromColumnEquals or TodoAutomationConditionType.ToColumnEquals)
            RenderStringSelect(builder, ref seq, List.Columns, condition.Value, value => condition.Value = value);
        else
            RenderTextInput(builder, ref seq, condition.Value, value => condition.Value = value, condition.Type == TodoAutomationConditionType.TitleContains ? T(AutomationText.TitleText) : T(AutomationText.Value));
    };

    private RenderFragment ActionEditor(TodoAutomationActionEntity action) => builder =>
    {
        var seq = 0;
        switch (action.Type)
        {
            case TodoAutomationActionType.MarkCompleted:
            case TodoAutomationActionType.MarkOpen:
            case TodoAutomationActionType.ClearAssignee:
                RenderHint(builder, ref seq, T(AutomationText.NoAdditionalValue));
                break;
            case TodoAutomationActionType.SetImportant:
                RenderStringSelect(builder, ref seq, ["true", "false"], action.Value ?? "true", value => action.Value = value, value => value == "true" ? T(AutomationText.Important) : T(AutomationText.NotImportant));
                break;
            case TodoAutomationActionType.SetCardColor:
                builder.OpenElement(seq++, "input"); builder.AddAttribute(seq++, "type", "color"); builder.AddAttribute(seq++, "class", "h-10 w-20 rounded border border-slate-300");
                builder.AddAttribute(seq++, "value", string.IsNullOrWhiteSpace(action.Value) ? "#2563eb" : action.Value);
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => action.Value = e.Value?.ToString())); builder.CloseElement();
                RenderStringSelect(
                    builder,
                    ref seq,
                    [nameof(TaskCardColorMode.TopOnly), nameof(TaskCardColorMode.Full)],
                    action.GetCardColorConfiguration().Mode.ToString(),
                    value => SetCardColorMode(action, value),
                    value => CardColorModeLabel(value == nameof(TaskCardColorMode.Full)));
                break;
            case TodoAutomationActionType.SetCustomField:
                RenderFieldSelect(builder, ref seq, action.CustomFieldId, value => action.CustomFieldId = value);
                RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, T(AutomationText.NewValue));
                break;
            case TodoAutomationActionType.ClearCustomField:
                RenderFieldSelect(builder, ref seq, action.CustomFieldId, value => action.CustomFieldId = value);
                break;
            case TodoAutomationActionType.AddLabel:
                RenderGuidSelect(builder, ref seq, List.Labels.Select(x => (x.Id, x.Title)), action.LabelId, value => action.LabelId = value);
                break;
            case TodoAutomationActionType.MoveToColumn:
                RenderStringSelect(builder, ref seq, List.Columns, action.Value, value => action.Value = value);
                break;
            case TodoAutomationActionType.PostWebhook:
                RenderWebhookEditor(builder, ref seq, action);
                break;
            case TodoAutomationActionType.AddComment:
                RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, T(AutomationText.CommentText));
                break;
            case TodoAutomationActionType.SendNotification:
                RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, T(AutomationText.NotificationText));
                break;
            case TodoAutomationActionType.SetAssignee:
                RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, T(AutomationText.UserOrEmail));
                break;
        }
    };

    private static TodoAutomationConditionEntity CloneCondition(TodoAutomationConditionEntity x) => new() { Type = x.Type, SortOrder = x.SortOrder, CustomFieldId = x.CustomFieldId, Value = x.Value };
    private static TodoAutomationActionEntity CloneAction(TodoAutomationActionEntity x) => new() { Type = x.Type, SortOrder = x.SortOrder, CustomFieldId = x.CustomFieldId, LabelId = x.LabelId, Value = x.Value, ConfigurationJson = x.ConfigurationJson };
    private void RenderWebhookEditor(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int seq,
        TodoAutomationActionEntity action)
    {
        var configuration = action.GetWebhookConfiguration();
        var selected = configuration.GetSelectedFields().ToHashSet(StringComparer.OrdinalIgnoreCase);

        RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, "https://example.org/webhook", "url");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "mt-3");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "mb-2 text-xs font-semibold uppercase text-slate-500");
        builder.AddContent(seq++, T(AutomationText.SelectFields));
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "grid gap-2 sm:grid-cols-2");

        foreach (var field in WebhookStandardFields)
            RenderWebhookFieldCheckbox(builder, ref seq, action, selected, field.Key, field.Label);
        foreach (var field in List.CustomFields.OrderBy(x => x.SortOrder))
            RenderWebhookFieldCheckbox(builder, ref seq, action, selected, $"custom:{field.Id}", field.Name);

        builder.CloseElement();
        builder.CloseElement();
        RenderTextInput(
            builder,
            ref seq,
            configuration.BearerToken,
            value => SetWebhookBearerToken(action, value),
            configuration.BearerTokenConfigured ? T(AutomationText.TokenConfigured) : T(AutomationText.OptionalToken),
            "password");
    }

    private void RenderWebhookFieldCheckbox(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int seq,
        TodoAutomationActionEntity action,
        IReadOnlySet<string> selected,
        string key,
        string label)
    {
        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "flex min-w-0 items-center gap-2 rounded-md border border-slate-200 px-2 py-1.5 text-sm");
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "checkbox");
        builder.AddAttribute(seq++, "class", "h-4 w-4 shrink-0");
        builder.AddAttribute(seq++, "checked", selected.Contains(key));
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(
            this,
            args => ToggleWebhookField(action, key, args.Value is true)));
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "truncate");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.CloseElement();
    }

    private static void ToggleWebhookField(TodoAutomationActionEntity action, string key, bool enabled)
    {
        var configuration = action.GetWebhookConfiguration();
        var fields = configuration.GetSelectedFields().ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (enabled) fields.Add(key); else fields.Remove(key);
        configuration.SelectedFields = fields.ToList();
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }

    private static void SetWebhookBearerToken(TodoAutomationActionEntity action, string? token)
    {
        var configuration = action.GetWebhookConfiguration();
        configuration.BearerToken = token ?? "";
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }

    private static void SetCardColorMode(TodoAutomationActionEntity action, string? value)
    {
        var mode = Enum.TryParse<TaskCardColorMode>(value, out var parsed)
            ? parsed
            : TaskCardColorMode.TopOnly;
        action.ConfigurationJson = JsonSerializer.Serialize(new TodoAutomationCardColorConfiguration
        {
            Mode = mode
        });
    }

