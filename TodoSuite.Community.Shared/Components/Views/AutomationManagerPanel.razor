    private static TodoAutomationActionEntity CloneAction(TodoAutomationActionEntity x) => new() { Id = x.Id, RuleId = x.RuleId, Type = x.Type, SortOrder = x.SortOrder, CustomFieldId = x.CustomFieldId, FieldKey = x.FieldKey, LabelId = x.LabelId, PluginActionId = x.PluginActionId, Value = x.Value, ConfigurationJson = x.ConfigurationJson };

    private void RenderPluginActionEditor(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int seq,
        TodoAutomationActionEntity action)
    {
        var descriptor = _pluginActions.FirstOrDefault(candidate =>
            string.Equals(candidate.Id, action.PluginActionId, StringComparison.OrdinalIgnoreCase));
        if (descriptor is null)
        {
            RenderHint(builder, ref seq, T(AutomationText.PluginUnavailableHint));
            return;
        }

        if (!string.IsNullOrWhiteSpace(descriptor.Description))
            RenderHint(builder, ref seq, descriptor.Description);
        var configuration = AutomationPluginActionConfiguration.Parse(action.ConfigurationJson);
        foreach (var input in descriptor.Inputs)
        {
            configuration.Values.TryGetValue(input.Key, out var value);
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "mb-3 space-y-1");
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "block text-xs font-semibold uppercase tracking-wide text-slate-500");
            builder.AddContent(seq++, input.Required ? $"{input.Label} *" : input.Label);
            builder.CloseElement();

            switch (input.Type)
            {
                case AutomationPluginInputType.MultilineText:
                    RenderTextArea(builder, ref seq, value, next => SetPluginInput(action, input.Key, next), input.Description ?? string.Empty);
                    break;
                case AutomationPluginInputType.Number:
                    RenderTextInput(builder, ref seq, value, next => SetPluginInput(action, input.Key, next), input.Description ?? string.Empty, "number");
                    break;
                case AutomationPluginInputType.Boolean:
                    RenderStringSelect(builder, ref seq, ["true", "false"], value ?? input.DefaultValue ?? "false",
                        next => SetPluginInput(action, input.Key, next), next => LocalizedBoolean(next == "true"));
                    break;
                case AutomationPluginInputType.Choice:
                    RenderStringSelect(builder, ref seq, (input.Options ?? []).Select(option => option.Value), value ?? input.DefaultValue,
                        next => SetPluginInput(action, input.Key, next),
                        next => (input.Options ?? []).FirstOrDefault(option => option.Value == next)?.Label ?? next);
                    break;
                case AutomationPluginInputType.Column:
                    RenderStringSelect(builder, ref seq, List.Columns, value ?? input.DefaultValue,
                        next => SetPluginInput(action, input.Key, next));
                    break;
                case AutomationPluginInputType.Person:
                    RenderAssigneeSelect(builder, ref seq, value, next => SetPluginInput(action, input.Key, next));
                    break;
                case AutomationPluginInputType.Secret:
                    RenderTextInput(builder, ref seq, value, next => SetPluginInput(action, input.Key, next),
                        configuration.ConfiguredSecrets.Contains(input.Key, StringComparer.OrdinalIgnoreCase)
                            ? T(AutomationText.SecretConfigured)
                            : input.Description ?? T(AutomationText.SecretPlaceholder),
                        "password");
                    if (configuration.ConfiguredSecrets.Contains(input.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        builder.OpenElement(seq++, "button");
                        builder.AddAttribute(seq++, "type", "button");
                        builder.AddAttribute(seq++, "class", "text-xs text-red-600 hover:underline");
                        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ClearPluginSecret(action, input.Key)));
                        builder.AddContent(seq++, T(AutomationText.RemoveStoredSecret));
                        builder.CloseElement();
                    }
                    break;
                default:
                    RenderTextInput(builder, ref seq, value, next => SetPluginInput(action, input.Key, next), input.Description ?? string.Empty);
                    break;
            }

            if (!string.IsNullOrWhiteSpace(input.Description) && input.Type != AutomationPluginInputType.Secret)
                RenderHint(builder, ref seq, input.Description);
            builder.CloseElement();
        }
    }

    private static void SetPluginInput(TodoAutomationActionEntity action, string key, string? value)
    {
        var configuration = AutomationPluginActionConfiguration.Parse(action.ConfigurationJson);
        configuration.Values[key] = value;
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }

    private static void ClearPluginSecret(TodoAutomationActionEntity action, string key)
    {
        var configuration = AutomationPluginActionConfiguration.Parse(action.ConfigurationJson);
        configuration.Values.Remove(key);
        configuration.ConfiguredSecrets.RemoveAll(configured => string.Equals(configured, key, StringComparison.OrdinalIgnoreCase));
        configuration.ProtectedSecrets.Remove(key);
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }
    private void RenderWebhookEditor(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int seq,
        TodoAutomationActionEntity action)
    {
        var configuration = action.GetWebhookConfiguration();
        var selected = configuration.GetSelectedFields().ToHashSet(StringComparer.OrdinalIgnoreCase);

        RenderTextInput(builder, ref seq, action.Value, value => action.Value = value, "https://example.org/webhook", "url");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "mt-3");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "mb-2 text-xs font-semibold uppercase text-slate-500");
        builder.AddContent(seq++, T(AutomationText.SelectFields));
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "grid gap-2 sm:grid-cols-2");

        foreach (var field in WebhookStandardFields)
            RenderWebhookFieldCheckbox(builder, ref seq, action, selected, field.Key, field.Label);
        foreach (var field in List.CustomFields.OrderBy(x => x.SortOrder))
            RenderWebhookFieldCheckbox(builder, ref seq, action, selected, $"custom:{field.Id}", field.Name);

        builder.CloseElement();
        builder.CloseElement();
        RenderTextInput(
            builder,
            ref seq,
            configuration.BearerToken,
            value => SetWebhookBearerToken(action, value),
            configuration.BearerTokenConfigured ? T(AutomationText.TokenConfigured) : T(AutomationText.OptionalToken),
            "password");
    }

    private void RenderWebhookFieldCheckbox(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int seq,
        TodoAutomationActionEntity action,
        IReadOnlySet<string> selected,
        string key,
        string label)
    {
        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "flex min-w-0 items-center gap-2 rounded-md border border-slate-200 px-2 py-1.5 text-sm");
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "checkbox");
        builder.AddAttribute(seq++, "class", "h-4 w-4 shrink-0");
        builder.AddAttribute(seq++, "checked", selected.Contains(key));
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(
            this,
            args => ToggleWebhookField(action, key, args.Value is true)));
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "truncate");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.CloseElement();
    }

    private static void ToggleWebhookField(TodoAutomationActionEntity action, string key, bool enabled)
    {
        var configuration = action.GetWebhookConfiguration();
        var fields = configuration.GetSelectedFields().ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (enabled) fields.Add(key); else fields.Remove(key);
        configuration.SelectedFields = fields.ToList();
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }

    private static void SetWebhookBearerToken(TodoAutomationActionEntity action, string? token)
    {
        var configuration = action.GetWebhookConfiguration();
        configuration.BearerToken = token ?? "";
        action.ConfigurationJson = JsonSerializer.Serialize(configuration);
    }

