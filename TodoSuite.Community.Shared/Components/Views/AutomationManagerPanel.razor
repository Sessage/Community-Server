    private void RenderFieldSelect(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string? value, Action<string?> changed, bool clearableOnly = false)
    {
        b.OpenElement(s++, "select");
        b.AddAttribute(s++, "class", SelectClass);
        b.AddAttribute(s++, "value", value);
        b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString())));
        b.OpenElement(s++, "option");
        b.AddAttribute(s++, "value", "");
        b.AddContent(s++, T(AutomationText.PleaseSelect));
        b.CloseElement();

        b.OpenElement(s++, "optgroup");
        b.AddAttribute(s++, "label", LocalizedFieldGroup(custom: false));
        foreach (var field in StandardFieldOptions(clearableOnly))
        {
            b.OpenElement(s++, "option");
            b.AddAttribute(s++, "value", field.Key);
            b.AddContent(s++, field.Label);
            b.CloseElement();
        }
        b.CloseElement();

        if (List.CustomFields.Count > 0)
        {
            b.OpenElement(s++, "optgroup");
            b.AddAttribute(s++, "label", LocalizedFieldGroup(custom: true));
            foreach (var field in List.CustomFields.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
            {
                b.OpenElement(s++, "option");
                b.AddAttribute(s++, "value", $"custom:{field.Id:D}");
                b.AddContent(s++, field.Name);
                b.CloseElement();
            }
            b.CloseElement();
        }
        b.CloseElement();
    }

    private void RenderFieldValueEditor(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string? fieldKey, string? value, Action<string?> changed)
    {
        if (TryParseCustomFieldKey(fieldKey, out var customFieldId))
        {
            var field = List.CustomFields.FirstOrDefault(candidate => candidate.Id == customFieldId);
            if (field is not null)
                RenderCustomFieldValueEditor(b, ref s, field, value, changed);
            return;
        }

        switch (fieldKey)
        {
            case "column":
                RenderStringSelect(b, ref s, List.Columns, value, changed);
                break;
            case "done":
            case "important":
                RenderStringSelect(b, ref s, ["true", "false"], value ?? "true", changed,
                    item => LocalizedBoolean(item == "true"));
                break;
            case "assignee":
                RenderAssigneeSelect(b, ref s, value, changed);
                break;
            case "startDate":
            case "dueDate":
                RenderTextInput(b, ref s, value, changed, "", "date");
                break;
            case "cardColor":
                RenderTextInput(b, ref s, string.IsNullOrWhiteSpace(value) ? "#2563EB" : value, changed, "", "color");
                break;
            case "description":
                RenderTextArea(b, ref s, value, changed, T(AutomationText.NewValue));
                break;
            default:
                RenderTextInput(b, ref s, value, changed, T(AutomationText.NewValue));
                break;
        }
    }

    private void RenderCustomFieldValueEditor(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        ref int s,
        TodoCustomFieldDefinitionEntity field,
        string? value,
        Action<string?> changed)
    {
        switch (field.Type)
        {
            case TodoCustomFieldType.Number:
                RenderTextInput(b, ref s, value, changed, T(AutomationText.NewValue), "number");
                return;
            case TodoCustomFieldType.Date:
                RenderTextInput(b, ref s, value, changed, "", "date");
                return;
            case TodoCustomFieldType.Checkbox:
                RenderStringSelect(b, ref s, ["true", "false"], value ?? "false", changed,
                    option => LocalizedBoolean(option == "true"));
                return;
            case TodoCustomFieldType.Dropdown:
            case TodoCustomFieldType.TaskTitleSelect:
                RenderCustomFieldOptionSelect(b, ref s, field, value, changed);
                return;
            case TodoCustomFieldType.MultiSelect:
                var selected = CustomFieldMultiSelectValues.Parse(value);
                b.OpenElement(s++, "div");
                b.AddAttribute(s++, "class", "space-y-1 rounded-md border border-slate-300 bg-white p-2");
                foreach (var option in CustomFieldSelectOptions.GetOptions(field, AvailableLists))
                {
                    var optionValue = option.Value;
                    b.OpenElement(s++, "label");
                    b.AddAttribute(s++, "class", "flex items-center gap-2 rounded px-2 py-1 text-sm hover:bg-slate-50");
                    b.OpenElement(s++, "input");
                    b.AddAttribute(s++, "type", "checkbox");
                    b.AddAttribute(s++, "checked", selected.Contains(optionValue, StringComparer.OrdinalIgnoreCase));
                    b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args =>
                        changed(CustomFieldMultiSelectValues.Toggle(value, optionValue, args.Value is bool isChecked && isChecked))));
                    b.CloseElement();
                    b.AddContent(s++, option.Label);
                    b.CloseElement();
                }
                b.CloseElement();
                return;
            default:
                RenderTextInput(b, ref s, value, changed, T(AutomationText.NewValue));
                return;
        }
    }

    private void RenderCustomFieldOptionSelect(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b,
        ref int s,
        TodoCustomFieldDefinitionEntity field,
        string? value,
        Action<string?> changed)
    {
        b.OpenElement(s++, "select");
        b.AddAttribute(s++, "class", SelectClass);
        b.AddAttribute(s++, "value", value);
        b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => changed(args.Value?.ToString())));
        b.OpenElement(s++, "option");
        b.AddAttribute(s++, "value", "");
        b.AddContent(s++, T(AutomationText.PleaseSelect));
        b.CloseElement();
        foreach (var option in CustomFieldSelectOptions.GetOptions(field, AvailableLists, value))
        {
            b.OpenElement(s++, "option");
            b.AddAttribute(s++, "value", option.Value);
            b.AddContent(s++, option.Label);
            b.CloseElement();
        }
        b.CloseElement();
    }
    private void RenderAssigneeSelect(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string? value, Action<string?> changed)
    {
        var participants = (List.Participants ?? [])
            .Where(p => !p.InvitationPending && !string.IsNullOrWhiteSpace(p.UserId))
            .GroupBy(p => p.UserId!.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(p => string.IsNullOrWhiteSpace(p.DisplayName) ? p.Email : p.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        b.OpenElement(s++, "select");
        b.AddAttribute(s++, "class", SelectClass);
        b.AddAttribute(s++, "value", value);
        b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString())));
        b.OpenElement(s++, "option");
        b.AddAttribute(s++, "value", "");
        b.AddContent(s++, T(AutomationText.PleaseSelect));
        b.CloseElement();
        if (!string.IsNullOrWhiteSpace(List.OwnerId)
            && participants.All(participant => !string.Equals(participant.UserId, List.OwnerId, StringComparison.OrdinalIgnoreCase)))
        {
            b.OpenElement(s++, "option");
            b.AddAttribute(s++, "value", List.OwnerId);
            b.AddContent(s++, List.OwnerId);
            b.CloseElement();
        }
        foreach (var participant in participants)
        {
            b.OpenElement(s++, "option");
            b.AddAttribute(s++, "value", participant.UserId);
            b.AddContent(s++, !string.IsNullOrWhiteSpace(participant.DisplayName)
                ? participant.DisplayName
                : (!string.IsNullOrWhiteSpace(participant.Email) ? participant.Email : participant.UserId));
            b.CloseElement();
        }
        b.CloseElement();
    }
    private static void RenderHint(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string text) { b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "text-sm text-slate-500"); b.AddContent(s++, text); b.CloseElement(); }
    private void RenderTextInput(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string? value, Action<string?> changed, string placeholder, string type = "text") { b.OpenElement(s++, "input"); b.AddAttribute(s++, "type", type); b.AddAttribute(s++, "class", SelectClass); b.AddAttribute(s++, "value", value); b.AddAttribute(s++, "placeholder", placeholder); b.AddAttribute(s++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString()))); b.CloseElement(); }
    private void RenderTextArea(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, string? value, Action<string?> changed, string placeholder) { b.OpenElement(s++, "textarea"); b.AddAttribute(s++, "class", $"{SelectClass} min-h-24"); b.AddAttribute(s++, "value", value); b.AddAttribute(s++, "placeholder", placeholder); b.AddAttribute(s++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString()))); b.CloseElement(); }
    private void RenderStringSelect(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, IEnumerable<string> items, string? value, Action<string?> changed, Func<string, string>? label = null) { b.OpenElement(s++, "select"); b.AddAttribute(s++, "class", SelectClass); b.AddAttribute(s++, "value", value); b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString()))); foreach (var item in items) { b.OpenElement(s++, "option"); b.AddAttribute(s++, "value", item); b.AddContent(s++, label?.Invoke(item) ?? item); b.CloseElement(); } b.CloseElement(); }
    private void RenderGuidSelect(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, IEnumerable<(Guid Id, string Name)> items, Guid? value, Action<Guid?> changed) { b.OpenElement(s++, "select"); b.AddAttribute(s++, "class", SelectClass); b.AddAttribute(s++, "value", value?.ToString()); b.AddAttribute(s++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null))); b.OpenElement(s++, "option"); b.AddAttribute(s++, "value", ""); b.AddContent(s++, T(AutomationText.PleaseSelect)); b.CloseElement(); foreach (var item in items) { b.OpenElement(s++, "option"); b.AddAttribute(s++, "value", item.Id.ToString()); b.AddContent(s++, item.Name); b.CloseElement(); } b.CloseElement(); }

    private string T(AutomationText key)
    {
        var language = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var values = AutomationLanguagePacks.TryGetValue(language, out var localized)
            ? localized
            : AutomationLanguagePacks["en"];
        var index = (int)key;
        return index < values.Length
            ? values[index]
            : AutomationLanguagePacks["en"][index];
    }

