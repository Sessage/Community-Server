    {
        action.FieldKey = fieldKey;
        action.CustomFieldId = TryParseCustomFieldKey(fieldKey, out var id) ? id : null;
        action.Value = TryParseCustomFieldKey(fieldKey, out var customFieldId)
            ? InitialCustomFieldValue(customFieldId)
            : fieldKey switch
        {
            "column" => List.Columns.FirstOrDefault(),
