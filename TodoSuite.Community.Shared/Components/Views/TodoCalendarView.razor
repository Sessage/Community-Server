@inject IJSRuntime JS
@implements IAsyncDisposable

@* JS-backed calendar projection. Events are derived from authorized tasks and callbacks return only task identifiers. *@

<div class="@HostClass">
    <div class="@ContainerClass" @ref="_calendarEl"></div>

    @if (_events.Count == 0)
    {
        <div class="text-slate-500">@EmptyText</div>
    }
</div>

@code {
    [Parameter] public IEnumerable<TodoCalendarItem>? Items { get; set; }
    [Parameter] public EventCallback<TodoCalendarItem> OnItemClick { get; set; }
    [Parameter] public string EmptyText { get; set; } = string.Empty;
    [Parameter] public string HostClass { get; set; } = "space-y-4";
    [Parameter] public string ContainerClass { get; set; } = "min-h-[70vh] rounded-xl border border-slate-200 bg-white p-3 shadow-sm";

    private readonly List<TodoCalendarItem> _events = [];
    private DotNetObjectReference<TodoCalendarView>? _dotNetRef;
    private ElementReference _calendarEl;
    private bool _calendarNeedsRender;

    protected override void OnParametersSet()
    {
        // Das JS-Widget besitzt eine eigene Ereigniskopie. Parameteränderungen ersetzen diese
        // vollständig und markieren genau einen Neuabgleich nach dem nächsten Blazor-Render.
        _events.Clear();
        if (Items is not null)
        {
            _events.AddRange(Items);
        }

        _calendarNeedsRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_calendarNeedsRender)
        {
            return;
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync(
                "todoUi.initCalendar",
                _calendarEl,
                _events,
                _dotNetRef,
                System.Globalization.CultureInfo.CurrentUICulture.Name);
            _calendarNeedsRender = false;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone. Disposal will release the managed reference.
        }
    }

    [JSInvokable]
    public async Task OnCalendarItemClick(string? taskId)
    {
        if (string.IsNullOrWhiteSpace(taskId) || !Guid.TryParse(taskId, out var parsedTaskId))
        {
            return;
        }

        // JavaScript liefert nur eine ID zurück. Der Callback wird ausschließlich für ein
        // Element der aktuell von .NET bereitgestellten, bereits gefilterten Projektion ausgelöst.
        var item = _events.FirstOrDefault(candidate => candidate.TaskId == parsedTaskId);
        if (item is null)
        {
            return;
        }

        await OnItemClick.InvokeAsync(item);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("todoUi.disposeCalendar", _calendarEl);
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit closes before component disposal completes.
        }
        catch (InvalidOperationException)
        {
            // JS interop is unavailable during prerendering.
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
