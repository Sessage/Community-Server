    private async Task OpenTaskAsync(TodoTaskEntity task, string tabId)
    {
        var targetTabId = NormalizeOpenTabId(tabId);
        if (OnTaskOpenRequested.HasDelegate)
            await OnTaskOpenRequested.InvokeAsync(new TodoTaskOpenRequest(task, targetTabId));
        else
            await OnTaskSelected.InvokeAsync(task);
    }

    private static string NormalizeOpenTabId(string? tabId)
        => tabId?.Trim().ToLowerInvariant() switch
        {
            "attachments" or "tab-3" => "attachments",
            "comments" or "tab-2" => "comments",
            _ => "details"
        };

    private bool IsWatchingTask(TodoTaskEntity task)
        => task.Watchers?.Any(w => string.Equals(w.UserId, _userId, StringComparison.OrdinalIgnoreCase)) == true;

    private async Task ToggleTaskWatchingAsync(TodoTaskEntity task)
    {
        _addError = "";
        try
        {
            var watch = !IsWatchingTask(task);
            if (!await TaskService.SetTaskWatchingAsync(_userId, List!.Id, task.Id, watch))
                throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);

            task.Watchers ??= new();
            var existing = task.Watchers.FirstOrDefault(w => string.Equals(w.UserId, _userId, StringComparison.OrdinalIgnoreCase));
            if (watch && existing is null)
                task.Watchers.Add(new TodoTaskWatcherEntity { TaskId = task.Id, UserId = _userId, CreatedAtUtc = DateTime.UtcNow });
            else if (!watch && existing is not null)
                task.Watchers.Remove(existing);

            if (OnTaskUpdated.HasDelegate)
                await OnTaskUpdated.InvokeAsync(task);
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
    }

    private void RenderCustomField(RenderTreeBuilder builder, ref int seq, TodoTaskEntity task, TodoCustomFieldDefinitionEntity field)
    {
        var value = GetCustomValue(task, field.Id);
        var callback = EventCallback.Factory.Create<ChangeEventArgs>(this, e => UpdateCustomFieldAsync(task, field, e.Value));

        if (field.Type == TodoCustomFieldType.Dropdown || field.Type == TodoCustomFieldType.TaskTitleSelect)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", "todo-table-input");
            builder.AddAttribute(seq++, "value", value);
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.AddAttribute(seq++, "onchange", callback);
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", "");
            builder.AddContent(seq++, "");
            builder.CloseElement();
            foreach (var option in CustomFieldSelectOptions.GetOptions(field, AvailableLists, value))
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", option.Value);
                builder.AddContent(seq++, option.Label);
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }

        if (field.Type == TodoCustomFieldType.MultiSelect)
        {
            RenderCustomMultiSelectField(builder, ref seq, task, field, value);
            return;
        }

        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "class", "todo-table-input");
        builder.AddAttribute(seq++, "value", value);
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "onchange", callback);
        builder.AddAttribute(seq++, "type", field.Type switch
        {
            TodoCustomFieldType.Number => "number",
            TodoCustomFieldType.Date => "date",
            TodoCustomFieldType.Checkbox => "checkbox",
            _ => "text"
        });
        if (field.Type == TodoCustomFieldType.Checkbox)
            builder.AddAttribute(seq++, "checked", string.Equals(value, "true", StringComparison.OrdinalIgnoreCase));
        builder.CloseElement();
    }

    private async Task UpdateTaskFieldAsync(TodoTaskEntity task, Action<TodoTaskEntity> update)
    {
        _addError = "";
        try
        {
            update(task);
            var updated = await TaskService.UpdateTaskAsync(_userId, List!.Id, task)
                ?? throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);
            if (OnTaskUpdated.HasDelegate)
                await OnTaskUpdated.InvokeAsync(updated);
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
    }

    private async Task UpdateCustomFieldAsync(TodoTaskEntity task, TodoCustomFieldDefinitionEntity field, object? raw)
    {
        var value = field.Type == TodoCustomFieldType.Checkbox
            ? ((raw is bool b && b) ? "true" : "false")
            : raw?.ToString();

        _addError = "";
        try
        {
            task.CustomFieldValues ??= new();
            var existing = task.CustomFieldValues.FirstOrDefault(v => v.FieldId == field.Id);
            if (existing is null)
                task.CustomFieldValues.Add(new TodoTaskCustomFieldValueEntity { Id = Guid.Empty, TaskId = task.Id, FieldId = field.Id, Value = value });
            else
                existing.Value = value;

            var updated = await TaskService.UpdateTaskAsync(_userId, List!.Id, task)
                ?? throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);
            if (OnTaskUpdated.HasDelegate)
                await OnTaskUpdated.InvokeAsync(updated);
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
    }

    private void RenderCustomMultiSelectField(RenderTreeBuilder builder, ref int seq, TodoTaskEntity task, TodoCustomFieldDefinitionEntity field, string value)
    {
        var selected = CustomFieldMultiSelectValues.Parse(value);

        builder.OpenComponent<FloatingDropdown>(seq++);
        builder.AddAttribute(seq++, "MinWidth", 260d);
        builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(triggerBuilder =>
        {
            var triggerSeq = 0;
            triggerBuilder.OpenElement(triggerSeq++, "button");
            triggerBuilder.AddAttribute(triggerSeq++, "type", "button");
            triggerBuilder.AddAttribute(triggerSeq++, "class", "todo-table-multiselect-trigger");
            triggerBuilder.AddAttribute(triggerSeq++, "data-nodrag", "true");

            if (selected.Count == 0)
            {
                triggerBuilder.OpenElement(triggerSeq++, "span");
                triggerBuilder.AddAttribute(triggerSeq++, "class", "todo-table-multiselect-placeholder");
                triggerBuilder.AddContent(triggerSeq++, L["Bulk_Select"]);
                triggerBuilder.CloseElement();
            }
            else
            {
                foreach (var option in selected)
                    RenderCustomFieldBadge(triggerBuilder, ref triggerSeq, option);
            }

            triggerBuilder.CloseElement();
        }));
        builder.AddAttribute(seq++, "DropdownContent", (RenderFragment)(dropdownBuilder =>
        {
            var dropdownSeq = 0;
            dropdownBuilder.OpenElement(dropdownSeq++, "div");
            dropdownBuilder.AddAttribute(dropdownSeq++, "class", "w-64 rounded-xl border border-slate-200 bg-white p-2 shadow-lg");
            dropdownBuilder.AddAttribute(dropdownSeq++, "data-nodrag", "true");
            dropdownBuilder.AddEventStopPropagationAttribute(dropdownSeq++, "onclick", true);

            foreach (var option in CustomFieldSelectOptions.GetOptions(field, AvailableLists))
            {
                var selectedNow = selected.Contains(option.Value, StringComparer.OrdinalIgnoreCase);
                dropdownBuilder.OpenElement(dropdownSeq++, "label");
                dropdownBuilder.AddAttribute(dropdownSeq++, "class", "flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm hover:bg-slate-50");

                dropdownBuilder.OpenElement(dropdownSeq++, "input");
                dropdownBuilder.AddAttribute(dropdownSeq++, "type", "checkbox");
                dropdownBuilder.AddAttribute(dropdownSeq++, "class", "h-4 w-4 rounded border-slate-300 accent-blue-600");
                dropdownBuilder.AddAttribute(dropdownSeq++, "checked", selectedNow);
                dropdownBuilder.AddAttribute(dropdownSeq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(
                    this,
                    e => ToggleCustomMultiSelectOptionAsync(task, field, option.Value, e.Value is bool b && b)));
                dropdownBuilder.CloseElement();

                dropdownBuilder.OpenElement(dropdownSeq++, "span");
                dropdownBuilder.AddAttribute(dropdownSeq++, "class", "min-w-0 flex-1 truncate");
                dropdownBuilder.AddContent(dropdownSeq++, option.Label);
                dropdownBuilder.CloseElement();

                dropdownBuilder.CloseElement();
            }

            dropdownBuilder.CloseElement();
        }));
        builder.CloseComponent();
    }

    private async Task ToggleCustomMultiSelectOptionAsync(TodoTaskEntity task, TodoCustomFieldDefinitionEntity field, string option, bool selected)
    {
        var current = GetCustomValue(task, field.Id);
        await UpdateCustomFieldAsync(task, field, CustomFieldMultiSelectValues.Toggle(current, option, selected));
    }

    private static void RenderCustomFieldBadge(RenderTreeBuilder builder, ref int seq, string option)
    {
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "todo-table-custom-badge");
        builder.AddAttribute(seq++, "style", CustomFieldBadgeStyle(option));
        builder.AddContent(seq++, option);
        builder.CloseElement();
    }

    private bool MatchesColumnFilters(TodoTaskEntity task)
        => _filters.Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .All(kv => BaseColumns.FirstOrDefault(c => c.Key == kv.Key)?.Value(task).Contains(kv.Value, StringComparison.OrdinalIgnoreCase) == true);

    private bool MatchesFilter(TodoTaskEntity t)
    {
        return TodoTaskFilterMatcher.Matches(Filter, t, _userId);
    }

    private bool FilterActive => Filter?.IsActive() == true;
    private bool ColumnFilterActive => _filters.Values.Any(value => !string.IsNullOrWhiteSpace(value));

    private string GetFilter(string key) => _filters.TryGetValue(key, out var value) ? value : "";
    private void SetFilter(string key, string? value)
    {
        _filters[key] = value ?? "";
        PruneSelectionToVisibleTasks();
    }
    private void SetSort(string key, bool ascending) { _sortColumn = key; _sortAscending = ascending; }
    private void ResetSort() { _sortColumn = null; _sortAscending = true; }

    // Ein DOM-Snapshot einer gefilterten Teilmenge darf niemals als vollständige
    // Listenreihenfolge persistiert werden, sonst würden ausgeblendete Aufgaben ans
    // Ende verschoben. Reordering ist daher nur in der ungefilterten Custom-Ansicht aktiv.
    private bool CanReorderTasks => List is not null
                                    && string.IsNullOrWhiteSpace(_sortColumn)
                                    && !FilterActive
                                    && !ColumnFilterActive
                                    && !SelectionMode
                                    && CanWriteToList();
    private bool CanReorderTask(TodoTaskEntity task) => CanReorderTasks && !task.Done && task.DeletedAt == null;

    private bool IsTaskSelected(Guid taskId) => _selectedTaskIds.Contains(taskId);

    private void PruneSelectionToVisibleTasks()
    {
        var visibleTaskIds = VisibleTasks.Select(task => task.Id).ToHashSet();
        _selectedTaskIds.RemoveWhere(taskId => !visibleTaskIds.Contains(taskId));
    }

    private void ToggleTaskSelection(Guid taskId, ChangeEventArgs e)
    {
        if (e.Value is bool selected && selected)
            _selectedTaskIds.Add(taskId);
        else
            _selectedTaskIds.Remove(taskId);
    }

    private async Task ClearSelectionAsync()
    {
        _selectedTaskIds.Clear();
        await SelectionModeChanged.InvokeAsync(false);
        _taskRowsRenderVersion++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleBulkChangedAsync()
    {
        await OnChanged.InvokeAsync();
        _taskRowsRenderVersion++;
    }

    private async Task HideColumnAsync(string key)
    {
        if (!CanAdminCurrentList())
            return;

        _hiddenColumns.Add(key);
        await SaveHiddenColumnsAsync();
    }

    private async Task ToggleColumnAsync(string key, ChangeEventArgs e)
    {
        if (!CanAdminCurrentList())
            return;

        if (e.Value is bool b && b)
            _hiddenColumns.Remove(key);
        else
            _hiddenColumns.Add(key);

        await SaveHiddenColumnsAsync();
    }

    private async Task SaveHiddenColumnsAsync()
    {
        if (List is null)
            return;

        try
        {
            var saved = await TableColumnOrderService.SetTableHiddenColumnsAsync(_userId, List.Id, _hiddenColumns.ToList());
            List.TableHiddenColumns = saved.ToList();
            LoadHiddenColumnsFromList();
        }
        catch
        {
            LoadHiddenColumnsFromList();
        }
    }

    private void LoadHiddenColumnsFromList()
    {
        _hiddenColumns.Clear();
        foreach (var key in List?.TableHiddenColumns ?? new())
            if (!string.IsNullOrWhiteSpace(key))
                _hiddenColumns.Add(key.Trim());
    }

    private bool HiddenColumnsMatchList()
    {
        var persisted = (List?.TableHiddenColumns ?? new())
            .Where(k => !string.IsNullOrWhiteSpace(k))
            .Select(k => k.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return persisted.SetEquals(_hiddenColumns);
    }

    private bool IsSortedColumn(string key) => string.Equals(_sortColumn, key, StringComparison.OrdinalIgnoreCase);
    private bool IsFilteredColumn(string key) => !string.IsNullOrWhiteSpace(GetFilter(key));
    private bool IsColumnActive(string key) => IsSortedColumn(key) || IsFilteredColumn(key);
    private string SortTitle => _sortAscending ? L["Table_SortedAscending"] : L["Table_SortedDescending"];
    private string T(string key) => L[key].Value;
    private string ColumnOptionsButtonClass(string key)
        => IsColumnActive(key)
            ? "rounded-md bg-sky-100 px-1.5 py-0.5 text-sky-700 hover:bg-sky-200"
            : "rounded-md px-1.5 py-0.5 text-slate-500 hover:bg-slate-200";

    private static bool IsCenteredIconColumn(string key) => key is "#" or "open" or "attachments" or "comments" or "notify" or "done" or "important";
    private static string CellClass(TableColumn column, bool header = false)
    {
        var classes = header ? "todo-table-cell todo-table-header-cell" : "todo-table-cell";
        return IsCenteredIconColumn(column.Key) ? $"{classes} todo-table-cell-center" : classes;
    }

    private bool CanReorderColumn(TableColumn column) => column.Reorderable && CanAdminCurrentList();
    private bool CanHideColumn(TableColumn column) => column.Hideable && CanAdminCurrentList();
    private bool CanAdminCurrentList()
    {
        if (List is null || string.IsNullOrWhiteSpace(_userId))
            return false;

        if (string.Equals(List.OwnerId, _userId, StringComparison.OrdinalIgnoreCase))
            return true;

        return (List.Participants ?? new()).Any(p =>
            p.Role == ListRole.Admin
            && !p.InvitationPending
            && (string.Equals(p.UserId, _userId, StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Email, _userId, StringComparison.OrdinalIgnoreCase)));
    }

    private bool CanWriteToList()
    {
        var uid = (_userId ?? "").Trim();
        if (List is null || string.IsNullOrWhiteSpace(uid)) return false;

        if (string.Equals((List.OwnerId ?? "").Trim(), uid, StringComparison.OrdinalIgnoreCase))
            return true;

        var participant = List.Participants?.FirstOrDefault(p =>
            (!string.IsNullOrWhiteSpace(p.UserId) && string.Equals(p.UserId.Trim(), uid, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(p.Email) && string.Equals(p.Email.Trim(), uid, StringComparison.OrdinalIgnoreCase)));

        return participant is not null && participant.Role != ListRole.Observer && !participant.InvitationPending;
    }

    private IReadOnlyList<AssigneeOption> AssigneeOptions => (List?.Participants ?? new())
        .Where(p => !string.IsNullOrWhiteSpace(p.UserId))
        .GroupBy(p => p.UserId!.Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(g =>
        {
            var participant = g.First();
            var email = string.IsNullOrWhiteSpace(participant.Email)
                ? participant.UserId!.Trim()
                : participant.Email.Trim();
            return new AssigneeOption(g.Key, email);
        })
        .OrderBy(x => x.Email, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private string GetAssigneeEmail(string? assignee)
    {
        var key = assignee?.Trim();
        if (string.IsNullOrWhiteSpace(key))
            return "";

        return AssigneeOptions.FirstOrDefault(o => string.Equals(o.UserId, key, StringComparison.OrdinalIgnoreCase))?.Email
            ?? key;
    }

    private IReadOnlyList<TodoLabelEntity> GetTaskLabels(TodoTaskEntity task)
    {
        var labelIds = (task.LabelLinks ?? [])
            .Select(link => link.LabelId)
            .ToHashSet();

        if (labelIds.Count == 0)
            return [];

        return (List?.Labels ?? [])
            .Where(label => labelIds.Contains(label.Id))
            .OrderBy(label => label.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string GetLabelSearchValue(TodoTaskEntity task)
        => string.Join(", ", GetTaskLabels(task).Select(label => label.Title));

    private static string? NormalizeHexColor(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return null;

        var value = input.Trim().TrimStart('#');
        if (value.Length == 3)
            value = string.Concat(value.Select(character => $"{character}{character}"));

        return value.Length == 6 && value.All(Uri.IsHexDigit)
            ? $"#{value.ToLowerInvariant()}"
            : null;
    }

    private static string GetReadableTextColor(string background)
    {
        try
        {
            var value = background.TrimStart('#');
            if (value.Length != 6)
                return "#0f172a";

            var red = Convert.ToInt32(value[..2], 16);
            var green = Convert.ToInt32(value.Substring(2, 2), 16);
            var blue = Convert.ToInt32(value.Substring(4, 2), 16);
            var luminance = (0.299 * red + 0.587 * green + 0.114 * blue) / 255.0;
            return luminance < 0.55 ? "#ffffff" : "#0f172a";
        }
        catch
        {
            return "#0f172a";
        }
    }

    private static string CustomKey(Guid id) => $"custom:{id:N}";
    private static string GetCustomValue(TodoTaskEntity task, Guid fieldId) => task.CustomFieldValues?.FirstOrDefault(v => v.FieldId == fieldId)?.Value ?? "";
    private static string GetCustomDisplayValue(TodoTaskEntity task, TodoCustomFieldDefinitionEntity field)
    {
        var value = GetCustomValue(task, field.Id);
        return field.Type == TodoCustomFieldType.MultiSelect
            ? string.Join(", ", CustomFieldMultiSelectValues.Parse(value))
            : value;
    }

    private static string CustomFieldBadgeStyle(string option)
    {
        var palette = new[]
        {
            ("#dbeafe", "#1e40af"),
            ("#dcfce7", "#166534"),
            ("#fef3c7", "#92400e"),
            ("#fce7f3", "#9d174d"),
            ("#ede9fe", "#5b21b6"),
            ("#ccfbf1", "#0f766e"),
            ("#fee2e2", "#991b1b"),
            ("#e0f2fe", "#075985")
        };
        uint hash = 0;
        foreach (var c in option ?? "")
            hash = unchecked((hash * 31) + c);
        var selected = palette[(int)(hash % (uint)palette.Length)];
        return $"background:{selected.Item1};color:{selected.Item2};";
    }
    private static string ColumnWidth(TableColumn c) => c.Key switch
    {
        "#" => "68px",
        "open" or "attachments" or "comments" or "notify" => "34px",
        "done" => "144px",
        "important" => "160px",
        "title" => "280px",
        "column" => "190px",
        "labels" => "240px",
        "assignee" => "240px",
        "start" or "due" or "created" => "170px",
        _ => "190px"
    };

    public async ValueTask DisposeAsync()
    {
        var notifyParent = IsDraggingFromSortable;
        _disposed = true;
        _isTaskDragging = false;
        _pendingTaskReorderPersistenceCount = 0;
        if (_columnPickerHookActive)
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", "todo-table-column-picker"); } catch { }

        if (_sortableInitialized)
        {
            try { await JS.InvokeVoidAsync("todoUi.disposeSortableTableColumns", _headerHost); } catch { }
        }
        if (_taskSortableInitialized)
        {
            try { await JS.InvokeVoidAsync("todoUi.disposeSortableTableTasks", _taskRowsHost); } catch { }
        }
        _dotNetRef?.Dispose();

        if (notifyParent && OnDraggingChanged.HasDelegate)
        {
            try { await OnDraggingChanged.InvokeAsync(false); } catch { }
        }
    }

    private sealed record TableColumn(string Key, string Title, bool Sortable, bool Hideable, bool Reorderable, Func<TodoTaskEntity, string> Value, TodoCustomFieldDefinitionEntity? CustomField = null);
    private sealed record AssigneeOption(string UserId, string Email);
}

