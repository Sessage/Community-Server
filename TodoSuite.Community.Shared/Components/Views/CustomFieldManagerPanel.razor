@using Klassenbibliothek.Data
@using Klassenbibliothek.Services
@using Microsoft.AspNetCore.Components.Web
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject ITodoCustomFieldService CustomFieldService

@if (List is not null)
{
    <div class="space-y-4">
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_error</div>
        }
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-[1fr_180px_auto] gap-2">
                <input class="rounded-lg border border-slate-200 px-3 py-2 text-sm"
                       placeholder="@L["CustomField_NamePlaceholder"]"
                       @bind="_newName" />
                <select class="rounded-lg border border-slate-200 px-3 py-2 text-sm" @bind="_newType">
                    @foreach (var type in Enum.GetValues<TodoCustomFieldType>())
                    {
                        <option value="@type">@FieldTypeLabel(type)</option>
                    }
                </select>
                <button type="button"
                        class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white disabled:opacity-50"
                        disabled="@(_busy || !CanAddNewField)"
                        @onclick="AddFieldAsync">
                    @L["Btn_Add"]
                </button>
            </div>
            @if (HasStaticOptions(_newType))
            {
                @RenderOptionsEditor(_newOptionEditor)
            }
            @if (_newType == TodoCustomFieldType.TaskTitleSelect)
            {
                <div class="space-y-2">
                    <select class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" @bind="_newSourceTaskListId">
                        <option value="">@L["CustomField_SelectSourceList"]</option>
                        @foreach (var list in AdminSourceLists)
                        {
                            <option value="@list.Id">@list.Name</option>
                        }
                    </select>
                    <div class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800">
                        @L["CustomField_TaskTitleSelect_AddHelp"]
                    </div>
                    @if (AdminSourceLists.Count == 0)
                    {
                        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
                            @L["CustomField_NoSourceList"]
                        </div>
                    }
                </div>
            }
        </div>

        @if (Fields.Count == 0)
        {
            <div class="rounded-xl border border-dashed border-slate-300 p-4 text-sm text-slate-500">
                @L["CustomField_Empty"]
            </div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var field in Fields)
                {
                    var editing = _editingId == field.Id;
                    <div class="rounded-xl border border-slate-200 bg-white p-3 space-y-3">
                        @if (editing)
                        {
                            <div class="grid grid-cols-1 md:grid-cols-[1fr_180px_auto_auto] gap-2">
                                <input class="rounded-lg border border-slate-200 px-3 py-2 text-sm" @bind="_editName" />
                                <select class="rounded-lg border border-slate-200 px-3 py-2 text-sm" @bind="_editType">
                                    @foreach (var type in Enum.GetValues<TodoCustomFieldType>())
                                    {
                                        <option value="@type">@FieldTypeLabel(type)</option>
                                    }
                                </select>
                                <button type="button"
                                        class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white disabled:opacity-50"
                                        disabled="@(_busy || !CanSaveEditedField)"
                                        @onclick="() => SaveFieldAsync(field)">
                                    @L["Btn_Save"]
                                </button>
                                <button type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" @onclick="CancelEdit">
                                    @L["Btn_Cancel"]
                                </button>
                            </div>
                            @if (HasStaticOptions(_editType))
                            {
                                @RenderOptionsEditor(_editOptionEditor)
                            }
                            @if (_editType == TodoCustomFieldType.TaskTitleSelect)
                            {
                                <div class="space-y-2">
                                    <select class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" @bind="_editSourceTaskListId">
                                        <option value="">@L["CustomField_SelectSourceList"]</option>
                                        @foreach (var list in AdminSourceLists)
                                        {
                                            <option value="@list.Id">@list.Name</option>
                                        }
                                    </select>
                                    <div class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800">
                                        @L["CustomField_TaskTitleSelect_SaveHelp"]
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="font-medium truncate">@field.Name</div>
                                    <div class="text-xs text-slate-500">
                                        @FieldTypeLabel(field.Type)
                                        @if (HasStaticOptions(field.Type))
                                        {
                                            <span> · @string.Join(", ", field.Options.OrderBy(o => o.SortOrder).Select(o => o.Value))</span>
                                        }
                                        @if (field.Type == TodoCustomFieldType.TaskTitleSelect)
                                        {
                                            <span> · @L["CustomField_SourceList"]: @SourceListName(field.SourceTaskListId)</span>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <button type="button" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm" @onclick="() => StartEdit(field)">@L["Btn_Edit"]</button>
                                    <button type="button" disabled="@_busy" class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-700 disabled:opacity-50" @onclick="() => DeleteFieldAsync(field.Id)">@L["Btn_Delete"]</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public TodoListEntity? List { get; set; }
    [Parameter] public IReadOnlyList<TodoListEntity> AvailableLists { get; set; } = [];
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly OptionEditorState _newOptionEditor = new();
    private readonly OptionEditorState _editOptionEditor = new();
    private string _newName = "";
    private TodoCustomFieldType _newType = TodoCustomFieldType.Text;
    private Guid? _newSourceTaskListId;
    private Guid? _editingId;
    private bool _busy;
    private string _error = "";
    private string _editName = "";
    private TodoCustomFieldType _editType = TodoCustomFieldType.Text;
    private Guid? _editSourceTaskListId;

    private List<TodoCustomFieldDefinitionEntity> Fields =>
        (List?.CustomFields ?? new()).OrderBy(f => f.SortOrder).ThenBy(f => f.Name).ToList();

    private List<TodoListEntity> AdminSourceLists =>
        (AvailableLists ?? [])
            .Where(list => List is not null && list.Id != List.Id && CanAdmin(list))
            .OrderBy(list => list.Name)
            .ToList();

    private bool CanAddNewField =>
        !string.IsNullOrWhiteSpace(_newName)
        && (_newType != TodoCustomFieldType.TaskTitleSelect || _newSourceTaskListId is not null);

    private bool CanSaveEditedField =>
        !string.IsNullOrWhiteSpace(_editName)
        && (_editType != TodoCustomFieldType.TaskTitleSelect || _editSourceTaskListId is not null);

    private async Task AddFieldAsync()
    {
        if (List is null || _busy || !CanAddNewField) return;
        _busy = true;
        _error = "";
        var field = new TodoCustomFieldDefinitionEntity
        {
            Name = _newName.Trim(),
            Type = _newType,
            SourceTaskListId = _newType == TodoCustomFieldType.TaskTitleSelect ? _newSourceTaskListId : null,
            Options = HasStaticOptions(_newType) ? ToOptionEntities(_newOptionEditor.Options) : []
        };

        try
        {
            _ = await CustomFieldService.AddFieldAsync(UserId, List.Id, field)
                ?? throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);
            _newName = "";
            _newType = TodoCustomFieldType.Text;
            _newSourceTaskListId = null;
            _newOptionEditor.Reset();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void StartEdit(TodoCustomFieldDefinitionEntity field)
    {
        _editingId = field.Id;
        _editName = field.Name;
        _editType = field.Type;
        _editSourceTaskListId = field.SourceTaskListId;
        _editOptionEditor.Load(field.Options.OrderBy(o => o.SortOrder).Select(o => o.Value));
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editOptionEditor.Reset();
    }

    private async Task SaveFieldAsync(TodoCustomFieldDefinitionEntity field)
    {
        if (List is null || _busy || !CanSaveEditedField) return;

        _busy = true;
        _error = "";
        var previousName = field.Name;
        var previousType = field.Type;
        var previousSourceTaskListId = field.SourceTaskListId;
        var previousOptions = field.Options;
        field.Name = _editName.Trim();
        field.Type = _editType;
        field.SourceTaskListId = _editType == TodoCustomFieldType.TaskTitleSelect ? _editSourceTaskListId : null;
        field.Options = HasStaticOptions(_editType) ? ToOptionEntities(_editOptionEditor.Options) : [];
        try
        {
            _ = await CustomFieldService.UpdateFieldAsync(UserId, List.Id, field)
                ?? throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);
            _editingId = null;
            _editOptionEditor.Reset();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            field.Name = previousName;
            field.Type = previousType;
            field.SourceTaskListId = previousSourceTaskListId;
            field.Options = previousOptions;
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DeleteFieldAsync(Guid fieldId)
    {
        if (List is null || _busy) return;
        _busy = true;
        _error = "";
        try
        {
            if (!await CustomFieldService.DeleteFieldAsync(UserId, List.Id, fieldId))
                throw new InvalidOperationException(L["Err_TaskDeleteNotFound"].Value);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private RenderFragment RenderOptionsEditor(OptionEditorState state) => @<div class="space-y-2 rounded-xl border border-slate-200 bg-white p-3">
        <div class="flex flex-col gap-2 sm:flex-row">
            <input class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm"
                   placeholder="@L["CustomField_OptionPlaceholder"]"
                   value="@state.Draft"
                   @oninput="e => state.Draft = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="e => OnOptionDraftKeyDown(state, e)" />
            <button type="button"
                    class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-white disabled:opacity-50"
                    title="@L["Btn_Add"]"
                    disabled="@(!CanAddOption(state))"
                    @onclick="() => AddOption(state)">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())"
                            Color="Color.Custom"
                            CustomColor="#ffffff" />
                <span class="sr-only">@L["Btn_Add"]</span>
            </button>
        </div>
        @if (state.Options.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-slate-200 px-3 py-2 text-xs text-slate-500">
                @L["CustomField_OptionsEmpty"]
            </div>
        }
        else
        {
            <div class="space-y-1">
                @foreach (var item in state.Options.Select((value, index) => new { value, index }))
                {
                    <div class="flex items-center gap-2 rounded-lg border border-slate-100 bg-slate-50 px-2 py-1.5">
                        @if (state.EditingIndex == item.index)
                        {
                            <input class="min-w-0 flex-1 rounded-md border border-slate-200 px-2 py-1 text-sm"
                                   value="@state.EditDraft"
                                   @oninput="e => state.EditDraft = e.Value?.ToString() ?? string.Empty"
                                   @onkeydown="e => OnOptionEditKeyDown(state, e)" />
                            <button type="button"
                                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-blue-700 hover:bg-blue-50 disabled:opacity-50"
                                    title="@L["Btn_Save"]"
                                    disabled="@(!CanSaveOptionEdit(state))"
                                    @onclick="() => SaveOptionEdit(state)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Accent" />
                                <span class="sr-only">@L["Btn_Save"]</span>
                            </button>
                            <button type="button"
                                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100"
                                    title="@L["Btn_Cancel"]"
                                    @onclick="() => CancelOptionEdit(state)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="Color.Neutral" />
                                <span class="sr-only">@L["Btn_Cancel"]</span>
                            </button>
                        }
                        else
                        {
                            <span class="min-w-0 flex-1 truncate text-sm text-slate-700">@item.value</span>
                            <button type="button"
                                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100"
                                    title="@L["Btn_Edit"]"
                                    @onclick="() => StartOptionEdit(state, item.index)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Neutral" />
                                <span class="sr-only">@L["Btn_Edit"]</span>
                            </button>
                        }
                        <button type="button"
                                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-red-600 hover:bg-red-50"
                                title="@L["Btn_Delete"]"
                                @onclick="() => DeleteOption(state, item.index)">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                            <span class="sr-only">@L["Btn_Delete"]</span>
                        </button>
                    </div>
                }
            </div>
        }
    </div>;

    private void OnOptionDraftKeyDown(OptionEditorState state, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanAddOption(state))
            AddOption(state);
    }

    private void OnOptionEditKeyDown(OptionEditorState state, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSaveOptionEdit(state))
            SaveOptionEdit(state);
        else if (e.Key == "Escape")
            CancelOptionEdit(state);
    }

    private static bool CanAddOption(OptionEditorState state)
        => !string.IsNullOrWhiteSpace(state.Draft)
           && !state.Options.Any(option => string.Equals(option, state.Draft.Trim(), StringComparison.OrdinalIgnoreCase));

    private static bool CanSaveOptionEdit(OptionEditorState state)
        => state.EditingIndex is int index
           && index >= 0
           && index < state.Options.Count
           && !string.IsNullOrWhiteSpace(state.EditDraft)
           && !state.Options.Where((_, optionIndex) => optionIndex != index)
               .Any(option => string.Equals(option, state.EditDraft.Trim(), StringComparison.OrdinalIgnoreCase));

    private static void AddOption(OptionEditorState state)
    {
        if (!CanAddOption(state)) return;
        state.Options.Add(state.Draft.Trim());
        state.Draft = "";
    }

    private static void StartOptionEdit(OptionEditorState state, int index)
    {
        state.EditingIndex = index;
        state.EditDraft = state.Options[index];
    }

    private static void SaveOptionEdit(OptionEditorState state)
    {
        if (!CanSaveOptionEdit(state) || state.EditingIndex is not int index) return;
        state.Options[index] = state.EditDraft.Trim();
        CancelOptionEdit(state);
    }

    private static void CancelOptionEdit(OptionEditorState state)
    {
        state.EditingIndex = null;
        state.EditDraft = "";
    }

    private static void DeleteOption(OptionEditorState state, int index)
    {
        state.Options.RemoveAt(index);
        if (state.EditingIndex == index)
            CancelOptionEdit(state);
        else if (state.EditingIndex > index)
            state.EditingIndex--;
    }

    private static List<TodoCustomFieldOptionEntity> ToOptionEntities(IEnumerable<string> options)
        => options
            .Select(option => (option ?? "").Trim())
            .Where(option => !string.IsNullOrWhiteSpace(option))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select((option, index) => new TodoCustomFieldOptionEntity { Value = option, SortOrder = index })
            .ToList();

    private static bool HasStaticOptions(TodoCustomFieldType type)
        => type is TodoCustomFieldType.Dropdown or TodoCustomFieldType.MultiSelect;

    private string FieldTypeLabel(TodoCustomFieldType type) => type switch
    {
        TodoCustomFieldType.Number => L["CustomField_Type_Number"],
        TodoCustomFieldType.Dropdown => L["CustomField_Type_Dropdown"],
        TodoCustomFieldType.MultiSelect => L["CustomField_Type_MultiSelect"],
        TodoCustomFieldType.Date => L["CustomField_Type_Date"],
        TodoCustomFieldType.Checkbox => L["CustomField_Type_Checkbox"],
        TodoCustomFieldType.TaskTitleSelect => L["CustomField_Type_TaskTitleSelect"],
        _ => L["CustomField_Type_Text"]
    };

    private string SourceListName(Guid? listId)
        => listId is null
            ? L["CustomField_SourceList_NotSelected"]
            : (AvailableLists ?? []).FirstOrDefault(list => list.Id == listId)?.Name ?? L["CustomField_SourceList_NotAvailable"];

    private bool CanAdmin(TodoListEntity list)
        => string.Equals(list.OwnerId, UserId, StringComparison.OrdinalIgnoreCase)
           || (list.Participants?.Any(p =>
               (string.Equals(p.UserId, UserId, StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Email, UserId, StringComparison.OrdinalIgnoreCase))
               && p.Role == ListRole.Admin) == true);

    private sealed class OptionEditorState
    {
        public List<string> Options { get; } = [];
        public string Draft { get; set; } = "";
        public int? EditingIndex { get; set; }
        public string EditDraft { get; set; } = "";

        public void Load(IEnumerable<string> options)
        {
            Options.Clear();
            Options.AddRange(options
                .Select(option => (option ?? "").Trim())
                .Where(option => !string.IsNullOrWhiteSpace(option))
                .Distinct(StringComparer.OrdinalIgnoreCase));
            Draft = "";
            EditingIndex = null;
            EditDraft = "";
        }

        public void Reset()
        {
            Options.Clear();
            Draft = "";
            EditingIndex = null;
            EditDraft = "";
        }
    }
}
