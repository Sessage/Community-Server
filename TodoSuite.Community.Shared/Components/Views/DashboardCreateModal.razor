@if (IsOpen)
{
    <FluentDialog id="dashboard-create-dlg" Open="true" Modal="true" Style="width:min(560px,92vw);" TrapFocus="true" HiddenChanged="@(_ => OnClose.InvokeAsync())">
        <FluentDialogHeader>
            <div class="font-semibold text-lg">@L["Dashboard_Create_Title"]</div>
        </FluentDialogHeader>
        <FluentDialogBody>
            <input class="w-full rounded-xl border border-slate-200 p-2"
                   value="@_name"
                   @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                   placeholder="@L["Dashboard_Name"]" />
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Outline" OnClick="OnClose">@L["Dialog_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="HandleCreate">@L["Dialog_Create"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string DefaultName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnCreate { get; set; }

    private string _name = string.Empty;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
            _name = DefaultName;
        _wasOpen = IsOpen;
    }

    private Task HandleCreate() => OnCreate.InvokeAsync(_name);
}
