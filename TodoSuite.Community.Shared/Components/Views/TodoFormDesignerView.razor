    private RenderFragment RenderPreviewInput(TodoFormFieldEntity field) => builder =>
    {
        var seq = 0;
        var css = "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm";
        var custom = (List?.CustomFields ?? []).FirstOrDefault(f => f.Id == field.CustomFieldId);
        if (field.StandardField == TodoFormStandardField.Attachments)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "break-words text-xs font-medium text-slate-500");
            AddPreviewFieldLabelContent(builder, ref seq, field);
            builder.CloseElement();
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", css);
            builder.AddAttribute(seq++, "type", "file");
            builder.AddAttribute(seq++, "multiple", true);
            builder.AddAttribute(seq++, "disabled", true);
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "text-xs text-slate-500");
            builder.AddContent(seq++, $"Erlaubt: {PreviewAttachmentTypesLabel}");
            builder.CloseElement();
            return;
        }

        if (field.StandardField == TodoFormStandardField.Description)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "break-words text-xs font-medium text-slate-500");
            AddPreviewFieldLabelContent(builder, ref seq, field);
            builder.CloseElement();
            builder.OpenElement(seq++, "textarea");
            builder.AddAttribute(seq++, "class", css);
            builder.AddAttribute(seq++, "disabled", true);
            builder.CloseElement();
            return;
        }

        if (field.StandardField is TodoFormStandardField.Column or TodoFormStandardField.Labels
            || custom?.Type is TodoCustomFieldType.Dropdown or TodoCustomFieldType.TaskTitleSelect)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "break-words text-xs font-medium text-slate-500");
            AddPreviewFieldLabelContent(builder, ref seq, field);
            builder.CloseElement();
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", css);
            builder.AddAttribute(seq++, "disabled", true);
            builder.OpenElement(seq++, "option");
            builder.AddContent(seq++, L["PublicForm_SelectPlaceholder"]);
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (custom?.Type == TodoCustomFieldType.MultiSelect)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "break-words text-xs font-medium text-slate-500");
            AddPreviewFieldLabelContent(builder, ref seq, field);
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "space-y-1 rounded-lg border border-slate-200 bg-white p-2");
            foreach (var option in custom.Options.OrderBy(o => o.SortOrder))
            {
                builder.OpenElement(seq++, "label");
                builder.AddAttribute(seq++, "class", "flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-slate-700");
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "h-4 w-4 rounded border-slate-300");
                builder.AddAttribute(seq++, "disabled", true);
                builder.AddAttribute(seq++, "type", "checkbox");
                builder.CloseElement();
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "min-w-0 truncate");
                builder.AddContent(seq++, option.Value);
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }

        if (field.StandardField == TodoFormStandardField.IsImportant || custom?.Type == TodoCustomFieldType.Checkbox)
        {
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "inline-flex items-start gap-2 break-words text-sm font-medium text-slate-700");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300");
            builder.AddAttribute(seq++, "disabled", true);
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "min-w-0 leading-5");
            AddPreviewFieldLabelContent(builder, ref seq, field);
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "break-words text-xs font-medium text-slate-500");
        AddPreviewFieldLabelContent(builder, ref seq, field);
        builder.CloseElement();
        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "class", css);
        builder.AddAttribute(seq++, "disabled", true);
        builder.AddAttribute(seq++, "type", PreviewInputType(field, custom));
        builder.CloseElement();
    };

    private static void AddPreviewFieldLabelContent(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq, TodoFormFieldEntity field)
    {
        builder.AddContent(seq++, LinkifiedText.ToMarkupString(DisplayLabel(field)));
        if (!field.IsRequired)
            return;

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "text-red-600");
        builder.AddContent(seq++, "*");
        builder.CloseElement();
    }

    private static string PreviewInputType(TodoFormFieldEntity field, TodoCustomFieldDefinitionEntity? custom)
    {
        if (field.StandardField == TodoFormStandardField.IsImportant || custom?.Type == TodoCustomFieldType.Checkbox)
            return "checkbox";
        if (field.ValidationRules.Any(r => r.Type == TodoFormFieldValidationType.Email))
            return "email";
        if (custom?.Type == TodoCustomFieldType.Date
            || field.StandardField is TodoFormStandardField.StartDate or TodoFormStandardField.DueDate
            || field.ValidationRules.Any(r => r.Type is TodoFormFieldValidationType.DateAfter or TodoFormFieldValidationType.DateBefore or TodoFormFieldValidationType.DateOnOrAfter or TodoFormFieldValidationType.DateOnOrBefore))
            return "date";
        if (custom?.Type == TodoCustomFieldType.Number || field.ValidationRules.Any(r => r.Type is TodoFormFieldValidationType.Number or TodoFormFieldValidationType.Integer))
            return "number";
        return "text";
    }

    private static string StandardKey(TodoFormStandardField field) => $"standard:{field}";
    private static string CustomKey(Guid fieldId) => $"custom:{fieldId:N}";
    private static string FieldKey(TodoFormFieldEntity field)
        => field.Source == TodoFormFieldSource.Standard && field.StandardField.HasValue
            ? StandardKey(field.StandardField.Value)
            : field.Source == TodoFormFieldSource.Custom && field.CustomFieldId.HasValue
                ? CustomKey(field.CustomFieldId.Value)
                : "";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadVersion++;
        _selectionVersion++;
        if (_sortableInitialized)
        {
            try { await JS.InvokeVoidAsync("todoUi.disposeFormDesignerSortable", _designerListRef); } catch { }
        }

        _selfRef?.Dispose();
    }

    private sealed record AvailableFormField(string Key, string Label, TodoFormFieldSource Source, TodoFormStandardField? StandardField, Guid? CustomFieldId);
    private sealed record AttachmentTypeOption(TodoFormAttachmentType Type, string Label);
}
