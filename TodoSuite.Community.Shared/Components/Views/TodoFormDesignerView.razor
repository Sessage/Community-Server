    public Task SetFormDesignerDragging(bool dragging)
    {
        _isDraggingFromSortable = dragging;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnFormDesignerDragEnded(string[] ids)
    {
        _isDraggingFromSortable = false;
        ApplyFieldOrder(ids, rebuildHost: true, requestRender: false);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ApplyFieldOrderFromJs(string[] ids)
    {
        ApplyFieldOrder(ids, rebuildHost: true, requestRender: false);
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyFieldOrder(string[] ids, bool rebuildHost, bool requestRender)
    {
        if (_selectedForm is null) return;

        var fieldsById = _selectedForm.Fields.ToDictionary(f => f.Id);
        var orderedIds = ids
            .Select(id => Guid.TryParse(id, out var guid) ? guid : Guid.Empty)
            .Where(id => id != Guid.Empty && fieldsById.ContainsKey(id))
            .Distinct()
            .ToList();

        if (orderedIds.Count == 0)
            return;

        var orderedFields = orderedIds
            .Select(id => fieldsById[id])
            .Concat(_selectedForm.Fields
                .OrderBy(f => f.SortOrder)
                .Where(f => !orderedIds.Contains(f.Id)))
            .ToList();

        for (var i = 0; i < orderedFields.Count; i++)
            orderedFields[i].SortOrder = i;

        _selectedForm.Fields = orderedFields;

        if (rebuildHost)
        {
            _sortableInitialized = false;
            _designerHostVersion++;
        }

        if (requestRender)
            _ = InvokeAsync(StateHasChanged);
    }

    private void RenumberFields()
    {
        if (_selectedForm is null) return;
        var ordered = _selectedForm.Fields.OrderBy(f => f.SortOrder).ToList();
        _selectedForm.Fields = ordered.Select((f, index) =>
        {
            f.SortOrder = index;
            return f;
        }).ToList();
    }

