    private void ApplyReminderLocalToTask()
    {
        if (_editableTask is null) return;

        _showReminderSection = true;

        if (_reminderLocalDate is null)
        {
            _editableTask.ReminderAtUtc = null;
            ScheduleAutosave(200);
            SyncSectionVisibilityFromData();
            return;
        }

        if (!TimeSpan.TryParse(_reminderLocalTime, out var t))
            t = new TimeSpan(9, 0, 0);

        var local = _reminderLocalDate.Value.Date.Add(t);
        _editableTask.ReminderAtUtc = DateTime.SpecifyKind(local.AddMinutes(-_browserUtcOffsetMinutes), DateTimeKind.Utc);
        ScheduleAutosave(200);
        SyncSectionVisibilityFromData();
    }

    private void SyncReminderFieldsFromUtc(DateTime? reminderAtUtc)
    {
        if (reminderAtUtc is null)
        {
            _reminderLocalDate = null;
            _reminderLocalTime = "09:00";
            return;
        }

        var local = reminderAtUtc.Value.AddMinutes(_browserUtcOffsetMinutes);
        _reminderLocalDate = local.Date;
        _reminderLocalTime = local.ToString("HH:mm");
    }

    // Kommentare
    private string GetCommentDateLabel(DateTime localDate)
    {
        var today = DateTime.UtcNow.AddMinutes(_browserUtcOffsetMinutes).Date;
        if (localDate == today) return "Heute";
        if (localDate == today.AddDays(-1)) return "Gestern";

        var culture = new System.Globalization.CultureInfo("de-DE");
        string dayAbbr = culture.DateTimeFormat.GetAbbreviatedDayName(localDate.DayOfWeek);
        string month = culture.DateTimeFormat.GetMonthName(localDate.Month);
        return $"{dayAbbr}. {localDate.Day}. {month} {localDate.Year}";
    }

    private DateTime ToBrowserLocalTime(DateTime utcOrLocal)
    {
        var utc = utcOrLocal.Kind == DateTimeKind.Local
            ? utcOrLocal.ToUniversalTime()
            : DateTime.SpecifyKind(utcOrLocal, DateTimeKind.Utc);

        return utc.AddMinutes(_browserUtcOffsetMinutes);
    }

    private bool IsOwnComment(TodoCommentEntity comment)
    {
        var author = (comment.Author ?? "").Trim();
        return !string.IsNullOrWhiteSpace(author)
               && (EqualsUserKey(author, _currentUserDisplayName)
                   || EqualsUserKey(author, _userId));
    }

    private static bool EqualsUserKey(string? left, string? right)
        => !string.IsNullOrWhiteSpace(left)
           && !string.IsNullOrWhiteSpace(right)
           && string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);

