    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUser = await CurrentUserService.GetCurrentUserAsync();
            _userId = currentUser.UserId;
            _currentUserDisplayName = currentUser.DisplayName;
        }
        catch (Exception ex)
        {
