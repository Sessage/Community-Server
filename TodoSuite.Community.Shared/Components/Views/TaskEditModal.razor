    private void ScheduleAutosave(int debounceMs = 500)
    {
        if (_editableTask is null) return;
        if (_suppressAutosave) return;

        _dirty = true;
        _editRevision++;

        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = new CancellationTokenSource();
        var token = _autosaveCts.Token;

        var revisionAtSchedule = _editRevision;

        _ = global::System.Threading.Tasks.Task.Run(async () =>
        {
            try
            {
                await global::System.Threading.Tasks.Task.Delay(debounceMs, token);
                if (token.IsCancellationRequested) return;
                if (_isDisposed) return;

                if (revisionAtSchedule != _editRevision) return;

                await InvokeAsync(SaveTaskInternalAsync);
            }
            catch (global::System.Threading.Tasks.TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    private void CancelPendingAutosave()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();
        _autosaveCts = null;
    }

    private async Task SaveTaskInternalAsync()
    {
        if (_editableTask is null) return;
        if (!_dirty) return;
        if (_isDisposed) return;

        var gateEntered = false;

        try
        {
            await _saveGate.WaitAsync();
            gateEntered = true;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _saveInProgress = true;

        try
        {
            _error = "";

            var saveRevision = _editRevision;
            var snapshot = CloneTask(_editableTask);

            snapshot.MemberUserIds ??= new List<string>();
            snapshot.MemberUserIds = snapshot.MemberUserIds
                .Select(x => (x ?? "").Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Where(x => !LooksLikeEmail(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var updated = await TaskService.UpdateTaskAsync(_userId, ListId, snapshot);

            if (updated is not null && saveRevision == _editRevision)
            {
                _suppressAutosave = true;
                _editableTask = CloneTask(updated);
                // Some service implementations update task members separately and can return
                // a response whose navigation collection still reflects the pre-save state.
                // The successfully submitted snapshot is authoritative for this edit revision.
                _editableTask.MemberUserIds = snapshot.MemberUserIds.ToList();
                _suppressAutosave = false;

                _dirty = false;

                SyncSectionVisibilityFromData();

                if (OnTaskUpdated.HasDelegate)
                    await OnTaskUpdated.InvokeAsync(updated);
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_TaskSave"].Value, ex.Message);
        }
        finally
        {
            _saveInProgress = false;
            if (gateEntered)
                _saveGate.Release();
        }
    }

