    private async Task LoadAssigneeOptionsAsync()
    {
        try
        {
            var list = List?.Id == ListId
                ? List
                : await ListService.GetListAsync(_userId, ListId);

            var assigneeOptions = new List<AssigneeOption>();
            var memberOptions = new List<MemberOption>();

            if (list is not null)
            {
                var candidates = new List<ListParticipantEntity>();
                if (list.Participants is not null)
                    candidates.AddRange(list.Participants);

                var normalized = candidates
                    .Where(p => !string.IsNullOrWhiteSpace(p.UserId) && !LooksLikeEmail(p.UserId))
                    .GroupBy(p => p.UserId!, StringComparer.OrdinalIgnoreCase)
                    .Select(g =>
                    {
                        var p = g.First();
                        var label = !string.IsNullOrWhiteSpace(p.DisplayName) ? p.DisplayName : (p.Email ?? p.UserId!);
                        return (UserId: p.UserId!, Display: label);
                    })
                    .OrderBy(x => x.Display, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                assigneeOptions = normalized.Select(x => new AssigneeOption(x.UserId, x.Display)).ToList();
                memberOptions = normalized.Select(x => new MemberOption(x.UserId, x.Display)).ToList();
            }

            _assigneeOptions = assigneeOptions;
            _memberOptions = memberOptions;

            if (_editableTask is not null &&
                !string.IsNullOrWhiteSpace(_editableTask.Assignee) &&
                LooksLikeEmail(_editableTask.Assignee))
            {
                _editableTask.Assignee = null;
            }

            if (_editableTask is not null)
            {
                _editableTask.MemberUserIds ??= new List<string>();
                var allowed = _memberOptions
                    .Select(x => x.UserId)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

                _editableTask.MemberUserIds = _editableTask.MemberUserIds
                    .Select(x => (x ?? "").Trim())
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Where(x => !LooksLikeEmail(x))
                    .Where(x => allowed.Contains(x))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            SyncSectionVisibilityFromData();

            await InvokeAsync(StateHasChanged);

            var listsAll = await ListService.GetListOptionsAsync(_userId);

            _listOptions = listsAll
                .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
                .Select(l => new ListOption(l.Id, l.Name))
                .ToList();
        }
        catch
        {
            // bewusst still
        }
    }

    private static bool LooksLikeEmail(string? s)
        => !string.IsNullOrWhiteSpace(s) && s.Contains('@');

