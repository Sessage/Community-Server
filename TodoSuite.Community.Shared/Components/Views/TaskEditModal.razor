    private void ApplyRequestedTab()
    {
        var target = NormalizeTabId(InitialTabId);
        if (_appliedInitialTabVersion == InitialTabVersion
            && string.Equals(_appliedInitialTabId, target, StringComparison.OrdinalIgnoreCase))
            return;

        _appliedInitialTabId = target;
        _appliedInitialTabVersion = InitialTabVersion;
        SetActiveTab(target, scrollToTop: false);
    }

    private static string NormalizeTabId(string? tabId)
        => tabId?.Trim().ToLowerInvariant() switch
        {
            "comments" or "tab-2" => "comments",
            "attachments" or "tab-3" => "attachments",
            _ => "details"
        };

    private static PanelTab TabIdToPanelTab(string? tabId)
        => NormalizeTabId(tabId) switch
        {
            "comments" => PanelTab.Comments,
            "attachments" => PanelTab.Attachments,
            _ => PanelTab.Details
        };

    private void SetActiveTab(string? tabId, bool scrollToTop)
    {
        var normalized = NormalizeTabId(tabId);
        _tabIdBacking = normalized;
        _activeTab = TabIdToPanelTab(normalized);

        if (scrollToTop)
            _ = InvokeAsync(ScrollContentToTopAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await SyncOutsideClickCloseHookAsync(); } catch { }

        if (firstRender)
        {
            try
            {
                _browserUtcOffsetMinutes = await JS.InvokeAsync<int>("getBrowserUtcOffsetMinutes");

                // Reminder-Felder nach dem Laden des korrekten Offsets neu synchronisieren
                if (_editableTask?.ReminderAtUtc is not null)
                {
                    SyncReminderFieldsFromUtc(_editableTask.ReminderAtUtc);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { /* JS nicht verfügbar (z.B. Prerender) – Offset bleibt 0 */ }
        }
    }

