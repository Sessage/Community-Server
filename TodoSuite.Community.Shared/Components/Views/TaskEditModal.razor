    // Anhänge
    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _error = "";
        _uploadErrors.Clear();
        if (_editableTask is null) return;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(100);
        }
        catch (InvalidOperationException)
        {
            _error = L["Err_TooManyFiles"].Value;
            return;
        }

        if (files.Count == 0) return;

        _isUploading = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                if (_isDisposed) break;
                var fileError = await UploadOneAsync(file);
                if (fileError is not null)
                    _uploadErrors.Add(fileError);
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_Upload"].Value, ex.Message);
        }
        finally
        {
            _isUploading = false;
            if (!_isDisposed)
                StateHasChanged();
        }
    }

    private async Task<string?> UploadOneAsync(IBrowserFile file)
    {
        if (_editableTask is null) return null;

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);

            var added = await AttachmentService.AddAttachmentAsync(
                _userId,
                ListId,
                _editableTask.Id,
                file.Name,
                stream);

            if (added is not null)
            {
                _editableTask.Attachments.Add(added);

                if (OnTaskUpdated.HasDelegate)
                    await OnTaskUpdated.InvokeAsync(_editableTask);
            }

            return null;
        }
        catch (IOException)
        {
            return string.Format(L["Err_UploadFileTooLarge"].Value, file.Name, MaxUploadBytes / 1024 / 1024);
        }
        catch (Exception ex)
        {
            return string.Format(L["Err_UploadFileFailed"].Value, file.Name, ex.Message);
        }
    }

    private async Task RemoveAttachmentAsync(TodoAttachmentEntity attachment)
    {
        _error = "";
        if (_editableTask is null) return;

        try
        {
            var ok = await AttachmentService.RemoveAttachmentAsync(_userId, ListId, _editableTask.Id, attachment.Id);
            if (ok)
            {
                _editableTask.Attachments.Remove(attachment);
                if (OnTaskUpdated.HasDelegate)
                    await OnTaskUpdated.InvokeAsync(_editableTask);
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_AttachmentRemove"].Value, ex.Message);
        }
    }

    private async Task DownloadAttachmentAsync(TodoAttachmentEntity attachment)
    {
        _error = "";
        if (_editableTask is null) return;

        try
        {
            var result = await AttachmentService.GetAttachmentStreamAsync(_userId, ListId, attachment.Id);
            if (result is null)
            {
                _error = L["Err_DownloadNotFound"].Value;
                return;
            }

            await using var stream = result.Value.Stream;
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("todoUi.downloadFileFromBase64", result.Value.FileName, "application/octet-stream", base64);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_Download"].Value, ex.Message);
        }
    }

    // Hub
    private async Task StartHubAsync()
    {
        try
        {
            _hubConnection = await HubConnectionFactory.CreateAsync();
            if (_hubConnection is null) return;

            _hubConnection.On<Guid, Guid>(TodoHub.TaskCommentsUpdated, async (listId, taskId) =>
            {
                if (_isDisposed) return;
                if (listId != ListId || _taskId != taskId) return;
                if (_saveInProgress || _dirty) return;
                try { await InvokeAsync(RefreshTaskAsync); } catch { }
            });

            _hubConnection.On<Guid, Guid>(TodoHub.TaskAttachmentsUpdated, async (listId, taskId) =>
            {
                if (_isDisposed) return;
                if (listId != ListId || _taskId != taskId) return;
                if (_saveInProgress || _dirty) return;
                try { await InvokeAsync(RefreshTaskAsync); } catch { }
            });

            await _hubConnection.StartAsync();
            await _hubConnection.SendAsync(TodoHub.SubscribeToUser, _userId);
            await _hubConnection.SendAsync(TodoHub.SubscribeToList, ListId);
        }
        catch
        {
            // Hub-Verbindung ist optional – App funktioniert auch ohne Echtzeit-Updates
        }
    }

    private async Task RefreshTaskAsync()
    {
        if (_taskId is null) return;
        if (_saveInProgress || _dirty) return;

        var list = await ListService.GetListAsync(_userId, ListId);
        var updated = list?.Tasks.FirstOrDefault(t => t.Id == _taskId);

        if (updated is not null)
        {
            _suppressAutosave = true;
            _editableTask = CloneTask(updated);

            _editableTask.MemberUserIds ??= new List<string>();
            _editableTask.MemberUserIds = _editableTask.MemberUserIds
                .Select(x => (x ?? "").Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Where(x => !LooksLikeEmail(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            // Reminder UI aktualisieren
            SyncReminderFieldsFromUtc(_editableTask.ReminderAtUtc);

            _suppressAutosave = false;

            SyncSectionVisibilityFromData();

            if (OnTaskUpdated.HasDelegate)
                await OnTaskUpdated.InvokeAsync(updated);

            StateHasChanged();
        }
    }

    private static TodoTaskEntity CloneTask(TodoTaskEntity task)
    {
        return new TodoTaskEntity
        {
            Id = task.Id,
            SyncToken = task.SyncToken,
            SyncVersion = task.SyncVersion,
            Title = task.Title,
            Description = task.Description,
            StartDate = task.StartDate,
            DueDate = task.DueDate,

            ReminderAtUtc = task.ReminderAtUtc,
            ReminderSentAtUtc = task.ReminderSentAtUtc,

            Done = task.Done,
            IsImportant = task.IsImportant,
            Assignee = task.Assignee,
            Recurrence = task.Recurrence,
            CustomRecurrence = task.CustomRecurrence,
            Column = task.Column,

            CardColor = task.CardColor,
            CardColorMode = task.CardColorMode,

            ListSortOrder = task.ListSortOrder,
            KanbanSortOrder = task.KanbanSortOrder,

            MemberUserIds = (task.MemberUserIds ?? new List<string>())
                .Select(x => (x ?? "").Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList(),

            Watchers = (task.Watchers ?? new List<TodoTaskWatcherEntity>())
                .Select(w => new TodoTaskWatcherEntity { Id = w.Id, TaskId = task.Id, UserId = w.UserId, CreatedAtUtc = w.CreatedAtUtc })
                .ToList(),

            LabelLinks = (task.LabelLinks ?? new List<TodoTaskLabelEntity>())
                .Select(x => new TodoTaskLabelEntity { TaskId = task.Id, LabelId = x.LabelId })
                .ToList(),

            Attachments = task.Attachments.Select(a => new TodoAttachmentEntity { Id = a.Id, FileName = a.FileName, Url = a.Url }).ToList(),
            Steps = (task.Steps ?? new List<TodoStepEntity>())
            .Select(s => new TodoStepEntity { Id = s.Id, Title = s.Title, IsCompleted = s.IsCompleted })
            .ToList(),
            Comments = task.Comments.Select(c => new TodoCommentEntity { Id = c.Id, Message = c.Message, Author = c.Author, CreatedAt = c.CreatedAt }).ToList()
            ,
            CustomFieldValues = (task.CustomFieldValues ?? new List<TodoTaskCustomFieldValueEntity>())
                .Select(v => new TodoTaskCustomFieldValueEntity { Id = v.Id, TaskId = task.Id, FieldId = v.FieldId, Value = v.Value })
                .ToList()
        };
    }

    private string GetCustomFieldValue(Guid fieldId)
        => _editableTask?.CustomFieldValues?.FirstOrDefault(v => v.FieldId == fieldId)?.Value ?? "";

    private IReadOnlyList<string> GetCustomFieldMultiSelectValues(Guid fieldId)
        => CustomFieldMultiSelectValues.Parse(GetCustomFieldValue(fieldId));

    private void OnCustomFieldChanged(TodoCustomFieldDefinitionEntity field, object? rawValue)
    {
        if (_editableTask is null) return;
        _editableTask.CustomFieldValues ??= new List<TodoTaskCustomFieldValueEntity>();

        var value = field.Type == TodoCustomFieldType.Checkbox
            ? ((rawValue is bool b && b) ? "true" : "false")
            : rawValue?.ToString();

        var existing = _editableTask.CustomFieldValues.FirstOrDefault(v => v.FieldId == field.Id);
        if (existing is null)
        {
            _editableTask.CustomFieldValues.Add(new TodoTaskCustomFieldValueEntity
            {
                Id = Guid.Empty,
                TaskId = _editableTask.Id,
                FieldId = field.Id,
                Value = value
            });
        }
        else
        {
            existing.Value = value;
        }

        ScheduleAutosave(200);
        SyncSectionVisibilityFromData();
    }

    private void OnCustomFieldMultiSelectChanged(TodoCustomFieldDefinitionEntity field, string option, bool selected)
        => OnCustomFieldChanged(field, CustomFieldMultiSelectValues.Toggle(GetCustomFieldValue(field.Id), option, selected));

    private static string CustomFieldInputType(TodoCustomFieldType type) => type switch
    {
        TodoCustomFieldType.Number => "number",
        TodoCustomFieldType.Date => "date",
        _ => "text"
    };

    private async Task DeleteTaskWithConfirmAsync()
    {
        _error = "";
        if (_editableTask is null) return;

        try
        {
            var ok = await ShowConfirmDialogAsync(
                L["Task_DeleteTask"].Value,
                "Aufgabe wirklich löschen?",
                _editableTask.Title,
                "Löschen",
                Appearance.Accent);
            if (!ok) return;

            CancelPendingAutosave();
            _dirty = false;

            var deleted = await TaskService.DeleteTaskAsync(_userId, ListId, _editableTask.Id);
            if (!deleted)
            {
                _error = L["Err_TaskDeleteNotFound"].Value;
                return;
            }

            if (OnListChanged.HasDelegate)
                await OnListChanged.InvokeAsync();

            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_TaskDelete"].Value, ex.Message);
        }
    }

    private async Task ToggleDoneAsync(TodoTaskEntity t)
    {
        _error = "";
        t.Done = !t.Done;
        _dirty = true;
        await SaveTaskInternalAsync();
    }

    private async Task ToggleImportantAsync(TodoTaskEntity t)
    {
        _error = "";
        t.IsImportant = !t.IsImportant;
        _dirty = true;
        await SaveTaskInternalAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        try
        {
            _autosaveCts?.Cancel();
            _autosaveCts?.Dispose();
        }
        catch { }

        if (_outsideClickHookActive)
        {
            try { await JS.InvokeVoidAsync("todoUi.disableDialogOutsideCloseById", _dialogDomId); } catch { }
            _outsideClickHookActive = false;
        }

        if (_hubConnection is not null)
        {
            try { await _hubConnection.DisposeAsync(); } catch { }
        }

        try { _selfRef?.Dispose(); } catch { }
    }
}
