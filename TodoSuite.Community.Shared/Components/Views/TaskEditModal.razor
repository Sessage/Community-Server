    /* Dialog Menu */
    private bool _actionsOpen = false;

    private void ToggleActions() => _actionsOpen = !_actionsOpen;

    private void CloseActionsIfOpen()
    {
        if (_actionsOpen)
        {
            _actionsOpen = false;
            StateHasChanged();
        }
    }

    // Move dialog
    private bool _moveDialogOpen = false;
    private bool _confirmDialogOpen;
    private string _confirmTitle = "";
    private string _confirmMessage = "";
    private string _confirmTaskTitle = "";
    private string _confirmActionText = "";
    private Appearance _confirmAppearance = Appearance.Accent;
    private TaskCompletionSource<bool>? _confirmTcs;

    private async Task OpenMoveDialog()
    {
        _actionsOpen = false;
        if (_listOptions.Count == 0 || !_listsCache.ContainsKey(ListId))
            await LoadMoveListOptionsAsync();

        if (_moveTargetListId == Guid.Empty)
            _moveTargetListId = ListId;

        if (string.IsNullOrWhiteSpace(_moveTargetColumn))
            _moveTargetColumn = _editableTask?.Column ?? "";

        OnMoveTargetListChanged(_moveTargetListId);
        _moveDialogOpen = true;
    }

    private void CloseMoveDialog() => _moveDialogOpen = false;

    private void OnMoveDialogHiddenChanged(bool hidden)
    {
        if (hidden)
            CloseMoveDialog();
    }

    private void OnConfirmDialogHiddenChanged(bool hidden)
    {
        if (hidden)
            CancelConfirmDialog();
    }

    private Task<bool> ShowConfirmDialogAsync(string title, string message, string? taskTitle, string actionText, Appearance appearance)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmTaskTitle = taskTitle ?? "";
        _confirmActionText = actionText;
        _confirmAppearance = appearance;
        _confirmTcs = new TaskCompletionSource<bool>();
        _confirmDialogOpen = true;
        StateHasChanged();
        return _confirmTcs.Task;
    }

    private void CancelConfirmDialog()
    {
        _confirmDialogOpen = false;
        _confirmTcs?.TrySetResult(false);
        _confirmTcs = null;
    }

    private Task ConfirmDialogAsync()
    {
        _confirmDialogOpen = false;
        _confirmTcs?.TrySetResult(true);
        _confirmTcs = null;
        return global::System.Threading.Tasks.Task.CompletedTask;
    }

    /* Aufgabe zwischen Listen verschieben */
    private sealed record ListOption(Guid Id, string Name);
    private List<ListOption> _listOptions = new();
    private Guid _moveTargetListId;
    private string _moveTargetColumn = "";
    private FloatingDropdown? _moveListDropdown;
    private FloatingDropdown? _moveColumnDropdown;

    private string MoveTargetListLabel
        => _listOptions.FirstOrDefault(x => x.Id == _moveTargetListId)?.Name ?? "Liste auswählen";

    private string MoveTargetColumnLabel
        => string.IsNullOrWhiteSpace(_moveTargetColumn) ? "Spalte auswählen" : _moveTargetColumn;

    private bool IsMoveTargetDifferentList
        => _moveTargetListId != Guid.Empty && _moveTargetListId != ListId;

    private static string MoveDropdownItemCss(bool selected)
        => $"block w-full px-3 py-2 text-left hover:bg-slate-50 {(selected ? "bg-blue-50 text-blue-700" : "text-slate-700")}";

    private async Task SelectMoveTargetListAsync(Guid id)
    {
        OnMoveTargetListChanged(id);
        if (_moveListDropdown is not null)
            await _moveListDropdown.CloseAsync();
    }

    private async Task SelectMoveTargetColumnAsync(string column)
    {
        OnMoveTargetColumnChanged(column);
        if (_moveColumnDropdown is not null)
            await _moveColumnDropdown.CloseAsync();
    }

    private void OnMoveTargetListChanged(Guid v)
    {
        _moveTargetListId = v;

        var cols = GetMoveColumnOptions().ToList();
        if (cols.Count == 0)
            _moveTargetColumn = _editableTask?.Column ?? "";
        else if (cols.Any(c => c.Equals(_moveTargetColumn ?? "", StringComparison.OrdinalIgnoreCase)))
            _moveTargetColumn = cols.First(c => c.Equals(_moveTargetColumn ?? "", StringComparison.OrdinalIgnoreCase));
        else
            _moveTargetColumn = cols[0];

        StateHasChanged();
    }

    private void OnMoveTargetColumnChanged(string? v)
    {
        _moveTargetColumn = (v ?? "").Trim();
        StateHasChanged();
    }

    private IEnumerable<string> GetMoveColumnOptions()
    {
        return _listsCache.TryGetValue(_moveTargetListId, out var cols)
            ? cols
            : Columns;
    }

    private readonly Dictionary<Guid, List<string>> _listsCache = new();

    private async Task WarmListsCacheAsync()
    {
        try
        {
            var lists = await ListService.GetListOptionsAsync(_userId);
            _listsCache.Clear();

            foreach (var l in lists)
                _listsCache[l.Id] = (l.Columns ?? new List<string>()).ToList();
        }
        catch { }
    }

    private async Task LoadMoveListOptionsAsync()
    {
        var lists = await ListService.GetListOptionsAsync(_userId);
        _listOptions = lists
            .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
            .Select(l => new ListOption(l.Id, l.Name))
            .ToList();

        _listsCache.Clear();
        foreach (var l in lists)
            _listsCache[l.Id] = (l.Columns ?? new List<string>()).ToList();
    }

    private async Task MoveTaskAsync()
    {
        _error = "";
        if (_editableTask is null) return;

        if (_moveTargetListId == Guid.Empty || _moveTargetListId == ListId)
            return;

        try
        {
            var ok = await ShowConfirmDialogAsync(
                L["Task_Move_Title"].Value,
                "Aufgabe wirklich verschieben?",
                _editableTask.Title,
                "Verschieben",
                Appearance.Accent);
            if (!ok) return;

            if (_dirty)
                await SaveTaskInternalAsync();

            CancelPendingAutosave();
            _dirty = false;

            var moved = await TaskService.MoveTaskToListAsync(
                _userId,
                fromListId: ListId,
                toListId: _moveTargetListId,
                taskId: _editableTask.Id,
                desiredTargetColumn: _moveTargetColumn);

            if (moved is null)
            {
                _error = L["Err_TaskDeleteNotFound"].Value;
                return;
            }

            moved.ListId = _moveTargetListId;
            if (!string.IsNullOrWhiteSpace(_moveTargetColumn))
                moved.Column = _moveTargetColumn;

            if (OnTaskMoved.HasDelegate)
                await OnTaskMoved.InvokeAsync(moved);
            else if (OnListChanged.HasDelegate)
                await OnListChanged.InvokeAsync();

            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_TaskMove"].Value, ex.Message);
        }
    }

    /* Member-Picker UI – rendered via FloatingDropdown (portal pattern) */
    private FloatingDropdown? _memberPickerDropdown;
    private string _memberSearch = "";

    private async Task CloseMemberPicker()
    {
        _memberSearch = "";
        if (_memberPickerDropdown is not null)
            await _memberPickerDropdown.CloseAsync();
    }

    private List<MemberOption> SelectedMemberOptions
    {
        get
        {
            if (_editableTask is null) return new();
            var ids = (_editableTask.MemberUserIds ?? new List<string>())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return _memberOptions
                .Where(o => ids.Contains(o.UserId))
                .OrderBy(o => o.Display, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private List<MemberOption> FilteredMemberOptions
    {
        get
        {
            var q = (_memberSearch ?? "").Trim();
            if (string.IsNullOrWhiteSpace(q))
                return _memberOptions.OrderBy(x => x.Display, StringComparer.OrdinalIgnoreCase).ToList();

            return _memberOptions
                .Where(x =>
                    (x.Display ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (x.UserId ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Display, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private static string MemberAvatarText(string? display)
    {
        var s = (display ?? "").Trim();
        if (string.IsNullOrWhiteSpace(s)) return "?";

        var parts = s.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();

        return s.Substring(0, 1).ToUpperInvariant();
    }

