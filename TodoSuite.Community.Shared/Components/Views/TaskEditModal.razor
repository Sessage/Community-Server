    private string ChipStyle(string? bg)
    {
        var background = string.IsNullOrWhiteSpace(bg) ? "#e2e8f0" : bg.Trim();
        var foreground = GetContrastingTextColor(background);

        return $"background:{background}; color:{foreground};";
    }

    private static string GetContrastingTextColor(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || !hex.StartsWith("#") || hex.Length != 7)
            return "#0f172a";

        try
        {
            var r = Convert.ToInt32(hex.Substring(1, 2), 16);
            var g = Convert.ToInt32(hex.Substring(3, 2), 16);
            var b = Convert.ToInt32(hex.Substring(5, 2), 16);

            var luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
            return luminance < 0.55 ? "#ffffff" : "#0f172a";
        }
        catch
        {
            return "#0f172a";
        }
    }

