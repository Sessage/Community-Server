    private int _browserUtcOffsetMinutes;

    private string _userId = "gast";
    private string _currentUserDisplayName = "";
    private string _error = "";
    private string? _appliedInitialTabId;
    private int _appliedInitialTabVersion = -1;

    private HubConnection? _hubConnection;

    /* Schritte */
    private bool _showAddStep = false;
    private string _newStepTitle = "";
    private Guid? _stepMenuOpenFor;

    /* Kommentare */
    private string _newCommentMessage = "";
    private bool _commentSubmitting;

    /* Upload */
    private ElementReference _scrollHost;
    private const long MaxUploadBytes = 25 * 1024 * 1024;
    private bool _isUploading = false;
    private readonly List<string> _uploadErrors = new();

    /* Lifecycle-Schutz */
    private bool _isDisposed = false;

    // Autosave
