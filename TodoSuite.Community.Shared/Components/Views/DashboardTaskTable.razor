<div class="rounded-2xl border border-slate-200 bg-white p-4 min-h-0 overflow-auto">
    <div class="text-sm text-slate-500 mb-2">@VisibleCount @L["Dashboard_Items"]</div>
    @foreach (var grouping in GroupedItems)
    {
        <div class="mb-4">
            <div class="font-semibold text-sm text-slate-700 mb-1">@grouping.Key</div>
            <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="text-left p-2">@L["Dashboard_Col_Task"]</th>
                        <th class="text-left p-2">@L["Dashboard_Col_List"]</th>
                        <th class="text-left p-2">@L["Dashboard_Col_Column"]</th>
                        <th class="text-left p-2">@L["Dashboard_Col_Due"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in grouping)
                    {
                        <tr class="border-t border-slate-100">
                            <td class="p-2">
                                <button type="button" class="text-left font-medium text-blue-700 hover:underline"
                                        @onclick="() => OnTaskSelected.InvokeAsync(item)">@item.Task.Title</button>
                            </td>
                            <td class="p-2">@item.List.Name</td>
                            <td class="p-2">@item.Task.Column</td>
                            <td class="p-2">@(item.Task.DueDate?.ToLocalTime().ToString("d") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<IGrouping<string, (TodoListEntity List, TodoTaskEntity Task)>> GroupedItems { get; set; }
        = Enumerable.Empty<IGrouping<string, (TodoListEntity List, TodoTaskEntity Task)>>();
    [Parameter] public int VisibleCount { get; set; }
    [Parameter] public EventCallback<(TodoListEntity List, TodoTaskEntity Task)> OnTaskSelected { get; set; }
}
