@using Klassenbibliothek.Data
@using Klassenbibliothek.Services
@inject IDirectorySharingService DirectorySharing

<div class="space-y-4">
    @if (!DirectorySharing.IsAvailable)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Verzeichnisfreigaben sind nicht verfügbar. Prüfe Enterprise-Lizenz und Active-Directory-Konfiguration.</div>
    }
    else
    {
        <div class="flex flex-col md:flex-row md:items-end gap-2">
            <div class="flex-1">
                <div class="text-sm text-slate-700 mb-1">AD-Benutzer oder AD-Gruppe</div>
                <input class="w-full rounded-xl border border-slate-200 p-2 bg-white" @bind="_query" @bind:event="oninput" placeholder="Mindestens 2 Zeichen eingeben …" />
            </div>
            <FluentButton Appearance="Appearance.Neutral" Disabled="_busy" OnClick="SearchAsync">Suchen</FluentButton>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="text-sm @(_error ? "text-red-700" : "text-emerald-700")">@_message</div>
        }
        @foreach (var principal in _results)
        {
            <div class="flex flex-col md:flex-row md:items-center gap-2 rounded-xl border border-slate-200 p-3">
                <div class="min-w-0 flex-1"><div class="font-semibold truncate">@principal.DisplayName</div><div class="text-xs text-slate-600 truncate">@(principal.Type == DirectoryPrincipalType.Group ? "AD-Gruppe" : "AD-Benutzer") · @(principal.UserPrincipalName ?? principal.Id)</div></div>
                <select class="rounded-xl border border-slate-200 p-2 bg-white" @bind="_newRole"><option value="@ListRole.Observer">Beobachter</option><option value="@ListRole.Member">Mitglied</option><option value="@ListRole.Admin">Admin</option></select>
                <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="() => GrantAsync(principal)">Berechtigen</FluentButton>
            </div>
        }

        <div class="pt-2 space-y-2">
            <div class="text-xs uppercase tracking-wide text-slate-500">Berechtigte Verzeichniseinträge</div>
            @foreach (var grant in _grants)
            {
                <div class="flex flex-col md:flex-row md:items-center gap-2 rounded-xl border border-slate-200 p-3">
                    <div class="min-w-0 flex-1"><div class="font-semibold truncate">@grant.DisplayName</div><div class="text-xs text-slate-600">@(grant.PrincipalType == DirectoryPrincipalType.Group ? "AD-Gruppe" : "AD-Benutzer")</div></div>
                    <select class="rounded-xl border border-slate-200 p-2 bg-white" disabled="@_busy" value="@grant.Role" @onchange="e => ChangeRoleAsync(grant, e)"><option value="@ListRole.Observer">Beobachter</option><option value="@ListRole.Member">Mitglied</option><option value="@ListRole.Admin">Admin</option></select>
                    <FluentButton Appearance="Appearance.Outline" Disabled="_busy" OnClick="() => RemoveAsync(grant.Id)">Entfernen</FluentButton>
                </div>
            }
            @if (_grants.Count == 0) { <div class="text-sm text-slate-600">Noch keine Verzeichnisfreigaben.</div> }
        </div>
    }
</div>

@code {
    [Parameter] public DirectoryShareResourceType ResourceType { get; set; }
    [Parameter] public Guid ResourceId { get; set; }
    [Parameter] public string RequestingUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }
    private string _query = string.Empty, _message = string.Empty;
    private bool _busy, _error;
    private int _loadVersion;
    private ListRole _newRole = ListRole.Member;
    private IReadOnlyList<DirectoryPrincipal> _results = [];
    private IReadOnlyList<DirectoryShareGrantEntity> _grants = [];

    protected override async Task OnParametersSetAsync()
    {
        var loadVersion = ++_loadVersion;
        if (ResourceId == Guid.Empty || !DirectorySharing.IsAvailable)
        {
            _grants = [];
            _results = [];
            return;
        }

        var resourceId = ResourceId;
        var resourceType = ResourceType;
        var requestingUserId = RequestingUserId;
        try
        {
            var grants = await DirectorySharing.GetGrantsAsync(requestingUserId, resourceType, resourceId);
            if (loadVersion == _loadVersion)
                _grants = grants;
        }
        catch (Exception ex)
        {
            if (loadVersion == _loadVersion)
                ShowResult(false, ex.Message);
        }
    }

    private async Task SearchAsync()
    {
        var query = _query.Trim();
        ClearMessage();
        if (query.Length < 2)
        {
            ShowResult(false, "Bitte mindestens zwei Zeichen eingeben.");
            return;
        }

        _busy = true;
        try
        {
            _results = await DirectorySharing.SearchAsync(RequestingUserId, ResourceType, ResourceId, query);
            if (_results.Count == 0)
                ShowResult(true, "Keine passenden Einträge gefunden.");
        }
        catch (Exception ex)
        {
            ShowResult(false, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GrantAsync(DirectoryPrincipal principal)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.GrantAsync(RequestingUserId, ResourceType, ResourceId, principal, _newRole);
            ShowResult(result.Success, result.Message);
            if (result.Success)
                await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowResult(false, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeRoleAsync(DirectoryShareGrantEntity grant, ChangeEventArgs e)
    {
        if (_busy || !Enum.TryParse<ListRole>(e.Value?.ToString(), out var role)) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.UpdateRoleAsync(RequestingUserId, grant.Id, role);
            ShowResult(result.Success, result.Message);
            if (result.Success)
                await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowResult(false, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.RemoveAsync(RequestingUserId, id);
            ShowResult(result.Success, result.Message);
            if (result.Success)
                await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowResult(false, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        _grants = await DirectorySharing.GetGrantsAsync(RequestingUserId, ResourceType, ResourceId);
        await OnChanged.InvokeAsync();
    }

    private void ClearMessage()
    {
        _error = false;
        _message = string.Empty;
    }

    private void ShowResult(bool success, string message)
    {
        _error = !success;
        _message = message;
    }
}
