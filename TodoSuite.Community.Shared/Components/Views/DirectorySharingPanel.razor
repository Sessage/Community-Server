@using Klassenbibliothek.Data
@using Klassenbibliothek.Services
@implements IAsyncDisposable
@inject IDirectorySharingService DirectorySharing

<div class="space-y-4" aria-busy="@_busy">
    @if (!DirectorySharing.IsAvailable)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900" role="status">@L["Directory_Unavailable"]</div>
    }
    else
    {
        <form class="grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end"
              @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <div class="flex-1">
                <label for="directory-search" class="mb-1 block text-sm text-slate-700">@L["Directory_PrincipalLabel"]</label>
                <input id="directory-search" class="min-h-11 w-full rounded-xl border border-slate-200 bg-white p-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                       maxlength="200" autocomplete="off" disabled="@_busy"
                       @bind="_query" @bind:event="oninput" placeholder="@L["Directory_SearchPlaceholder"]" />
            </div>
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Neutral" Disabled="_busy">@L["Directory_Search"]</FluentButton>
        </form>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="text-sm @(_error ? "text-red-700" : "text-emerald-700")" role="status">@_message</div>
        }
        @foreach (var principal in _results)
        {
            <div class="grid grid-cols-1 gap-3 rounded-xl border border-slate-200 p-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center">
                <div class="min-w-0">
                    <div class="truncate font-semibold">@principal.DisplayName</div>
                    <div class="truncate text-xs text-slate-600">@PrincipalTypeLabel(principal.Type) · @(principal.UserPrincipalName ?? principal.Id)</div>
                    @if (!string.IsNullOrWhiteSpace(principal.Description))
                    {
                        <div class="mt-1 line-clamp-2 text-xs text-slate-500">@principal.Description</div>
                    }
                </div>
                <select class="min-h-11 w-full rounded-xl border border-slate-200 bg-white p-2 sm:w-auto" disabled="@_busy" @bind="_newRole" aria-label="@L["Lbl_Role"]">
                    <option value="@ListRole.Observer">@L["Participants_RoleObserver"]</option>
                    <option value="@ListRole.Member">@L["Participants_RoleMember"]</option>
                    <option value="@ListRole.Admin">@L["Participants_RoleAdmin"]</option>
                </select>
                <FluentButton Appearance="Appearance.Accent" Disabled="_busy" OnClick="() => GrantAsync(principal)">@L["Directory_Grant"]</FluentButton>
            </div>
        }

        <div class="pt-2 space-y-2">
            <div class="text-xs uppercase tracking-wide text-slate-500">@L["Directory_GrantedEntries"]</div>
            @foreach (var grant in _grants)
            {
                <div class="grid grid-cols-1 gap-3 rounded-xl border border-slate-200 p-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center">
                    <div class="min-w-0"><div class="truncate font-semibold">@grant.DisplayName</div><div class="truncate text-xs text-slate-600">@PrincipalTypeLabel(grant.PrincipalType)</div></div>
                    <select class="min-h-11 w-full rounded-xl border border-slate-200 bg-white p-2 sm:w-auto" disabled="@_busy" value="@grant.Role" @onchange="e => ChangeRoleAsync(grant, e)" aria-label="@L["Lbl_Role"]">
                        <option value="@ListRole.Observer">@L["Participants_RoleObserver"]</option>
                        <option value="@ListRole.Member">@L["Participants_RoleMember"]</option>
                        <option value="@ListRole.Admin">@L["Participants_RoleAdmin"]</option>
                    </select>
                    <FluentButton Appearance="Appearance.Outline" Disabled="_busy" OnClick="() => RemoveAsync(grant.Id)">@L["Btn_Remove"]</FluentButton>
                </div>
            }
            @if (_grants.Count == 0) { <div class="text-sm text-slate-600">@L["Directory_None"]</div> }
        </div>
    }
</div>

@code {
    [Parameter] public DirectoryShareResourceType ResourceType { get; set; }
    [Parameter] public Guid ResourceId { get; set; }
    [Parameter] public string RequestingUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }
    private string _query = string.Empty, _message = string.Empty;
    private bool _busy, _error;
    private int _loadVersion;
    private Guid _loadedResourceId;
    private DirectoryShareResourceType _loadedResourceType;
    private string _loadedRequestingUserId = string.Empty;
    private CancellationTokenSource? _contextCts;
    private bool _disposed;
    private ListRole _newRole = ListRole.Member;
    private IReadOnlyList<DirectoryPrincipal> _results = [];
    private IReadOnlyList<DirectoryShareGrantEntity> _grants = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedResourceId == ResourceId
            && _loadedResourceType == ResourceType
            && string.Equals(_loadedRequestingUserId, RequestingUserId, StringComparison.Ordinal))
            return;

        _loadedResourceId = ResourceId;
        _loadedResourceType = ResourceType;
        _loadedRequestingUserId = RequestingUserId;
        var contextCts = ReplaceContextCancellation();
        var loadVersion = ++_loadVersion;
        _query = string.Empty;
        _message = string.Empty;
        _error = false;
        _busy = false;
        _grants = [];
        _results = [];
        if (ResourceId == Guid.Empty || !DirectorySharing.IsAvailable)
            return;

        var resourceId = ResourceId;
        var resourceType = ResourceType;
        var requestingUserId = RequestingUserId;
        try
        {
            var grants = await DirectorySharing.GetGrantsAsync(requestingUserId, resourceType, resourceId, contextCts.Token);
            if (IsCurrentContext(loadVersion, contextCts))
                _grants = grants;
        }
        catch (OperationCanceledException) when (contextCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentContext(loadVersion, contextCts))
                ShowResult(false, ex.Message);
        }
    }

    private async Task SearchAsync()
    {
        var query = _query.Trim();
        ClearMessage();
        if (query.Length < 2)
        {
            ShowResult(false, L["Directory_MinimumQuery"]);
            return;
        }

        var loadVersion = _loadVersion;
        var contextCts = _contextCts;
        if (contextCts is null) return;
        _busy = true;
        try
        {
            var results = await DirectorySharing.SearchAsync(RequestingUserId, ResourceType, ResourceId, query, contextCts.Token);
            if (!IsCurrentContext(loadVersion, contextCts)) return;
            _results = results;
            if (results.Count == 0)
                ShowResult(true, L["Directory_NoResults"]);
        }
        catch (OperationCanceledException) when (contextCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentContext(loadVersion, contextCts)) ShowResult(false, ex.Message);
        }
        finally
        {
            if (IsCurrentContext(loadVersion, contextCts)) _busy = false;
        }
    }

    private async Task GrantAsync(DirectoryPrincipal principal)
    {
        if (_busy) return;
        var loadVersion = _loadVersion;
        var contextCts = _contextCts;
        if (contextCts is null) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.GrantAsync(RequestingUserId, ResourceType, ResourceId, principal, _newRole, contextCts.Token);
            if (!IsCurrentContext(loadVersion, contextCts)) return;
            ShowResult(result.Success, result.Success
                ? L[principal.Type == DirectoryPrincipalType.Group ? "Directory_GroupGranted" : "Directory_UserGranted"]
                : result.Message);
            if (result.Success)
            {
                _results = _results.Where(resultPrincipal => resultPrincipal != principal).ToArray();
                await ReloadAsync(loadVersion, contextCts);
            }
        }
        catch (OperationCanceledException) when (contextCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentContext(loadVersion, contextCts)) ShowResult(false, ex.Message);
        }
        finally
        {
            if (IsCurrentContext(loadVersion, contextCts)) _busy = false;
        }
    }

    private async Task ChangeRoleAsync(DirectoryShareGrantEntity grant, ChangeEventArgs e)
    {
        if (_busy || !Enum.TryParse<ListRole>(e.Value?.ToString(), out var role)) return;
        var loadVersion = _loadVersion;
        var contextCts = _contextCts;
        if (contextCts is null) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.UpdateRoleAsync(RequestingUserId, grant.Id, role, contextCts.Token);
            if (!IsCurrentContext(loadVersion, contextCts)) return;
            ShowResult(result.Success, result.Success ? L["Directory_RoleSaved"] : result.Message);
            if (result.Success)
                await ReloadAsync(loadVersion, contextCts);
        }
        catch (OperationCanceledException) when (contextCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentContext(loadVersion, contextCts)) ShowResult(false, ex.Message);
        }
        finally
        {
            if (IsCurrentContext(loadVersion, contextCts)) _busy = false;
        }
    }

    private async Task RemoveAsync(Guid id)
    {
        if (_busy) return;
        var loadVersion = _loadVersion;
        var contextCts = _contextCts;
        if (contextCts is null) return;
        _busy = true;
        try
        {
            var result = await DirectorySharing.RemoveAsync(RequestingUserId, id, contextCts.Token);
            if (!IsCurrentContext(loadVersion, contextCts)) return;
            ShowResult(result.Success, result.Success ? L["Directory_Removed"] : result.Message);
            if (result.Success)
                await ReloadAsync(loadVersion, contextCts);
        }
        catch (OperationCanceledException) when (contextCts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentContext(loadVersion, contextCts)) ShowResult(false, ex.Message);
        }
        finally
        {
            if (IsCurrentContext(loadVersion, contextCts)) _busy = false;
        }
    }

    private async Task ReloadAsync(int loadVersion, CancellationTokenSource contextCts)
    {
        var grants = await DirectorySharing.GetGrantsAsync(RequestingUserId, ResourceType, ResourceId, contextCts.Token);
        if (!IsCurrentContext(loadVersion, contextCts)) return;
        _grants = grants;
        await OnChanged.InvokeAsync();
    }

    private string PrincipalTypeLabel(DirectoryPrincipalType type) =>
        type == DirectoryPrincipalType.Group ? L["Directory_Group"] : L["Directory_User"];

    private CancellationTokenSource ReplaceContextCancellation()
    {
        var next = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _contextCts, next);
        try { previous?.Cancel(); } catch { }
        previous?.Dispose();
        return next;
    }

    private bool IsCurrentContext(int loadVersion, CancellationTokenSource contextCts) =>
        !_disposed && loadVersion == _loadVersion && ReferenceEquals(contextCts, _contextCts);

    private void ClearMessage()
    {
        _error = false;
        _message = string.Empty;
    }

    private void ShowResult(bool success, string message)
    {
        _error = !success;
        _message = message;
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_loadVersion;
        var contextCts = Interlocked.Exchange(ref _contextCts, null);
        try { contextCts?.Cancel(); } catch { }
        contextCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
