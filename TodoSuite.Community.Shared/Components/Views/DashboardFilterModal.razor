@if (IsOpen)
{
    <FluentDialog id="dashboard-filter-dlg" Open="true" Modal="true" Style="width:min(680px,92vw);" TrapFocus="true" HiddenChanged="@(_ => OnClose.InvokeAsync())">
        <FluentDialogHeader>
            <div class="flex items-center justify-between w-full">
                <div class="font-semibold text-lg">@L["Dashboard_FilterTitle"]</div>
                <button class="text-slate-400 hover:text-slate-700 text-xl leading-none px-1" @onclick="OnClose">✕</button>
            </div>
        </FluentDialogHeader>
        <FluentDialogBody>
            <div class="grid md:grid-cols-2 gap-3">
                <input class="rounded-xl border border-slate-200 p-2"
                       @bind="Draft.Query"
                       placeholder="@L["Dashboard_Search"]" />
                <select class="rounded-xl border border-slate-200 p-2" @bind="Draft.Done">
                    <option value="">@L["Dashboard_Status_All"]</option>
                    <option value="false">@L["Dashboard_Status_OpenOnly"]</option>
                    <option value="true">@L["Dashboard_Status_DoneOnly"]</option>
                </select>
            </div>
            <div class="mt-3 grid sm:grid-cols-3 gap-2 text-sm">
                <label><input type="checkbox" @bind="Draft.Overdue" /> @L["Dashboard_Filter_Overdue"]</label>
                <label><input type="checkbox" @bind="Draft.DueNextDay" /> @L["Dashboard_Filter_NextDay"]</label>
                <label><input type="checkbox" @bind="Draft.DueNextWeek" /> @L["Dashboard_Filter_NextWeek"]</label>
                <label><input type="checkbox" @bind="Draft.DueNextMonth" /> @L["Dashboard_Filter_NextMonth"]</label>
                <label><input type="checkbox" @bind="Draft.NoDueDate" /> @L["Dashboard_Filter_NoDue"]</label>
                <label><input type="checkbox" @bind="Draft.AssignedToMe" /> @L["Dashboard_Filter_AssignedToMe"]</label>
                <label><input type="checkbox" @bind="Draft.NoAssignee" /> @L["Dashboard_Filter_NoAssignee"]</label>
                <label><input type="checkbox" @bind="Draft.IsImportant" /> @L["Dashboard_Filter_Important"]</label>
            </div>
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Stealth" OnClick="OnClear">@L["Filter_Reset"]</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" OnClick="OnClose">@L["Dialog_Cancel"]</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="OnApply">@L["Filter_Apply"]</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DashboardFilter Draft { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
}
