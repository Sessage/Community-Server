@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="sticky rounded-xl top-0 z-30 shrink-0">
    <div class="py-2 px-4 grid grid-cols-[auto_1fr_auto] items-center gap-3 border-b border-slate-200 bg-white/95 backdrop-blur">

        <!-- Links: Dashboard-Switcher + Hinzufügen-Button -->
        <div class="flex items-center gap-1" @onclick:stopPropagation="true">
            @if (!IsFixedDashboard)
            {
            <FloatingDropdown @ref="_dashboardPicker" MinWidth="200">
                <ChildContent>
                    <button class="inline-flex items-center gap-1 rounded-lg px-2 py-1.5 text-sm text-slate-600 hover:bg-slate-100 transition-colors select-none max-w-[160px] overflow-hidden"
                            title="@L["Dashboard_Switch"]">
                        <span class="truncate">@(ActiveDashboard?.Name ?? L["Dashboard_NoneSelected"])</span>
                        <svg class="w-3.5 h-3.5 shrink-0 text-slate-400 transition-transform @(_dashboardPicker?.IsOpen == true ? "rotate-180" : "")"
                             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </ChildContent>
                <DropdownContent>
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                        @foreach (var d in Dashboards)
                        {
                            var dashboard = d;
                            <button class="w-full text-left px-4 py-2.5 hover:bg-slate-50 text-sm truncate @(dashboard.Id == ActiveDashboard?.Id ? "bg-blue-50 text-blue-700 font-semibold" : "text-slate-800")"
                                    @onclick="() => SelectDashboard(dashboard.Id)">
                                @dashboard.Name
                            </button>
                        }
                    </div>
                </DropdownContent>
            </FloatingDropdown>

            <FluentButton Appearance="Appearance.Neutral" OnClick="OnCreateDashboard" Title="@L["Dashboard_Create"]">
                <FluentIcon Value="@(new Icons.Regular.Size20.Add())" />
            </FluentButton>
            }
            else
            {
                <span class="text-sm font-medium text-indigo-700">Portfolio-Dashboard</span>
            }
        </div>

        <!-- Mitte: Editierbarer Dashboard-Titel -->
        <div class="flex justify-center min-w-0" @onclick:stopPropagation="true">
            @if (_editingName && ActiveDashboard is not null)
            {
                <input class="w-full max-w-sm text-center text-xl font-bold text-slate-800 bg-transparent border-b-2 border-blue-400 focus:outline-none px-1 py-0.5"
                       maxlength="160"
                       @ref="_nameInputRef"
                       value="@_editNameValue"
                       @oninput="e => _editNameValue = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleNameKeydown"
                       @onblur="CommitNameEdit" />
            }
            else
            {
                <button class="group inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 hover:bg-slate-100 transition-colors max-w-sm overflow-hidden disabled:cursor-default disabled:hover:bg-transparent"
                        @onclick="StartEditingName"
                        disabled="@(ActiveDashboard is null || IsFixedDashboard)"
                        title="@(ActiveDashboard is not null ? L["Dashboard_Rename"] : string.Empty)">
                    <span class="text-xl font-bold text-slate-800 truncate">
                        @(ActiveDashboard?.Name ?? L["Dashboard_NoneSelected"])
                    </span>
                    @if (ActiveDashboard is not null && !IsFixedDashboard)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())"
                                    Class="shrink-0 text-slate-400 opacity-0 group-hover:opacity-100 transition-opacity" />
                    }
                </button>
            }
        </div>

        <div class="flex items-center flex-wrap gap-2 shrink-0" @onclick:stopPropagation="true">

            @if (CanEdit && !string.IsNullOrWhiteSpace(SaveState))
            {
                <span class="text-xs text-slate-500" role="status">@SaveState</span>
            }

            @if (CanEdit)
            {
            <div class="relative">
                <button type="button"
                        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-100"
                        title="@L["Filter_Title"]"
                        @onclick="OnFilterClick">
                    @L["Filter_Title"]
                </button>
                @if (FilterDraft.IsActive())
                {
                    <span class="absolute -top-1 -right-1 text-[10px] px-1.5 py-0.5 rounded-full bg-green-100 border border-green-300 text-green-700">
                        @L["Dashboard_FilterActive"]
                    </span>
                }
            </div>

            <div class="relative">
                <button type="button"
                        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-100"
                        title="@L["Dashboard_Sort"]"
                        @onclick="OnSortToggle">
                    @L["Dashboard_Sort"]
                </button>
                @if (SortsOpen)
                {
                    <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-slate-200 bg-white shadow-lg z-50 overflow-hidden"
                         @onclick:stopPropagation="true">
                        <div class="px-3 py-2 text-xs uppercase tracking-wide text-slate-500 bg-slate-50 flex items-center justify-between gap-2">
                            <span>@L["Dashboard_SortBy"]</span>
                            <FluentButton Appearance="Appearance.Stealth" Title="@L["Dialog_Close"]"
                                          @onclick="() => OnSortToggle.InvokeAsync()">✕</FluentButton>
                        </div>
                        @foreach (var mode in Enum.GetValues<ListSortMode>())
                        {
                            var m = mode;
                            <button class="@SortItemCss(m)" @onclick="() => OnSortModeSelected.InvokeAsync(m)">
                                @SortLabel(m)
                            </button>
                        }
                    </div>
                }
            </div>

            <button type="button"
                    class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-50"
                    title="@L["Dashboard_Customize_Widgets"]"
                    disabled="@(ActiveDashboard is null)"
                    @onclick="OnWidgetCustomizeClick">
                @L["Dashboard_Customize_Widgets"]
            </button>
            }

            <FloatingDropdown AlignEnd="true">
                <ChildContent>
                    <button type="button"
                            class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-100">
                        @L["Dashboard_Export"]
                    </button>
                </ChildContent>
                <DropdownContent>
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                        <button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-50 focus:outline-none focus:bg-blue-50" @onclick:stopPropagation="true" @onclick="OnExportJson">JSON</button>
                        <button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-50 focus:outline-none focus:bg-blue-50" @onclick:stopPropagation="true" @onclick="OnExportCsv">CSV</button>
                        <button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-50 focus:outline-none focus:bg-blue-50" @onclick:stopPropagation="true" @onclick="OnExportPdf">PDF</button>
                    </div>
                </DropdownContent>
            </FloatingDropdown>

            @if (CanEdit)
            {
                <FluentButton Appearance="Appearance.Neutral" Title="@L["Dashboard_Settings"]"
                              OnClick="OnSettingsClick" Disabled="@(ActiveDashboard is null)">···</FluentButton>
            }
        </div>
    </div>
</div>

@code {
    private FloatingDropdown? _dashboardPicker;
    private bool _editingName;
    private string _editNameValue = string.Empty;
    private ElementReference _nameInputRef;

    [Parameter] public List<DashboardEntity> Dashboards { get; set; } = [];
    [Parameter] public DashboardEntity? ActiveDashboard { get; set; }
    [Parameter] public DashboardFilter FilterDraft { get; set; } = new();
    [Parameter] public bool SortsOpen { get; set; }
    [Parameter] public bool IsFixedDashboard { get; set; }
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public string SaveState { get; set; } = string.Empty;

    [Parameter] public EventCallback<Guid> OnDashboardChanged { get; set; }
    [Parameter] public EventCallback<string> OnDashboardRenamed { get; set; }
    [Parameter] public EventCallback OnCreateDashboard { get; set; }
    [Parameter] public EventCallback OnFilterClick { get; set; }
    [Parameter] public EventCallback OnSortToggle { get; set; }
    [Parameter] public EventCallback<ListSortMode> OnSortModeSelected { get; set; }
    [Parameter] public EventCallback OnWidgetCustomizeClick { get; set; }
    [Parameter] public EventCallback OnSettingsClick { get; set; }
    [Parameter] public EventCallback OnExportJson { get; set; }
    [Parameter] public EventCallback OnExportCsv { get; set; }
    [Parameter] public EventCallback OnExportPdf { get; set; }

    private async Task SelectDashboard(Guid id)
    {
        if (_dashboardPicker is not null)
            await _dashboardPicker.CloseAsync();
        await OnDashboardChanged.InvokeAsync(id);
    }

    private void StartEditingName()
    {
        if (ActiveDashboard is null || !CanEdit) return;
        _editNameValue = ActiveDashboard.Name;
        _editingName = true;
    }

    private async Task CommitNameEdit()
    {
        if (!_editingName) return;
        _editingName = false;
        var name = _editNameValue.Trim();
        if (!string.IsNullOrWhiteSpace(name) && name != ActiveDashboard?.Name)
            await OnDashboardRenamed.InvokeAsync(name);
    }

    private async Task HandleNameKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CommitNameEdit();
        else if (e.Key == "Escape")
            _editingName = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editingName)
        {
            try { await _nameInputRef.FocusAsync(); } catch { }
        }
    }

    private string SortItemCss(ListSortMode mode)
        => $"w-full text-left px-3 py-2 hover:bg-slate-50 {(ActiveDashboard?.SortMode == mode ? "bg-blue-50 text-blue-700" : "")}";

    private string SortLabel(ListSortMode mode) => mode switch
    {
        ListSortMode.Custom => L["Sort_Custom"],
        ListSortMode.Importance => L["Sort_Importance"],
        ListSortMode.DueDate => L["Sort_DueDate"],
        ListSortMode.Alphabetical => L["Sort_Alphabetical"],
        ListSortMode.CreatedAt => L["Sort_CreatedAt"],
        _ => mode.ToString()
    };
}
