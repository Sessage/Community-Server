                listId: List.Id,
                participantId: participantId
            );

            if (!success)
            {
                _error = message;
                return;
            }

            _info = message;

            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["Err_InviteWithdraw"].Value, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private Dictionary<Guid, bool> _expandedLinks = new();
    private string? GetQrDataUrlForLink(string? link)
        => _shareLinks.FirstOrDefault(x => string.Equals(x.Link, link, StringComparison.OrdinalIgnoreCase))?.QrCodeDataUrl;

    private void ExpandNewlyCreatedShareLink()
    {
        if (string.IsNullOrWhiteSpace(_shareLink))
            return;

        var created = _shareLinks.FirstOrDefault(x => string.Equals(x.Link, _shareLink, StringComparison.OrdinalIgnoreCase));
        if (created is not null)
            _expandedLinks[created.Id] = true;
    }

    private void ToggleExpanded(Guid id)
    {
        if (_expandedLinks.ContainsKey(id))
            _expandedLinks[id] = !_expandedLinks[id];
        else
            _expandedLinks[id] = true;
    }

}
